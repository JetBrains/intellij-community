load("@rules_java//java:defs.bzl", "java_test")
load("@rules_jvm//:jvm.bzl", "jvm_library")

# Starts a new JVM whose classpath is the runtime closure of the Java Standalone Analysis artifact modules and their libraries, and runs
# the smoke scenario as its main class. The process must exit with 0. The scenario resolves the JDK classes from the mock JDK of the
# platform tests, whose path comes in a system property.
java_test(
    name = "smoke_test",
    size = "medium",
    data = ["@community//java:mockJDK-1.8/jre/lib/rt.jar"],
    jvm_flags = ["-Dintellij.standalone.smoke.jdk=$(rootpath @community//java:mockJDK-1.8/jre/lib/rt.jar)"],
    main_class = "com.intellij.standaloneAnalysis.java.smoke.JavaStandaloneSmoke",
    tags = ["community-aggregator"],
    use_testrunner = False,
    runtime_deps = [":standaloneAnalysis-java-smoke"],
)

