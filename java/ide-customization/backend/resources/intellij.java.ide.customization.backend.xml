<idea-plugin>
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.ide"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.ide.nonModalWelcomeScreen"/>
    <module name="intellij.platform.ide.nonModalWelcomeScreen.backend"/>
    <module name="intellij.platform.project"/>
    <module name="intellij.platform.rpc.backend"/>
    <module name="intellij.platform.welcomeScreen"/>
  </dependencies>
  <!-- endregion -->

  <extensions defaultExtensionNs="com.intellij.platform.ide">
    <welcomeScreenFeatureBackend implementation="com.intellij.java.ide.customization.backend.welcomeScreen.IdeaTerminalFeatureBackend"/>
    <welcomeScreenFeatureBackend
      implementation="com.intellij.java.ide.customization.backend.welcomeScreen.IdeaAttachToProcessFeatureBackend"/>
    <welcomeScreenFeatureBackend implementation="com.intellij.java.ide.customization.backend.welcomeScreen.NewJavaFileFeatureBackend" />
    <welcomeScreenFeatureBackend implementation="com.intellij.java.ide.customization.backend.welcomeScreen.NewKotlinFileFeatureBackend" />

    <welcomeScreenFeatureBackend implementation="com.intellij.java.ide.customization.backend.welcomeScreen.IdeaPluginsWelcomeScreenFeature"/>
  </extensions>

  <extensions defaultExtensionNs="com.intellij">
    <welcomeScreenProjectProvider implementation="com.intellij.java.ide.customization.backend.welcomeScreen.IdeaWelcomeScreenProjectProvider" order="first"/>
  </extensions>
</idea-plugin>
