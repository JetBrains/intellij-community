<idea-plugin visibility="public">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.java.syntax"/>
    <module name="intellij.libraries.fastutil"/>
    <module name="intellij.libraries.kotlinx.collections.immutable"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.testIntegration"/>
  </dependencies>
  <!-- endregion -->
  <extensions defaultExtensionNs="com.intellij">
    <!--suppress PluginXmlReferencesModuleReachability (OpenAPI module must stay free of impl dependencies per ModuleDependenciesInIntellijProjectTest; intellij.platform.ide.core.impl is loaded in all products at runtime) -->
    <registryKey key="java.highest.language.level" defaultValue="27" description="Highest released language level" restartRequired="false"/>
    <!-- The default for a process without a Java backend, such as JetBrains Light. The Java plugin overrides it. -->
    <applicationService serviceImplementation="com.intellij.openapi.projectRoots.JavaVersionService" open="true"/>
  </extensions>
</idea-plugin>