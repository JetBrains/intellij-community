<idea-plugin>

  <extensions defaultExtensionNs="com.intellij">
    <registryKey key="editable.java.test.console" defaultValue="false"
                 description="Enables System.in in java test consoles (JUnit &amp; TestNG)"/>
    <registryKey defaultValue="true" description="Trigger autotest on delay instead of build events" key="trigger.autotest.on.delay"/>
    <registryKey key="ide.jvm.run.marker" defaultValue="false" description="Enable JVM-lang-based run line markers"/>
    <registryKey key="ide.jvm.command.line.clear.all.environments" defaultValue="true"
                 description="Clear all environments when running a JVM command line application"/>
    <registryKey key="ide.java.show.bundled.runtime" defaultValue="true"
                 description="Enables using bundled JetBrains Runtime for execution"/>
  </extensions>
</idea-plugin>
