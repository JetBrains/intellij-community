<idea-plugin visibility="internal">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.platform.backend"/>
    <module name="intellij.java.frontback.psi"/>
    <module name="intellij.java.psi"/>
    <module name="intellij.java.psi.impl"/>
    <module name="intellij.java.syntax"/>
    <module name="intellij.libraries.fastutil"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
  </dependencies>
  <!-- endregion -->

  <!--This module is used outside (kotlin).-->
  <extensions defaultExtensionNs="com.intellij">
    <superMethodsSearch implementation="com.intellij.psi.impl.search.MethodSuperSearcher"/>

    <!--suppress PluginXmlReferencesModuleReachability (JDK 1.8 module must not depend on intellij.platform.indexing per JavaVersionInIntelliJModulesTest; it is loaded in all products at runtime) -->
    <stubElementRegistryExtension implementation="com.intellij.psi.impl.java.stubs.JavaStubRegistryExtension"/>
  </extensions>
</idea-plugin>
