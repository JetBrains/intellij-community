# The IDE plugin layout copies this checkout directory into a distribution verbatim (`withResourceArchive`).
# It is resolved against the module content root, so a dev assembly that materializes its own project tree
# has to declare it. Consumed through `ULTIMATE_EXTRA_PROJECT_FILES` and through `//java:mockJDK` for tests.
filegroup(
    name = "dev_dist_resources",
    srcs = glob(["resources/**"]),
    visibility = ["//visibility:public"],
)

