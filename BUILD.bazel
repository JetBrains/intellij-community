load("@buildifier_prebuilt//:rules.bzl", "buildifier")
load("@community//build:bazel_targets_json.bzl", "current_bazel_targets_json")
load("@community//build:tests-options.bzl", "jps_test")
load("@rules_jvm//:jvm.bzl", "jvm_library", "kt_javac_options")
load("//build:compiler-options.bzl", "create_kotlinc_options")

BAZEL_TARGETS_JSON = current_bazel_targets_json()

buildifier(
    name = "format",
    exclude_patterns = [
        "*/.git",
        "*/node_modules",
        "./out",
        "./.bazelbsp",
        "./**/~BUILD.bazel",
    ],
    mode = "fix",
    visibility = ["//visibility:public"],
)

buildifier(
    name = "format.check",
    exclude_patterns = [
        "*/.git",
        "*/node_modules",
        "./out",
        "./.bazelbsp",
        "./**/~BUILD.bazel",
    ],
    mode = "check",
    visibility = ["//visibility:public"],
)

exports_files(
    glob(["**/*.iml"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "jps_to_bazel_community_model_root_files",
    srcs = [
        ".idea/kotlinc.xml",
        ".idea/misc.xml",
        ".idea/modules.xml",
    ] + glob([".idea/libraries/*.xml"]),
    visibility = ["//visibility:public"],
)

kt_javac_options(
    name = "default-javac-opts",
    no_proc = True,
)

create_kotlinc_options(
    name = "k8",
    jvm_target = "8",
)

create_kotlinc_options(
    name = "k11",
    jvm_target = "11",
)

create_kotlinc_options(
    name = "k17",
    jvm_target = "17",
)

create_kotlinc_options(
    name = "k21",
    jvm_target = "21",
)

create_kotlinc_options(
    name = "k25",
    jvm_target = "25",
    warn = "report",
)

## used to determine community root path in the test
## see community/build/tests-options.bzl
exports_files(["intellij.idea.community.main.iml"])

exports_files(
    glob(["build.txt"]),
    visibility = ["//visibility:public"],
)

jps_test(
    name = "main-tests_test",
    timeout = "moderate",
    data = [BAZEL_TARGETS_JSON],
    jvm_flags = [
        "-Dintellij.build.bazel.targets.json.file=$(rlocationpath %s)" % BAZEL_TARGETS_JSON,
    ],
    tags = ["community-aggregator"],
    runtime_deps = [":main-tests_test_lib"],
)
