# sandboxed or read-only-checkout run never downloads. The extension of each owner derives the URLs from the versions
# the checkout pins, with one repository per version key, and per platform only where the artifact is. The ultimate
# `private.MODULE.bazel` includes the same segments.
include("//build:platform_downloads.MODULE.bazel")
include("//plugins/jcef/plugin:downloads.MODULE.bazel")
include("//plugins/maven:downloads.MODULE.bazel")
include("//plugins/terminal:downloads.MODULE.bazel")
