    module_name = "bazel_worker_java",
    patches = [
        "//:build/jvm-rules/worker-java-0.0.9-pin-bazel-worker-maven.patch",
    ],
    version = "0.0.10",
)

bazel_dep(name = "xml.bzl", version = "0.2.3")
bazel_dep(name = "lib")
local_path_override(
    module_name = "lib",
    path = "lib",
)

bazel_dep(name = "jps_to_bazel")
local_path_override(
    module_name = "jps_to_bazel",
    path = "platform/build-scripts/bazel",
)

local_path_override(
    module_name = "rules_jvm",
    path = "build/jvm-rules",
)

bazel_dep(name = "windows_support", version = "0.2.1")
bazel_dep(name = "llvm", version = "0.8.9")
single_version_override(
    module_name = "llvm",
    patch_strip = 1,
    patches = [
        "//:build/llvm_msvc.patch",  # TODO: remove that once merged to upstream
    ],
    # Kept in sync with the `ultimate` root, which has to hold `llvm` at 0.8.9 because `llvm_msvc.patch` does not
    # apply to the 0.8.18 that `rules_rs` asks for. `BazelProjectStructureTest` requires identical overrides.
    version = "0.8.9",
)

register_toolchains(
    "@llvm//toolchain:all",
    dev_dependency = True,
)  # `dev_dependency = True` to avoid registering toolchains in modules using that module, see https://github.com/bazel-contrib/toolchains_llvm/issues/569

bazel_dep(name = "rules_python", version = "1.7.0")

kotlin_test_deps = use_repo_rule("//plugins/kotlin:kotlin_test_dependencies.bzl", "kotlin_test_deps")

kotlin_test_deps(name = "kotlin_test_deps")

include("//platform/jewel:jewel_deps.MODULE.bazel")

jbr_toolchains = use_extension("@community//build:jbr-toolchains.bzl", "jbr_toolchains")

REMOTE_JBR25_REPOS = ["remotejbr25_" + platform for platform in [
    "linux",
    "linux_aarch64",
    "macos",
    "macos_aarch64",
    "win",
    "win_arm64",
]]

[use_repo(
    jbr_toolchains,
    repo + "_toolchain_config_repo",
) for repo in REMOTE_JBR25_REPOS]

[register_toolchains("@" + repo + "_toolchain_config_repo//:all") for repo in REMOTE_JBR25_REPOS]

# The build dependencies a dev-mode assembly - and IDE Starter - downloads at launch time are Bazel
# inputs, so a sandboxed or read-only-checkout run never downloads. The extension derives their URLs
# from the pinned versions the checkout already owns; one repository per version key, and per platform
# only where the artifact is, so a bump refetches only what it changed. MODULE files cannot load(), so
# the platform list is repeated here - Bazel reports any drift from HOST_PLATFORMS.
DEV_LAUNCH_HOST_PLATFORMS = [
    "darwin_aarch64",
    "darwin_x64",
    "linux_aarch64",
    "linux_x64",
    "windows_aarch64",
    "windows_x64",
]

dev_launch_deps_community = use_extension("@community//build:dev_launch_dependencies.bzl", "dev_launch_deps_community")
use_repo(
    dev_launch_deps_community,
    "dev_launch_jserialcomm",
    "dev_launch_libghostty",
    "dev_launch_libwebp",
    "dev_launch_maven",
    "dev_launch_maven3_libraries",
    "dev_launch_maven_telemetry_libraries",
    "dev_launch_restarter",
    "dev_launch_restarter_extracted",
)

[use_repo(
    dev_launch_deps_community,
    "dev_launch_%s_%s" % (platform, group),
) for platform in DEV_LAUNCH_HOST_PLATFORMS for group in [
    "jbr",
    "jcef",
]]

# Use custom remote_java_tools_windows with vc_redist .dll files due to https://github.com/bazelbuild/rules_java/issues/316
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "remote_java_tools_windows_with_vc_redist",
    sha256 = "a9df22ddf20fcd0407ae0782845b58787e4a126eb81aa8d16dfa5be542c443d0",
    url = "https://packages.jetbrains.team/files/p/ij/intellij-build-dependencies/rules-java/java_tools_windows-v19.0-with-vc_redist-v2.zip",
)

override_repo(
    use_extension("@rules_java//java:extensions.bzl", "toolchains"),
    remote_java_tools_windows = "remote_java_tools_windows_with_vc_redist",
)

# Register the extension that runs jps-to-bazel converter and provides target lists for dev-build.
# This creates the @jps_dynamic_deps_community repository.
use_repo(
    use_extension("//build:jps_dynamic_deps_community.bzl", "jps_dynamic_deps_community_extension"),
    "jps_dynamic_deps_community",
)

# OpenedPackages.txt as Starlark. This creates the @intellij_add_opens repository.
use_repo(
    use_extension("//build:intellij_add_opens.bzl", "intellij_add_opens_extension"),
    "intellij_add_opens",
)

# Hermetic node/npm used by the KMP resolver (//fleet/build/rules:kmp.bzl) to resolve
# the NPM dependencies declared by the `package.json` embedded in KMP klibs.
bazel_dep(name = "rules_nodejs", version = "6.7.4")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
use_repo(
    node,
    "nodejs_darwin_amd64",
    "nodejs_darwin_arm64",
    "nodejs_linux_amd64",
    "nodejs_linux_arm64",
    "nodejs_windows_amd64",
    "nodejs_windows_arm64",
)

# Go, for //build/treehouse - the treehouse wrapper. The SDK version tracks the `go` directive of its `go.mod`.
bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "gazelle", version = "0.53.0")

# No `name` on the download: `rules_go` rejects one from a non-root module, and this module is not the root when the
# ultimate repository builds it. Nothing here names the SDK repo, so it does not need one.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.27.0")

# Every version comes from the treehouse `go.mod`, which is also what the IDE and a plain `go build` read.
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//build/treehouse:go.mod")
use_repo(go_deps, "com_github_kunchenguid_treehouse")

# Rust, for the dev-distribution tools in //build/dev-dist-tools. rules_rs supplies the Rust toolchains and the
# `@rules_rust` facade. The ultimate root declares the same `bazel_dep`, override and toolchain tag.
# `BazelProjectStructureTest` requires identical dependencies, overrides and patch files in both roots.
bazel_dep(name = "rules_rs", version = "0.0.108")
single_version_override(
    module_name = "rules_rs",
    patch_strip = 1,
    patches = [
        "//:build/rules_rs-0.0.108-github-crate-tarball.patch",  # TODO: remove that once merged to upstream
        # A Unix-only crate cross-built from a Windows host needs its build dependencies there. TODO: upstream.
        "//:build/rules_rs-0.0.108-exec-build-deps.patch",
    ],
)

rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, "rules_rust")

# Keep this tag equal to the tag of the ultimate root. The extension merges equal tags of the same repository name, and
# it fails when the tags differ. Each crate of this module sets its own edition.
rust_toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
rust_toolchains.toolchain(
    edition = "2021",
    version = "1.93.1",
)
use_repo(rust_toolchains, "default_rust_toolchains")

# `dev_dependency = True`: register the toolchains only when this module is the root. The ultimate root registers the
# same toolchains itself.
register_toolchains(
    "@default_rust_toolchains//...",
    dev_dependency = True,
)

# The crates of //build/dev-dist-tools, resolved from its `Cargo.lock`. The name is short on purpose. It becomes part
# of every dependency path, and a long name breaks the build on Windows. The tools run only on the host, so the
# triples are the hosts that run Bazel here, plus the one triple below that a closure check needs. A host without a
# triple fails to resolve the crates.
crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "ddt",
    cargo_config = "//build/dev-dist-tools:.cargo/config.toml",
    cargo_lock = "//build/dev-dist-tools:Cargo.lock",
    cargo_toml = "//build/dev-dist-tools:Cargo.toml",
    # Renders `[workspace.lints]` as `@ddt//:workspace_cargo_lints`, the lint policy of every crate.
    generate_lint_config = True,
    platform_triples = [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "aarch64-pc-windows-msvc",
        "x86_64-pc-windows-msvc",
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
        # No dev-dist tool runs here. The closure checks of `vm` and `air-trace` analyze bt-core for x86_64 Linux musl,
        # and through bt-core `distpath` and its `anyhow`.
        "x86_64-unknown-linux-musl",
    ],
)
use_repo(crate, "ddt")

# The crates of //tools/bt, resolved from its `Cargo.lock`. The name is short for the same reason. BT runs on every
# host. The Air UI-lane workspace links BT's crates into `vm` and `air-trace`, and their closure checks configure the
# crates for x86_64 Linux musl.
crate.from_cargo(
    name = "bt",
    cargo_config = "//tools/bt:.cargo/config.toml",
    cargo_lock = "//tools/bt:Cargo.lock",
    cargo_toml = "//tools/bt:Cargo.toml",
    # Renders `[workspace.lints]` as `@bt//:workspace_cargo_lints`, the lint policy of every crate.
    generate_lint_config = True,
    platform_triples = [
        # A macOS host, and the macOS guest agent.
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        # A Windows host, and the Windows compile and clippy checks of `bt`.
        "aarch64-pc-windows-msvc",
        "x86_64-pc-windows-msvc",
        # A Linux host.
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
        # x86_64: the closure checks of `vm` and `air-trace`. No target uses the aarch64 triple today.
        "aarch64-unknown-linux-musl",
        "x86_64-unknown-linux-musl",
    ],
)
use_repo(crate, "bt")

include("//:fleet/kmp.MODULE.bazel")
