    strip_prefix = "Payload/Library/Developer/CommandLineTools/SDKs/MacOSX26.5.sdk",
    type = "pkg",
    urls = [
        # /!\ DO NOT TWEAK that list of URLs before having checked the original requirements in MRI-5579
        "https://cache-redirector.jetbrains.com/swcdn.apple.com/content/downloads/33/19/140-17812-A_21ZLMMLY4E/zu3xwktttpoe71qiawhzgzvqss6rovawsa/CLTools_macOSNMOS_SDK.pkg",
        # Copies the `llvm` upstream logic, but with a cache redirection to avoid abuse of web.archive.org
        "https://cache-redirector.jetbrains.com/web.archive.org/web/20260902184416id_/https:%2F%2Fswcdn.apple.com/content/downloads/33/19/140-17812-A_21ZLMMLY4E/zu3xwktttpoe71qiawhzgzvqss6rovawsa/CLTools_macOSNMOS_SDK.pkg",
