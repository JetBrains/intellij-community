bazel_dep(name = "rules_java", version = "9.6.1")
bazel_dep(name = "rules_jvm", version = "0.0.1")
bazel_dep(name = "rules_pkg", version = "1.2.0")
bazel_dep(name = "protobuf", version = "33.4")
single_version_override(
    module_name = "protobuf",
    patch_strip = 1,
    patches = [
        "//:build/jvm-rules/protobuf-33.4-reuse-win64-for-arm.patch",
        "//:build/jvm-rules/protobuf-33.4-fail-on-java-core-source-build.patch",
    ],
    version = "33.4",
)

# Root registration outranks the dependency order, so the prebuilt protobuf-java
# toolchain always wins over the source toolchain of @protobuf.
# Do not remove: without it @protobuf//java/core compiles from source.
register_toolchains("@rules_jvm//:protoc_java_toolchain_toolchain")

register_toolchains("@rules_jvm//:kotlin_multiplex_toolchain")

