# Go, for //build/content-module-packer - the tool behind `content_module_jar`, one static binary that Bazel runs as a
# multiplex worker. It is the only Go in this module, and the SDK version tracks the `go` directive of its `go.mod`.
bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "gazelle", version = "0.53.0")

# No `name` on the download: `rules_go` rejects one from a non-root module, and this module is not the root when the
# ultimate repository builds it. Nothing here names the SDK repo, so it does not need one.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.27.0")

# XXH3-64 keys the `__index__` of every jar the packer writes, and it has to be the reference algorithm bit for bit or
# those jars differ from the ones `JarPackager` produces - which is what the 2 050 reference vectors in
# //build/content-module-packer/internal/xxh3 hold it to. cpuid is its only dependency, for runtime CPU dispatch, and
# both versions come from the packer's `go.mod`, which is also what the IDE and a plain `go build` read.
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//build/content-module-packer:go.mod")

# The pins below mirror //build/treehouse:go.mod, the Go module of the treehouse wrapper. They are explicit because
# gazelle accepts one `go_deps.from_file` tag per Bazel module, and content-module-packer above already holds it.
# Keep this list in step with //build/treehouse:go.mod, which is what the IDE and a plain `go build` read.
# If the list becomes a burden, add a `go.work` file and change to `from_file(go_work = ...)`. We do not do that now,
# because it would rewrite the working dependency wiring of content-module-packer, and the packer is a Bazel worker on
# the critical path of every `content_module_jar`.
# `golang.org/x/sys` is in both modules, and gazelle resolves it to the higher version.
# The pin below and the `golang.org/x/sys` line in //build/treehouse:go.mod must always move together.
# If they differ, Bazel and a plain `go build` compile treehouse against different sources.
# v0.46.0 is also the version that `intellix/go.mod` asks for. So a community-only checkout and the ultimate checkout
# resolve the same version. The packer compiles against v0.46.0 too.
# The version of `github.com/kunchenguid/treehouse` is a pseudo-version, because the upstream module path has no /v2
# suffix. It points to the exact commit of the v2.3.0 tag.
# A tag carries `indirect = True` when //build/treehouse:go.mod marks that line `// indirect`. Gazelle counts every
# other `go_deps.module` tag of the root module as a direct dependency, so without the mark `bazel mod tidy` demands
# all 17 names in the `use_repo` call below. `github.com/kunchenguid/treehouse` is the one direct requirement, and
# //build/treehouse/cli names it in `deps`.
go_deps.module(
    indirect = True,
    path = "github.com/BurntSushi/toml",
    sum = "h1:dRaEfpa2VI55EwlIW72hMRHdWouJeRF7TPYhI+AUQjk=",
    version = "v1.6.0",
)
