# Go, for //build/treehouse - the treehouse wrapper. The SDK version tracks the `go` directive of its `go.mod`.
bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "gazelle", version = "0.53.0")

# No `name` on the download: `rules_go` rejects one from a non-root module, and this module is not the root when the
# ultimate repository builds it. Nothing here names the SDK repo, so it does not need one.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.27.0")

# Every version comes from the treehouse `go.mod`, which is also what the IDE and a plain `go build` read.
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//build/treehouse:go.mod")
use_repo(go_deps, "com_github_kunchenguid_treehouse")

# Rust, for the dev-distribution tools in //build/dev-dist-tools. rules_rs supplies the Rust toolchains and the
# `@rules_rust` facade. The ultimate root declares the same `bazel_dep`, override and toolchain tag.
# `BazelProjectStructureTest` requires identical dependencies, overrides and patch files in both roots.
bazel_dep(name = "rules_rs", version = "0.0.112")
single_version_override(
    module_name = "rules_rs",
    patch_strip = 1,
    patches = [
        "//:build/rules_rs-0.0.112-github-crate-tarball.patch",  # TODO: remove that once merged to upstream
    ],
)

rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")

# The extension collects this tag from every module, so it also reaches the ultimate root. Do not repeat it there, or
# the patch applies twice.
rules_rust.patch(
    patches = [
        "//:build/rules_rust-cdylib-implib.patch",  # TODO: remove that once merged to upstream
        "//:build/rules_rust-msvc-rustc-link-through-lld-link.patch",  # TODO: remove that once merged to upstream
        "//:build/rules_rust-process-wrapper-skip-static-lib-symlinks.patch",  # TODO: remove that once merged to upstream
        "//:build/rules_rust-cdylib-def-file.patch",  # TODO: remove that once merged to upstream
        "//:build/rules_rust-cc-common-link-native-libs.patch",  # TODO: remove that once merged to upstream
    ],
    strip = 1,
)
use_repo(rules_rust, "rules_rust")

# Keep this tag equal to the tag of the ultimate root. The extension merges equal tags of the same repository name, and
# it fails when the tags differ. Each crate of this module sets its own edition.
rust_toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
rust_toolchains.toolchain(
    edition = "2021",
    version = "1.93.1",
)
use_repo(rust_toolchains, "default_rust_toolchains")

# `dev_dependency = True`: register the toolchains only when this module is the root. The ultimate root registers the
# same toolchains itself.
register_toolchains(
    "@default_rust_toolchains//...",
    dev_dependency = True,
)

# The crates of //build/dev-dist-tools, resolved from its `Cargo.lock`. The name is short on purpose. It becomes part
# of every dependency path, and a long name breaks the build on Windows. The tools run only on the host, so the
# triples are the hosts that run Bazel here, plus the two Linux musl triples of the guest agent. A host without a
# triple fails to resolve the crates.
crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "ddt",
    cargo_config = "//build/dev-dist-tools:.cargo/config.toml",
    cargo_lock = "//build/dev-dist-tools:Cargo.lock",
    cargo_toml = "//build/dev-dist-tools:Cargo.toml",
    # Renders `[workspace.lints]` as `@ddt//:workspace_cargo_lints`, the lint policy of every crate.
    generate_lint_config = True,
    platform_triples = [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "aarch64-pc-windows-msvc",
        "x86_64-pc-windows-msvc",
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
        # No dev-dist tool runs on the two Linux musl triples. The guest agent links `dev-launch` and its crates, and
        # `:vm-guest-agent-linux-*` builds them for both. The closure checks of `vm` and `air-trace` analyze bt-core for
        # x86_64 Linux musl, and through bt-core `distpath` and its `anyhow`.
        "aarch64-unknown-linux-musl",
        "x86_64-unknown-linux-musl",
    ],
)
use_repo(crate, "ddt")

# The crates of //tools/bt, resolved from its `Cargo.lock`. The name is short for the same reason. BT runs on every
# host. The Air UI-lane workspace links BT's crates into `vm` and `air-trace`, and their closure checks configure the
# crates for x86_64 Linux musl.
crate.from_cargo(
    name = "bt",
    cargo_config = "//tools/bt:.cargo/config.toml",
    cargo_lock = "//tools/bt:Cargo.lock",
    cargo_toml = "//tools/bt:Cargo.toml",
    # Renders `[workspace.lints]` as `@bt//:workspace_cargo_lints`, the lint policy of every crate.
    generate_lint_config = True,
    platform_triples = [
        # A macOS host, and the macOS guest agent.
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        # A Windows host, and the Windows compile and clippy checks of `bt`.
        "aarch64-pc-windows-msvc",
        "x86_64-pc-windows-msvc",
        # A Linux host.
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
        # x86_64: the closure checks of `vm` and `air-trace`. No target uses the aarch64 triple today.
        "aarch64-unknown-linux-musl",
        "x86_64-unknown-linux-musl",
    ],
)
use_repo(crate, "bt")

# The crates of //tools/yonder, resolved from its `Cargo.lock`. The client runs on every host that runs BT, because
# `bt --host` links it. The agent runs on macOS and Linux.
crate.from_cargo(
    name = "yonder",
    cargo_config = "//tools/yonder:.cargo/config.toml",
    cargo_lock = "//tools/yonder:Cargo.lock",
    cargo_toml = "//tools/yonder:Cargo.toml",
    # Renders `[workspace.lints]` as `@yonder//:workspace_cargo_lints`, the lint policy of every crate.
    generate_lint_config = True,
    platform_triples = [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "aarch64-pc-windows-msvc",
        "x86_64-pc-windows-msvc",
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(crate, "yonder")

# ring on the Windows triples, where the C toolchain is clang-cl with -Werror. ring adds /Wall, and its own C does not
# pass -Werror there, so the build script of ring gets -Wno-error for these two triples only.
crate.annotation_select(
    build_script_env = {
        "CFLAGS_aarch64_pc_windows_msvc": "-Wno-error",
        "CFLAGS_x86_64_pc_windows_msvc": "-Wno-error",
    },
    crate = "ring",
    repositories = ["yonder"],
    triples = [
        "aarch64-pc-windows-msvc",
        "x86_64-pc-windows-msvc",
    ],
    version = "0.17.14",
)

# On Windows AArch64, ring calls `clang` in place of every compiler that is not clang, and clang-cl is not "clang" for
# cc-rs. clang then gets the clang-cl flags of the toolchain. The patch keeps clang-cl.
crate.annotation(
    crate = "ring",
    patch_args = ["-p1"],
    patches = ["//tools/yonder:ring-windows-clang-cl.patch"],
    repositories = ["yonder"],
    # The patch is for this version only: a new ring needs a new look at its build script.
    version = "0.17.14",
)

# The Air UI-lane controller, `tools/vm`: the pinned Apple container, Docker CLI and Tart, and the crate hub `@avl`.
include("//tools/vm:container.MODULE.bazel")
include("//tools/vm:docker.MODULE.bazel")
include("//tools/vm:tart.MODULE.bazel")
include("//tools/vm:avl.MODULE.bazel")
