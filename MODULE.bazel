# The build dependencies a dev-mode assembly - and IDE Starter - downloads at launch time are Bazel
# inputs, so a sandboxed or read-only-checkout run never downloads. The extension derives their URLs
# from the pinned versions the checkout already owns; one repository per version key, and per platform
# only where the artifact is, so a bump refetches only what it changed. MODULE files cannot load(), so
# the platform list is repeated here - Bazel reports any drift from HOST_PLATFORMS.
DEV_LAUNCH_HOST_PLATFORMS = [
    "darwin_aarch64",
    "darwin_x64",
    "linux_aarch64",
    "linux_x64",
    "windows_aarch64",
    "windows_x64",
]

dev_launch_deps_community = use_extension("@community//build:dev_launch_dependencies.bzl", "dev_launch_deps_community")
use_repo(
    dev_launch_deps_community,
    "dev_launch_jserialcomm",
    "dev_launch_libghostty",
    "dev_launch_libwebp",
    "dev_launch_maven",
    "dev_launch_maven3_libraries",
    "dev_launch_maven_telemetry_libraries",
    "dev_launch_pyrefly_license",
    "dev_launch_pyrefly_license_extracted",
    "dev_launch_restarter",
    "dev_launch_restarter_extracted",
)

[use_repo(
    dev_launch_deps_community,
    "dev_launch_%s_%s" % (platform, group),
) for platform in DEV_LAUNCH_HOST_PLATFORMS for group in [
    "jbr",
    "jbr_runtime_extracted",
    "jcef",
    "pyrefly",
    "pyrefly_extracted",
]]

