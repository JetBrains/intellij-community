<idea-plugin>
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.platform.buildScripts.downloader"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
    <module name="intellij.platform.ide.impl"/>
  </dependencies>
  <!-- endregion -->
  <extensions defaultExtensionNs="com.intellij">
    <registryKey key="terminal.ghostty.native.logging" defaultValue="true"
                 description="Redirect native logging by libghostty-vt to idea.log."
                 restartRequired="true"/>
  </extensions>
</idea-plugin>
