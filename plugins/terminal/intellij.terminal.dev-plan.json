{
    "version": 2,
    "plugin": "intellij.terminal",
    "variant": "{platform}",
    "layoutSignature": "{platform:layoutSignature}",
    "assets": [
        {
            "module": "intellij.terminal.backend.split"
        },
        {
            "module": "intellij.terminal.backend"
        },
        {
            "module": "intellij.terminal.emulator"
        },
        {
            "module": "intellij.terminal.frontend"
        },
        {
            "module": "intellij.terminal.frontend.split"
        },
        {
            "module": "intellij.terminal.cloud"
        },
        {
            "module": "intellij.terminal.sh"
        },
        {
            "module": "intellij.terminal.agentsProvider"
        },
        {
            "destination": "lib/intellij.libraries.completion.ranking.sh.jar",
            "recipe": {
                "sources": [
                    {
                        "input": "intellij.libraries.completion.ranking.sh",
                        "kind": "module",
                        "filter": "module-v1"
                    },
                    {
                        "input": "@lib//:libraries-completion-ranking-sh-completion-ranking-sh",
                        "kind": "library",
                        "filter": "library-v1"
                    }
                ],
                "writer": {
                    "mergeEntities": true
                }
            }
        },
        {
            "destination": "lib/intellij.terminal.libraries.completionDbWithExtensions.jar",
            "recipe": {
                "sources": [
                    {
                        "input": "intellij.terminal.libraries.completionDbWithExtensions",
                        "kind": "module",
                        "filter": "module-v1"
                    },
                    {
                        "input": "@lib//:terminal-libraries-completion_db_with_extensions-terminal-completion-db-with-extensions",
                        "kind": "library",
                        "filter": "library-v1"
                    }
                ],
                "writer": {
                    "mergeEntities": true
                }
            }
        },
        {
            "destination": "lib/terminal.jar",
            "recipe": {
                "sources": [
                    {
                        "input": "descriptor:intellij.terminal",
                        "kind": "file",
                        "filter": "none",
                        "entry": "META-INF/plugin.xml",
                        "options": [
                            "patch"
                        ]
                    },
                    {
                        "input": "intellij.terminal",
                        "kind": "module",
                        "filter": "module-v1"
                    },
                    {
                        "input": "intellij.terminal.completion",
                        "kind": "module",
                        "filter": "module-v1"
                    }
                ],
                "writer": {
                    "mergeEntities": true
                }
            }
        },
        {
            "destination": "lib/terminal-completion-spec.jar",
            "recipe": {
                "sources": [
                    {
                        "input": "@lib//:terminal-completion-terminal-completion-spec",
                        "kind": "library",
                        "filter": "library-v1"
                    }
                ],
                "writer": {
                    "mergeEntities": true
                }
            }
        },
        {
            "destination": "{platform:destination}",
            "inputs": [
                "layout-assets:platform-resource-generator:0:output"
            ],
            "kind": "tree",
            "classPath": false
        },
        {
            "destination": "shell-integrations",
            "inputs": [
                "module-resource:0:source"
            ],
            "kind": "tree",
            "classPath": false
        }
    ],
    "preparations": [
        {
            "id": "layout-assets:platform-resource-generator:0",
            "inputs": [
                "layout-source:platform-resource-generator:0:0"
            ],
            "outputs": [
                "layout-assets:platform-resource-generator:0:output"
            ],
            "modelSignature": "{platform:modelSignature}"
        }
    ],
    "operations": [
        {
            "id": "layout-assets:platform-resource-generator:0",
            "kind": "layout-assets",
            "inputs": [
                {
                    "artifact": "layout-source:platform-resource-generator:0:0"
                }
            ],
            "output": "layout-assets:platform-resource-generator:0:output",
            "manifest": "keep",
            "layoutAssets": {
                "format": "tree",
                "root": "{platform:destination}",
                "assets": [
                    {
                        "destination": "",
                        "sources": [
                            0
                        ],
                        "transform": {
                            "kind": "archive-tree",
                            "mappings": [
                                {
                                    "pattern": "{platform:pattern}",
                                    "stripComponents": 1
                                }
                            ]
                        }
                    }
                ]
            }
        }
    ]
}
