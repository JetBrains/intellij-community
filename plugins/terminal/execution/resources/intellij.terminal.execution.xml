<idea-plugin visibility="public">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <plugin id="org.jetbrains.plugins.terminal"/>
    <module name="intellij.libraries.guava"/>
    <module name="intellij.libraries.jediterm.core"/>
    <module name="intellij.libraries.jediterm.ui"/>
    <module name="intellij.libraries.jetbrains.annotations"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.execution"/>
    <module name="intellij.platform.execution.impl"/>
    <module name="intellij.platform.ide"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.core.impl"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.statistics"/>
    <module name="intellij.platform.terminal"/>
    <module name="intellij.platform.util.ui"/>
  </dependencies>
  <!-- endregion -->
  <extensionPoints>
    <extensionPoint qualifiedName="com.intellij.terminal.shellCommandHandler"
                    interface="com.intellij.terminal.TerminalShellCommandHandler" dynamic="true"/>
  </extensionPoints>
  <extensions defaultExtensionNs="com.intellij">
    <applicationService serviceInterface="org.jetbrains.plugins.terminal.TerminalShellCommandHandlerHelper$Factory"
                        serviceImplementation="com.intellij.terminal.execution.TerminalShellCommandHandlerHelperFactoryImpl"/>
    <terminal.shellCommandHandler implementation="org.jetbrains.plugins.terminal.RunAnythingTerminalBridge"/>
    <terminal.shellCommandHandler implementation="org.jetbrains.plugins.terminal.OpenFileShellCommandHandler"/>
  </extensions>
</idea-plugin>
