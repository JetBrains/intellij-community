<idea-plugin>
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.grazie.core"/>
    <module name="intellij.libraries.jetbrains.annotations"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.vcs"/>
    <module name="intellij.platform.vcs.impl"/>
    <module name="intellij.spellchecker"/>
  </dependencies>
  <!-- endregion -->

  <extensions defaultExtensionNs="com.intellij">
    <spellchecker.support language="IgnoreLang" implementationClass="com.intellij.grazie.vcs.IgnoreSpellcheckingStrategy"/>
  </extensions>

  <extensions defaultExtensionNs="com.intellij.grazie">
    <commitMessageDetector implementation="com.intellij.grazie.vcs.VcsCommitMessageDetector"/>
    <textExtractor language="IgnoreLang" implementationClass="com.intellij.grazie.vcs.IgnoreTextExtractor"/>
  </extensions>
</idea-plugin>
