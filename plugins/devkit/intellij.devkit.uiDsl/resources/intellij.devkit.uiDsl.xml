<idea-plugin>
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <plugin id="org.jetbrains.kotlin"/>
    <module name="intellij.devkit.core"/>
    <module name="intellij.java.psi"/>
    <module name="intellij.platform.ide.internal"/>
  </dependencies>
  <!-- endregion -->

  <resource-bundle>messages.DevkitUiDslBundle</resource-bundle>

  <actions>
    <action id="UiDslShowcaseAction" class="com.intellij.devkit.uiDsl.showcase.UiDslShowcaseAction"/>
    <group id="UiDslShowcaseInternalGroup" internal="true">
      <reference ref="UiDslShowcaseAction"/>
      <add-to-group group-id="Internal.UI.KotlinUiDsl"/>
    </group>
    <action id="UISandboxAction" internal="true" class="com.intellij.devkit.uiDsl.sandbox.UISandboxAction">
      <add-to-group group-id="Internal.UI"/>
    </action>
  </actions>

  <extensions defaultExtensionNs="com.intellij">
    <editorNotificationProvider implementation="com.intellij.devkit.uiDsl.usageNotification.KotlinUiDslUsageNotificationProvider"/>
  </extensions>

</idea-plugin>
