<idea-plugin>
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.java.backend"/>
    <module name="intellij.devkit.core"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.ide"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.ide.progress"/>
    <module name="intellij.platform.lang"/>
    <module name="intellij.platform.lang.core"/>
    <module name="intellij.platform.lang.impl"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.serviceContainer"/>
    <module name="intellij.platform.util.ui"/>
    <module name="intellij.platform.workspace.jps"/>
    <module name="intellij.xml.dom"/>
    <module name="intellij.xml.psi"/>
  </dependencies>
  <!-- endregion -->
  <actions resource-bundle="messages.DevkitScaffoldingBundle">
    <action id="newIjModule" icon="AllIcons.Nodes.Module"
            class="com.intellij.devkit.scaffolding.NewIjModuleAction">
      <add-to-group group-id="NewGroup1" anchor="after" relative-to-action="NewModuleInGroup"/>
      <add-to-group group-id="NewProjectOrModuleGroup"/>
    </action>
  </actions>
  <extensions defaultExtensionNs="com.intellij">
    <registryKey key="devkit.plugin.directory.icons" defaultValue="true"
                 description="Enables icons for well-formed plugin directories, for instance, in Project View"/>
    <iconProvider implementation="com.intellij.devkit.scaffolding.ScaffoldingDirectoryIconProvider" order="before javaDirectory"/>
  </extensions>
</idea-plugin>
