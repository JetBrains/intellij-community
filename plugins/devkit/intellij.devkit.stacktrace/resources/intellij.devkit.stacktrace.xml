<idea-plugin>
  <dependencies>
    <module name="intellij.java.backend"/>
    <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
    <module name="intellij.devkit.core"/>
    <module name="intellij.java.unscramble"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.diagnostic.freezeAnalyzer"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.execution"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.threadDumpParser"/>
    <module name="intellij.platform.util.coroutines"/>
    <module name="intellij.platform.util.ui"/>
    <!-- endregion -->
  </dependencies>
  <extensions defaultExtensionNs="com.intellij">
    <fileEditorProvider id="java-stacktrace-editor"
                        implementation="org.jetbrains.idea.devkit.stacktrace.editor.StackTraceEditorProvider"/>
    <analyzeStacktraceRunContentProvider id="freeze-run-content"
                                         implementation="org.jetbrains.idea.devkit.stacktrace.FreezeTabContentProvider"/>
  </extensions>
</idea-plugin>
