<idea-plugin>
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.devkit.core"/>
    <module name="intellij.java.psi"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.consoleView"/>
    <module name="intellij.platform.consoleView.impl"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.ide"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.progress"/>
    <module name="intellij.platform.util.ui"/>
  </dependencies>
  <!-- endregion -->

  <resource-bundle>messages.DevkitThreadingBundle</resource-bundle>

  <extensions defaultExtensionNs="com.intellij">
    <registryKey key="devkit.threading.open.statistics.report" defaultValue="false"
                 description="Open the statistics report in the editor after the lock requirements analysis completes"/>
  </extensions>

  <actions resource-bundle="messages.DevkitThreadingBundle">
    <action id="LockReqAnalysis"
            class="com.intellij.devkit.threading.threadingModelHelper.LockReqAction"
            icon="com.intellij.devkit.threading.icons.DevkitThreadingIcons.LockRequirements"/>
    <action id="ThreadingReqAnalysis"
            class="com.intellij.devkit.threading.threadingModelHelper.ThreadingReqAction"
            icon="com.intellij.devkit.threading.icons.DevkitThreadingIcons.LockRequirements"/>
  </actions>
</idea-plugin>
