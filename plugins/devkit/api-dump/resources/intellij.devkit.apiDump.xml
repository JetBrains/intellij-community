<idea-plugin visibility="internal">
  <dependencies>
    <module name="intellij.java.backend"/>
    <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.projectModel.impl"/>
    <!-- endregion -->
  </dependencies>

  <resource-bundle>messages.ApiDumpBundle</resource-bundle>

  <extensions defaultExtensionNs="com.intellij">
    <fileIconProvider implementation="com.intellij.devkit.apiDump.ApiDumpFileIconProvider"/>
    <generatedSourcesFilter implementation="com.intellij.devkit.apiDump.ApiDumpGeneratedSourcesFilter"/>
  </extensions>

</idea-plugin>
