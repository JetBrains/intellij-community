<idea-plugin>
  <extensions defaultExtensionNs="com.intellij">
    <!--
      The advertisement's switch, separate from Figma Connect's own keys: those ship inside the
      plugin, and this runs where the plugin is absent. No restartRequired — the value is read on
      every getSuggestion call.

      defaultValue is written twice, here and in FigmaAdvertiserRegistry, and they must agree.
    -->
    <registryKey defaultValue="true"
                 description="Suggest the Figma Connect plugin over a Markdown file that links to Figma"
                 key="markdown.figma.advertiser.enabled"/>

    <!--
      Advertises Figma Connect over a Markdown file that links to a design. Deliberately not a
      dependency of that plugin, and deliberately not depended on by it: this runs when the plugin is
      absent, and the platform drops the suggestion once it is loaded.
    -->
    <pluginSuggestionProvider
      implementation="com.intellij.markdown.figmaAdvertiser.FigmaConnectPluginSuggestionProvider"/>

    <statistics.counterUsagesCollector
      implementationClass="com.intellij.markdown.figmaAdvertiser.FigmaAdvertiserUsagesCollector"/>
  </extensions>
</idea-plugin>
