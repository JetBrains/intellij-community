<idea-plugin>
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <plugin id="com.intellij.modules.jcef"/>
    <module name="intellij.libraries.guava"/>
    <module name="intellij.libraries.jackson"/>
    <module name="intellij.libraries.jackson.databind"/>
    <module name="intellij.libraries.jackson.module.kotlin"/>
    <module name="intellij.libraries.jcef"/>
    <module name="intellij.libraries.jsoup"/>
    <module name="intellij.libraries.kotlinx.coroutines.core"/>
    <module name="intellij.libraries.markdown"/>
    <module name="intellij.libraries.miglayout.swing"/>
    <module name="intellij.libraries.netty.buffer"/>
    <module name="intellij.libraries.netty.codec.http"/>
    <module name="intellij.markdown"/>
    <module name="intellij.markdown.frontend"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.builtInServer"/>
    <module name="intellij.platform.builtInServer.impl"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.editor.ex"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.execution"/>
    <module name="intellij.platform.execution.impl"/>
    <module name="intellij.platform.frontend"/>
    <module name="intellij.platform.ide"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.indexing"/>
    <module name="intellij.platform.lang.impl"/>
    <module name="intellij.platform.markdown.utils"/>
    <module name="intellij.platform.project"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.projectModel.impl"/>
    <module name="intellij.platform.ui.jcef"/>
    <module name="intellij.platform.util.coroutines"/>
    <module name="intellij.platform.util.ex"/>
    <module name="intellij.platform.util.ui"/>
  </dependencies>
  <!-- endregion -->

  <extensions defaultExtensionNs="org.intellij.markdown">
    <html.panel.provider implementation="com.intellij.markdown.jcef.preview.JCEFHtmlPanelProvider"/>
    <browserPreviewExtensionProvider implementation="com.intellij.markdown.jcef.extensions.ProcessLinksExtension$Provider"/>
    <browserPreviewExtensionProvider implementation="com.intellij.markdown.jcef.extensions.ScrollbarsStyleExtension$Provider"/>

    <markdownExportProvider implementation="com.intellij.markdown.jcef.fileActions.export.MarkdownPdfExportProvider"/>
    <markdownExportProvider implementation="com.intellij.markdown.jcef.fileActions.export.MarkdownHtmlExportProvider"/>
  </extensions>

  <extensions defaultExtensionNs="com.intellij">
    <applicationService serviceImplementation="com.intellij.markdown.jcef.fileActions.export.MarkdownHtmlExportSettings"/>
    <applicationSettings service="com.intellij.markdown.jcef.fileActions.export.MarkdownHtmlExportSettings"/>
  </extensions>
</idea-plugin>
