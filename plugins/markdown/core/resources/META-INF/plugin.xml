<idea-plugin allow-bundled-update="true">
  <id>org.intellij.plugins.markdown</id>
  <name>Markdown</name>
  <vendor>JetBrains</vendor>
  <category>Languages</category>
  <resource-bundle>messages.MarkdownBundle</resource-bundle>

  <dependencies>
    <plugin id="com.intellij.modules.lang"/>
    <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
    <module name="intellij.libraries.caffeine"/>
    <module name="intellij.libraries.fastutil"/>
    <module name="intellij.libraries.guava"/>
    <module name="intellij.libraries.jsoup"/>
    <module name="intellij.libraries.kotlinx.coroutines.core"/>
    <module name="intellij.libraries.kotlinx.serialization.core"/>
    <module name="intellij.libraries.kotlinx.serialization.json"/>
    <module name="intellij.libraries.markdown"/>
    <module name="intellij.libraries.miglayout.swing"/>
    <module name="intellij.libraries.netty.buffer"/>
    <module name="intellij.libraries.netty.codec.http"/>
    <module name="intellij.libraries.snakeyaml"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.analysis.impl"/>
    <module name="intellij.platform.builtInServer"/>
    <module name="intellij.platform.builtInServer.impl"/>
    <module name="intellij.platform.codeStyle"/>
    <module name="intellij.platform.codeStyle.impl"/>
    <module name="intellij.platform.concurrency"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.editor.ex"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.ide"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.core.impl"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.ide.observable"/>
    <module name="intellij.platform.ide.progress"/>
    <module name="intellij.platform.ide.rpc"/>
    <module name="intellij.platform.ide.util.netty"/>
    <module name="intellij.platform.indexing"/>
    <module name="intellij.platform.indexing.impl"/>
    <module name="intellij.platform.lang"/>
    <module name="intellij.platform.lang.impl"/>
    <module name="intellij.platform.markdown.utils"/>
    <module name="intellij.platform.project"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.projectModel.impl"/>
    <module name="intellij.platform.refactoring"/>
    <module name="intellij.platform.rpc.lite"/>
    <module name="intellij.platform.statistics"/>
    <module name="intellij.platform.usageView"/>
    <module name="intellij.platform.usageView.impl"/>
    <module name="intellij.platform.util.coroutines"/>
    <module name="intellij.platform.util.ex"/>
    <module name="intellij.platform.util.text.matching"/>
    <module name="intellij.platform.util.ui"/>
    <!-- endregion -->
  </dependencies>

  <content namespace="jetbrains">
    <module name="intellij.markdown" loading="embedded"/>
    <module name="intellij.markdown.jcef" loading="optional"/>
    <module name="intellij.markdown.fenceInjection"/>
    <module name="intellij.markdown.frontmatter"/>
    <module name="intellij.markdown.frontmatter.yaml"/>
    <module name="intellij.markdown.frontmatter.toml"/>
    <module name="intellij.markdown.images"/>
    <module name="intellij.markdown.xml"/>
    <module name="intellij.markdown.model"/>
    <module name="intellij.markdown.spellchecker"/>
    <module name="intellij.markdown.compose.preview"/>
    <module name="intellij.markdown.frontend"/>
    <module name="intellij.markdown.frontend.execution"/>
    <module name="intellij.markdown.execution"/>
    <module name="intellij.markdown.frontend.split"/>
    <module name="intellij.markdown.backend"/>
    <module name="intellij.markdown.java"/>
    <module name="intellij.markdown.fenceInjector.textMate"/>
    <module name="intellij.markdown.projectView"/>
    <module name="intellij.markdown.figmaAdvertiser"/>
    <module name="intellij.markdown.vcs"/>
  </content>

  <description><![CDATA[
    <p>Provides editing assistance for Markdown files within the IDE.</p>
    </br>
    <ul>
      <li>Full support for vanilla Markdown syntax: highlighting, completion, navigation, inspection, intentions, and much more.</li>
      <li>Live HTML preview, customizable with CSS (except Android Studio, see <a href="https://issuetracker.google.com/issues/159933628?pli=1#comment7">issue and workaround</a>).</li>
      <li>Assistance for editing tables and lists: automatic alignment and numbering.</li>
      <li>Drag and drop to insert images.</li>
      <li>Language injection in code blocks.</li>
      <li>Pandoc Converter for HTML, Microsoft Word, and PDF formats.</li>
      <li>Support for PlantUML diagram rendering (you can add support for Mermaid diagrams with a <a href="https://plugins.jetbrains.com/plugin/20146-mermaid">separate plugin</a>).</li>
    </ul>
  ]]></description>
</idea-plugin>
