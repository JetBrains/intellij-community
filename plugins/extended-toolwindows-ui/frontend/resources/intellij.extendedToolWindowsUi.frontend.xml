<idea-plugin>
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.frontend"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.ide.ui"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.util.ui"/>
  </dependencies>
  <!-- endregion -->

  <actions resource-bundle="messages.ExtendedToolWindowsUiBundle">
    <group id="ExtendedToolWindowsUi.StripeButtonPopup">
      <action id="ExtendedToolWindowsUi.ShowToolWindowNumbers"
              class="com.intellij.extendedToolWindowsUi.frontend.ToolWindowShowNumbersAction"/>
      <action id="ExtendedToolWindowsUi.RotateIconsWithNames"
              class="com.intellij.extendedToolWindowsUi.frontend.ToolWindowRotateIconsAction"/>
      <add-to-group group-id="ToolWindowStripeButtonPopup" anchor="last"/>
    </group>
  </actions>

  <extensions defaultExtensionNs="com.intellij">
    <toolWindowStripeExtension implementation="com.intellij.extendedToolWindowsUi.frontend.ToolWindowStripeExtensionImpl"/>
    <advancedSetting id="extended.tool.windows.ui.rotate.icons" default="false"
                     groupKey="advanced.setting.group.extended.tool.windows.ui" bundle="messages.ExtendedToolWindowsUiBundle"/>
  </extensions>

  <applicationListeners>
    <listener class="com.intellij.extendedToolWindowsUi.frontend.ToolWindowRotateIconsSettingListener"
              topic="com.intellij.openapi.options.advanced.AdvancedSettingsChangeListener"/>
  </applicationListeners>
</idea-plugin>
