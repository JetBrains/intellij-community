<idea-plugin require-restart="true">
  <name>Extended ToolWindows UI</name>
  <id>com.intellij.extendedToolWindowsUi</id>
  <vendor>JetBrains</vendor>

  <dependencies>
    <module name="intellij.platform.monolith"/>
    <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.util.ui"/>
    <!-- endregion -->
  </dependencies>
  <content namespace="jetbrains"/>
  <incompatible-with>com.intellij.jetbrains.client</incompatible-with>

  <description><![CDATA[
        Provides toolwindows features, like tool window layout, vertical toolwindow labels, etc.
    ]]></description>

  <extensions defaultExtensionNs="com.intellij">
    <toolWindowExtension implementation="com.intellij.extendedToolWindowsUi.ToolWindowExtensionImpl"/>
  </extensions>
</idea-plugin>
