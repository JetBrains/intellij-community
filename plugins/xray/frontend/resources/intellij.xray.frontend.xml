<idea-plugin>
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.libraries.miglayout.swing"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.debugger"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.frontend"/>
    <module name="intellij.platform.ide"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.ide.rpc"/>
    <module name="intellij.platform.lang"/>
    <module name="intellij.platform.lang.core"/>
    <module name="intellij.platform.lang.impl"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.util.ui"/>
  </dependencies>
  <!-- endregion -->

  <resource-bundle>messages.XRayBundle</resource-bundle>

  <extensions defaultExtensionNs="com.intellij">
    <editorFactoryListener implementation="com.intellij.xray.frontend.impl.editorTracking.XRayModeTracker"/>
    <iw.actionProvider implementation="com.intellij.xray.frontend.impl.action.XRayModeActionProvider"/>
    <notificationGroup displayType="BALLOON" id="X-Ray Inlay Visibility" bundle="messages.XRayBundle" key="xray.inlay.notification.group"/>

    <!-- Platform EPs -->
    <codeInsight.inlayHintSettingsOverrider implementation="com.intellij.xray.frontend.impl.platform.XRayInlayHintSettingsOverrider"/>
    <codeInsight.inlayContextMenuContributor implementation="com.intellij.xray.frontend.impl.platform.XRayInlayContextMenuContributor"/>
    <codeInsight.inlaySettingsConfigurableFactory
      implementation="com.intellij.xray.frontend.impl.platform.XRayInlaySettingsConfigurableFactory"/>
    <codeInsight.declarativeInlayPayloadContributor
      implementation="com.intellij.xray.frontend.impl.platform.XRayDeclarativeInlayPayloadContributor"/>
    <codeVision.codeVisionEntryExtraActionContributor
      implementation="com.intellij.xray.frontend.impl.platform.XRayCodeVisionEntryExtraActionContributor"/>
  </extensions>

  <projectListeners>
    <listener class="com.intellij.xray.frontend.impl.editorTracking.XRaySelectionListener"
              topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    <listener class="com.intellij.xray.frontend.impl.debugger.XRayDebuggerUseModeListener"
              topic="com.intellij.xdebugger.XDebuggerManagerListener"/>
  </projectListeners>

  <actions resource-bundle="messages.XRayBundle">
    <action id="ToggleXRayMode" class="com.intellij.xray.frontend.impl.action.ToggleXRayModeAction" icon="AllIcons.General.InspectionsEye">
      <keyboard-shortcut first-keystroke="ctrl shift X" keymap="$default"/>
    </action>
    <group id="XRayHintVisibility" class="com.intellij.xray.frontend.impl.action.XRayHintVisibilityGroup">
      <add-to-group group-id="InlayMenu" anchor="first"/>
    </group>
  </actions>

  <applicationListeners>
    <listener class="com.intellij.xray.frontend.impl.XRayDynamicPluginListener" topic="com.intellij.ide.plugins.DynamicPluginListener"/>
  </applicationListeners>
</idea-plugin>
