<!-- BUILD_USING_BAZEL_MARKER: this plugin is also packaged by the `ij_plugin` Bazel rule, and IjPluginDistributionEquivalenceTest
     checks that the result matches the distribution produced by the build scripts. See MRI-4743. -->
<idea-plugin>
  <id>com.intellij.xray</id>
  <name>X-Ray Mode</name>
  <vendor>JetBrains</vendor>
  <description>X-Ray Mode support for IntelliJ Platform Inlay hints</description>

  <dependencies>
    <plugin id="com.intellij.modules.lang"/>
  </dependencies>

  <content namespace="jetbrains">
    <module name="intellij.xray.frontend" required-if-available="intellij.platform.frontend"/>
    <module name="intellij.xray.shared" loading="required"/>
    <module name="intellij.xray.backend" required-if-available="intellij.platform.backend"/>
  </content>
</idea-plugin>
