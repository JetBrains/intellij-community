<idea-plugin visibility="internal">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.java.analysis"/>
    <module name="intellij.java.compiler"/>
    <module name="intellij.java.compiler.impl"/>
    <module name="intellij.java.frontback.psi.impl"/>
    <module name="intellij.lombok"/>
    <module name="intellij.platform.concurrency"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.ide"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.indexing"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.util.ui"/>
  </dependencies>
  <!-- endregion -->

  <extensions defaultExtensionNs="com.intellij">
    <buildProcess.parametersProvider implementation="com.intellij.lombok.compiler.LombokBuildProcessParametersProvider"/>
  </extensions>

  <projectListeners>
    <listener class="com.intellij.lombok.compiler.LombokBuildManagerListener"
              topic="com.intellij.compiler.server.BuildManagerListener"/>
  </projectListeners>
</idea-plugin>