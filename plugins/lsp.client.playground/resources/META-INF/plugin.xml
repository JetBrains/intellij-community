<idea-plugin package="com.intellij.lsp.client.playground" allow-bundled-update="true">
  <name>LSP Client Playground</name>
  <id>com.intellij.lsp.client.playground</id>
  <category>Other Tools</category>
  <description><![CDATA[
    Temporary LSP client playground for development runs.
  ]]></description>
  <vendor>JetBrains</vendor>

  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.frontend"/>
    <module name="intellij.platform.lang"/>
    <module name="intellij.platform.lsp"/>
    <module name="intellij.platform.lsp.impl"/>
    <module name="intellij.platform.util.ui"/>
  </dependencies>
  <!-- endregion -->

  <extensions defaultExtensionNs="com.intellij">
    <platform.lsp.integrationProvider implementation="com.intellij.lsp.client.playground.DartLspIntegrationProvider"/>
    <platform.lsp.integrationProvider implementation="com.intellij.lsp.client.playground.LuaLspIntegrationProvider"/>
    <platform.lsp.integrationProvider implementation="com.intellij.lsp.client.playground.RustLspIntegrationProvider"/>
    <platform.lsp.integrationProvider implementation="com.intellij.lsp.client.playground.SwiftLspIntegrationProvider"/>
    <fileType name="Dart" extensions="dart" implementationClass="com.intellij.lsp.client.playground.DartLspFileType"/>
    <fileType name="Lua" extensions="lua" implementationClass="com.intellij.lsp.client.playground.LuaLspFileType"/>
    <fileType name="Rust" extensions="rs" implementationClass="com.intellij.lsp.client.playground.RustLspFileType"/>
    <fileType name="Swift" extensions="swift" implementationClass="com.intellij.lsp.client.playground.SwiftLspFileType"/>
  </extensions>
  <resource-bundle>messages.LspClientPlaygroundBundle</resource-bundle>
</idea-plugin>
