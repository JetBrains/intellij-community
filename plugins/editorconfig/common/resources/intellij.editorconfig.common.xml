<idea-plugin visibility="internal">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.analysis.impl"/>
    <module name="intellij.platform.codeStyle"/>
    <module name="intellij.platform.codeStyle.impl"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.lang"/>
    <module name="intellij.platform.lang.impl"/>
    <module name="intellij.platform.util.ex"/>
    <module name="intellij.platform.util.ui"/>
  </dependencies>
  <!-- endregion -->
  <extensions defaultExtensionNs="com.intellij">
    <fileType name="EditorConfig"
              language="EditorConfig"
              implementationClass="com.intellij.editorconfig.common.plugin.EditorConfigFileType"
              fieldName="INSTANCE"
              fileNames=".editorconfig"/>
    <!--<editor.rd.localSupport filetype="EditorConfig"/> IJPL-189393-->
    <lang.parserDefinition language="EditorConfig"
                           implementationClass="com.intellij.editorconfig.common.plugin.EditorConfigParserDefinition"/>
    <lang.braceMatcher language="EditorConfig" implementationClass="com.intellij.editorconfig.common.lang.EditorConfigBraceMatcher"/>
    <lang.formatter language="EditorConfig"
                    implementationClass="com.intellij.editorconfig.common.formatting.EditorConfigFormattingModelBuilder"/>
    <lang.commenter language="EditorConfig" implementationClass="com.intellij.editorconfig.common.lang.EditorConfigCommenter"/>
    <lang.syntaxHighlighterFactory language="EditorConfig"
                                   implementationClass="com.intellij.editorconfig.common.highlighting.EditorConfigSyntaxHighlighterFactory"/>

    <statementUpDownMover implementation="com.intellij.editorconfig.common.editor.EditorConfigStatementUpDownMover"/>
    <moveLeftRightHandler language="EditorConfig"
                          implementationClass="com.intellij.editorconfig.common.editor.EditorConfigMoveElementLeftRightHandler"/>
    <enterHandlerDelegate implementation="com.intellij.editorconfig.common.editor.EnterInEditorConfigFileHandler"/>
    <typedHandler implementation="com.intellij.editorconfig.common.editor.EditorConfigTypedHandlerDelegate"/>
  </extensions>
</idea-plugin>
