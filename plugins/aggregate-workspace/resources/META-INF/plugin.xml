<idea-plugin>
  <id>com.intellij.aggregateworkspace</id>
  <name>%plugin.name%</name>
  <version>0.1</version>
  <vendor>joeyr64</vendor>
  <resource-bundle>messages.WorkspaceBundle</resource-bundle>
  <description>%plugin.description%</description>

  <depends>com.intellij.modules.platform</depends>

  <extensions defaultExtensionNs="com.intellij">
    <toolWindow
      id="WorkspaceShell"
      anchor="right"
      factoryClass="com.intellij.aggregateworkspace.WorkspaceShellToolWindowFactory"
      secondary="true"
      canCloseContents="true"/>
  </extensions>
</idea-plugin>
