<!-- BUILD_USING_BAZEL_MARKER: this plugin is also packaged by the `ij_plugin` Bazel rule, and IjPluginDistributionEquivalenceTest
     checks that the result matches the distribution produced by the build scripts. See IJPL-251444. -->
<idea-plugin>
<name>Visual Studio 2022 Keymap</name>
<id>com.intellij.plugins.visualstudio2022keymap</id>
<vendor>JetBrains</vendor>
<category>Keymap</category>
<description>
  Visual Studio 2022 keymap for all IntelliJ-based IDEs.
  Use this plugin if Visual Studio 2022 keymap is not pre-installed in your IDE.
</description>
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.platform.ide.impl"/>
  </dependencies>
  <!-- endregion -->
<depends>com.intellij.modules.lang</depends>
<depends>com.intellij.plugins.visualstudiokeymap</depends>
<extensions defaultExtensionNs="com.intellij">
    <bundledKeymap file="Visual Studio 2022.xml"/>
</extensions>
</idea-plugin>