<idea-plugin>
  <id>com.intellij.java.rareRefactorings</id>
  <name>Additional Java Refactorings</name>
  <category>JVM Tools</category>
  <depends>com.intellij.java</depends>
  <depends>com.intellij.modules.platform</depends>
  <description>
    Provides the "Convert Raw Types to Generics", "Remove Middle Man", "Replace Temp with Query" and "Wrap Method Return Value" refactorings
  </description>
  <vendor>JetBrains</vendor>
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.java.psi"/>
    <module name="intellij.java.syntax"/>
    <module name="intellij.libraries.fastutil"/>
    <module name="intellij.libraries.kotlinx.collections.immutable"/>
    <module name="intellij.libraries.stream"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.codeStyle"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.indexing"/>
    <module name="intellij.platform.lang"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.usageView"/>
    <module name="intellij.platform.util.ui"/>
  </dependencies>
  <!-- endregion -->
  <content namespace="jetbrains"/>
  <actions>
    <group id="AdditionalRefactoringsMenu">
      <add-to-group group-id="RefactoringMenu" anchor="last"/>
      <action id="RemoveMiddleman" class="com.intellij.refactoring.actions.RemoveMiddlemanAction"/>
      <action id="ReplaceTempWithQuery" class="com.intellij.refactoring.actions.TempWithQueryAction"/>
      <action id="WrapReturnValue" class="com.intellij.refactoring.wrapreturnvalue.WrapReturnValueAction"/>
      <separator/>
      <action id="Generify" class="com.intellij.refactoring.actions.TypeCookAction"/>
    </group>
  </actions>
  <resource-bundle>messages.JavaRareRefactoringsBundle</resource-bundle>
  
</idea-plugin>
