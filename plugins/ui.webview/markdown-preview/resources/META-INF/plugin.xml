<idea-plugin allow-bundled-update="true">
  <id>org.intellij.plugins.markdown.webview.preview</id>
  <name>Markdown WebView Preview (Deprecated)</name>
  <vendor>JetBrains</vendor>
  <category>Languages</category>
  <description><![CDATA[
    Plugin moved to https://github.com/nerzhulart/intellij-webview
    Provides a Markdown preview powered by an embedded WebView panel.
    <ul>
      <li>Renders Markdown content in the same kind of browser surface used by WebView-based IDE UI.</li>
      <li>Uses browser engines: WKWebView on macOS, Microsoft Edge WebView2 on Windows, and JCEF on Linux.</li>
      <li>Fits the WebView frontend workflow where UI and preview assets can be authored with HTML, CSS, TypeScript, frontend frameworks, Vite, and typed Kotlin/TypeScript interop.</li>
    </ul>
  ]]></description>

  <dependencies>
    <plugin id="org.intellij.plugins.markdown"/>
    <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
    <plugin id="com.intellij.platform.ui.webview"/>
    <module name="intellij.libraries.jetbrains.annotations"/>
    <module name="intellij.libraries.kotlinx.coroutines.core"/>
    <module name="intellij.libraries.kotlinx.serialization.core"/>
    <module name="intellij.libraries.kotlinx.serialization.json"/>
    <module name="intellij.markdown"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.execution"/>
    <module name="intellij.platform.ide"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.indexing"/>
    <module name="intellij.platform.project"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.util.coroutines"/>
    <module name="intellij.platform.util.ui"/>
    <!-- endregion -->
  </dependencies>
  <content namespace="jetbrains"/>

  <extensions defaultExtensionNs="org.intellij.markdown">
    <html.panel.provider implementation="org.intellij.plugins.markdown.webview.preview.WebViewMarkdownPreviewPanelProvider"/>
  </extensions>
</idea-plugin>
