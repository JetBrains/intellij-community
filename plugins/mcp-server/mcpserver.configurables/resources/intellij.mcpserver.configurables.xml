<idea-plugin visibility="public">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.libraries.kotlinx.serialization.core"/>
    <module name="intellij.libraries.kotlinx.serialization.json"/>
    <module name="intellij.mcpserver"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.compose.swing"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.ide.progress"/>
    <module name="intellij.platform.lang.impl"/>
    <module name="intellij.platform.util.ex"/>
    <module name="intellij.platform.util.ui"/>
  </dependencies>
  <!-- endregion -->

  <extensions defaultExtensionNs="com.intellij">
    <applicationConfigurable
      instance="com.intellij.mcpserver.configurables.McpServerSettingsConfigurable"
      id="com.intellij.mcpserver.settings"
      key="mcp.server.configurable.name"
      bundle="messages.McpServerBundle"
      parentId="ai"/>

    <applicationConfigurable
      instance="com.intellij.mcpserver.configurables.McpToolFilterConfigurable"
      id="com.intellij.mcpserver.settings.filter"
      key="configurable.mcp.tool.filter"
      bundle="messages.McpServerBundle"
      parentId="com.intellij.mcpserver.settings"/>
  </extensions>
</idea-plugin>
