<idea-plugin visibility="public">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.libraries.kotlinx.serialization.core"/>
    <module name="intellij.libraries.kotlinx.serialization.json"/>
    <module name="intellij.mcpserver"/>
    <module name="intellij.mcpserver.configurables"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.compose.swing"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.frontend"/>
    <module name="intellij.platform.ide"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.core.impl"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.ide.progress"/>
    <module name="intellij.platform.lang"/>
    <module name="intellij.platform.lang.impl"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.util.coroutines"/>
    <module name="intellij.platform.util.ex"/>
    <module name="intellij.platform.util.ui"/>
  </dependencies>
  <!-- endregion -->

  <extensions defaultExtensionNs="com.intellij">
    <applicationService serviceInterface="com.intellij.mcpserver.McpServerConsentUi"
                        serviceImplementation="com.intellij.mcpserver.util.McpServerConsentUiImpl"/>
    <applicationService serviceInterface="com.intellij.mcpserver.McpUnauthorizedRequestNotifier"
                        serviceImplementation="com.intellij.mcpserver.frontend.util.McpUnauthorizedRequestNotifierImpl"/>

    <serviceViewContributor implementation="com.intellij.mcpserver.frontend.services.McpServiceViewContributor"/>

    <statusBarWidgetFactory id="McpServerStatusBarWidget"
                            implementation="com.intellij.mcpserver.frontend.widget.McpServerStatusBarWidgetFactory"
                            order="after PowerSaveMode"/>
  </extensions>

  <actions resource-bundle="messages.McpServerBundle">
    <action id="ShowMcpTools" class="com.intellij.mcpserver.frontend.actions.ShowMcpToolsAction">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
  </actions>
</idea-plugin>
