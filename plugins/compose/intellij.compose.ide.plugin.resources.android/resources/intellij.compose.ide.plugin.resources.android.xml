    <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
    <module name="intellij.compose.ide.plugin.resources"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.ide"/>
    <!-- endregion -->
  </dependencies>

  <extensions defaultExtensionNs="com.intellij.compose.ide.plugin.resources">
    <drawablePreviewRenderer
      implementation="com.intellij.compose.ide.plugin.resources.android.AndroidDrawablePreviewRenderer"
      order="first"/>
