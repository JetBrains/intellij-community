<!-- BUILD_USING_BAZEL_MARKER: this plugin is also packaged by the `ij_plugin` Bazel rule, and IjPluginDistributionEquivalenceTest
     checks that the result matches the distribution produced by the build scripts. See IJPL-251444. -->
<idea-plugin package="com.intellij.compose.ide.plugin">
  <id>com.intellij.compose</id>
  <name>Compose Multiplatform</name>
  <vendor>JetBrains</vendor>
  <category>Kotlin Frameworks</category>
  <description>
    <![CDATA[
      IDE support for developing <a href="https://www.jetbrains.com/compose-multiplatform/">Compose Multiplatform</a> and <a href="https://developer.android.com/compose">Jetpack Compose</a> applications.
    ]]>
  </description>

  <dependencies>
    <plugin id="org.jetbrains.kotlin" />
  </dependencies>

  <content namespace="jetbrains">
    <module name="intellij.compose.ide.plugin.shared"/>
    <module name="intellij.compose.ide.plugin.codeInsight"/>
    <module name="intellij.compose.ide.plugin.gradleTooling.rt"/>
    <module name="intellij.compose.ide.plugin.resources"/>
    <module name="intellij.compose.ide.plugin.resources.android"/>

    <!-- ultimate part -->
    <!-- Only this plugin can declare the shared wizard library. A second copy uses another classloader and breaks calls into
         `intellij.kmm.wizard`. -->
    <module name="intellij.libraries.kmp.wizard.shared" loading="optional"/>
    <module name="intellij.kmm.wizard" loading="optional"/>
  </content>

  <content>
    <module name="intellij.marketplace.statisticsCompat" loading="optional"/>
  </content>

</idea-plugin>
