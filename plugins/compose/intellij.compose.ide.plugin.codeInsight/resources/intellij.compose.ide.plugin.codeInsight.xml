<idea-plugin package="com.intellij.compose.ide.plugin.codeInsight">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <plugin id="com.intellij.modules.kotlin"/>
    <module name="intellij.compose.ide.plugin.shared"/>
    <module name="intellij.gradle"/>
    <module name="intellij.java.psi"/>
    <module name="intellij.kotlin.base.analysis.utils"/>
    <module name="intellij.kotlin.base.codeInsight"/>
    <module name="intellij.kotlin.base.compilerConfiguration"/>
    <module name="intellij.kotlin.base.facet"/>
    <module name="intellij.kotlin.base.util"/>
    <module name="intellij.kotlin.codeInsight.api"/>
    <module name="intellij.kotlin.codeInsight.inspections"/>
    <module name="intellij.kotlin.completion.impl"/>
    <module name="intellij.kotlin.highlighting"/>
    <module name="intellij.kotlin.projectConfiguration"/>
    <module name="intellij.kotlin.refactorings"/>
    <module name="intellij.kotlin.refactorings.base"/>
    <module name="intellij.kotlin.references"/>
    <module name="intellij.libraries.kotlinc.analysis.api"/>
    <module name="intellij.libraries.kotlinc.analysis.api.k2"/>
    <module name="intellij.libraries.kotlinc.kotlin.compiler.common"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.analysis.impl"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.externalSystem.impl"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.lang"/>
    <module name="intellij.platform.lang.core"/>
    <module name="intellij.platform.lang.impl"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.uast"/>
    <module name="intellij.platform.util.ui"/>
  </dependencies>
  <!-- endregion -->

  <extensions defaultExtensionNs="org.jetbrains.kotlin">
    <callHighlighterExtension
      implementation="com.intellij.compose.ide.plugin.codeInsight.highlighting.ComposableFunctionCallHighlighterExtension"/>
    <extractFunctionDescriptorModifier implementation="com.intellij.compose.ide.plugin.codeInsight.ComposableAnnotationToExtractedFunctionAdder"
                                       order="last"/>
    <libraryVersionProvider
      implementation="com.intellij.compose.ide.plugin.codeInsight.ComposeRuntimeLibraryVersionProvider"/>
  </extensions>

  <extensions defaultExtensionNs="com.intellij.compose.ide.plugin.shared">
    <composeModuleConfiguration implementation="com.intellij.compose.ide.plugin.codeInsight.inspections.GradleComposeModuleConfigurationExtension"/>
  </extensions>

  <extensions defaultExtensionNs="com.intellij">
    <additionalTextAttributes scheme="Default" file="colorSchemes/IntelliJComposeColorSchemeDefault.xml"/>
    <additionalTextAttributes scheme="Darcula" file="colorSchemes/IntelliJComposeColorSchemeDarcula.xml"/>
    <codeInsight.lineMarkerProvider language="kotlin"
                                    implementationClass="com.intellij.compose.ide.plugin.codeInsight.lineMarkers.ComposeColorLineMarkerProviderDescriptor"/>
    <codeInsight.unresolvedReferenceQuickFixProvider
      implementation="com.intellij.compose.ide.plugin.codeInsight.intentions.AddComposeRuntimeQuickFixProvider"/>
    <completion.contributor language="kotlin"
                            implementationClass="com.intellij.compose.ide.plugin.codeInsight.completion.ComposeModifierCompletionContributor"
                            order="first, before KotlinCompletionContributor"/>
    <daemon.highlightInfoFilter implementation="com.intellij.compose.ide.plugin.codeInsight.inspections.ComposeMissingDependencyHighlightFilter"/>
    <lang.inspectionSuppressor language="kotlin"
                               implementationClass="com.intellij.compose.ide.plugin.codeInsight.inspections.ComposableNamingInspectionSuppressor"/>
    <localInspection implementationClass="com.intellij.compose.ide.plugin.codeInsight.inspections.ComposeMissingPluginInspection"
                     language="kotlin"
                     enabledByDefault="true"
                     bundle="messages.ComposeIdeBundle"
                     groupKey="compose.inspection.group.name"
                     key="compose.inspection.missing.plugin.name"
                     level="ERROR"
                     shortName="ComposableCallWithoutComposePlugin"/>
    <localInspection implementationClass="com.intellij.compose.ide.plugin.codeInsight.inspections.MultiplatformPreviewAnnotationInFunctionWithParametersInspection"
                     language="kotlin"
                     enabledByDefault="true"
                     bundle="messages.ComposeIdeBundle"
                     groupKey="compose.preview.inspection.group.name"
                     key="compose.preview.inspection.no.parameters.name"
                     level="ERROR"/>
    <localInspection implementationClass="com.intellij.compose.ide.plugin.codeInsight.inspections.MultiplatformPreviewMultipleParameterProvidersInspection"
                     language="kotlin"
                     enabledByDefault="true"
                     bundle="messages.ComposeIdeBundle"
                     groupKey="compose.preview.inspection.group.name"
                     key="compose.preview.inspection.no.multiple.preview.provider.name"
                     level="ERROR"/>
    <overrideImplementsAnnotationsFilter id="ComposeOverrideImplementsAnnotationsFilter"
                                         implementation="com.intellij.compose.ide.plugin.codeInsight.ComposeOverrideImplementsAnnotationsFilter" />
    <pluginSuggestionProvider implementation="com.intellij.compose.ide.plugin.codeInsight.suggestions.KmpPluginSuggestionProvider"/>
  </extensions>
</idea-plugin>