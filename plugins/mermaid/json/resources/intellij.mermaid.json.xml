<idea-plugin>
  <dependencies>
    <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
    <plugin id="com.intellij.mermaid"/>
    <module name="intellij.json.backend"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.lang"/>
    <module name="intellij.platform.projectModel"/>
    <!-- endregion -->
  </dependencies>

  <extensions defaultExtensionNs="JavaScript.JsonSchema">
    <ProviderFactory implementation="com.intellij.mermaid.json.DirectiveJsonSchemaProviderFactory"/>
    <ProviderFactory implementation="com.intellij.mermaid.json.FrontmatterYamlSchemaProviderFactory"/>
  </extensions>
</idea-plugin>
