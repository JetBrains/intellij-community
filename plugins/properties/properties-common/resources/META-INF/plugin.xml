<idea-plugin package="com.intellij.lang.properties" allow-bundled-update="true">
  <id>com.intellij.properties</id>
  <name>Properties</name>
  <category>Languages</category>
  <description>
    Enables smart editing of .properties files.
  </description>
  <vendor>JetBrains</vendor>
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.libraries.kotlinx.collections.immutable"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.codeStyle"/>
    <module name="intellij.platform.codeStyle.impl"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.ide"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.lang"/>
    <module name="intellij.platform.lang.impl"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.refactoring"/>
  </dependencies>
  <!-- endregion -->
  <resource-bundle>messages.PropertiesBundle</resource-bundle>

  <content namespace="jetbrains">
    <module name="intellij.properties.copyright"/>
    <module name="intellij.properties.backend.psi" required-if-available="intellij.platform.backend"/>
    <module name="intellij.properties.backend" required-if-available="intellij.platform.backend"/>
    <module name="intellij.properties" loading="embedded"/>
    <module name="intellij.properties.psi" loading="embedded"/>
  </content>
</idea-plugin>
