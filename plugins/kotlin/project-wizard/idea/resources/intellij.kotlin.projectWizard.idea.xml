<idea-plugin visibility="internal">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.gradle"/>
    <module name="intellij.java.ui"/>
    <module name="intellij.kotlin.base.compilerConfiguration"/>
    <module name="intellij.kotlin.base.externalSystem"/>
    <module name="intellij.kotlin.base.facet"/>
    <module name="intellij.kotlin.base.indices"/>
    <module name="intellij.kotlin.base.plugin"/>
    <module name="intellij.kotlin.base.statistics"/>
    <module name="intellij.kotlin.base.util"/>
    <module name="intellij.kotlin.codeInsight.api"/>
    <module name="intellij.kotlin.formatter"/>
    <module name="intellij.kotlin.projectConfiguration"/>
    <module name="intellij.kotlin.projectWizard.core"/>
    <module name="intellij.libraries.java.compatibility"/>
    <module name="intellij.libraries.kotlinx.collections.immutable"/>
    <module name="intellij.libraries.kotlinx.coroutines.core"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.codeStyle"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.execution"/>
    <module name="intellij.platform.externalSystem"/>
    <module name="intellij.platform.externalSystem.impl"/>
    <module name="intellij.platform.ide"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.ide.progress"/>
    <module name="intellij.platform.indexing"/>
    <module name="intellij.platform.lang"/>
    <module name="intellij.platform.lang.core"/>
    <module name="intellij.platform.lang.impl"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.statistics"/>
    <module name="intellij.platform.util.ui"/>
    <module name="intellij.platform.vcs.impl"/>
  </dependencies>
  <!-- endregion -->

  <extensionPoints>
    <extensionPoint qualifiedName="org.jetbrains.kotlin.idea.ideaWizardService" area="IDEA_PROJECT"
                    interface="org.jetbrains.kotlin.tools.projectWizard.wizard.service.IdeaWizardService"
                    dynamic="true"/>

    <extensionPoint
            qualifiedName="com.intellij.newProjectWizard.kotlin.buildSystem"
            interface="org.jetbrains.kotlin.tools.projectWizard.BuildSystemKotlinNewProjectWizard" dynamic="true"/>


  </extensionPoints>

  <extensions defaultExtensionNs="com.intellij">
    <newProjectWizard.languageGenerator implementation="org.jetbrains.kotlin.tools.projectWizard.KotlinNewProjectWizard"/>

    <newProjectWizard.kotlin.buildSystem implementation="org.jetbrains.kotlin.tools.projectWizard.IntelliJKotlinNewProjectWizard"/>
  </extensions>


  <extensions defaultExtensionNs="org.jetbrains.kotlin.idea">
    <ideaWizardService implementation="org.jetbrains.kotlin.tools.projectWizard.wizard.service.IdeaFileFormattingService"/>
    <ideaWizardService implementation="org.jetbrains.kotlin.tools.projectWizard.wizard.service.IdeaRunConfigurationsService"/>
  </extensions>
</idea-plugin>
