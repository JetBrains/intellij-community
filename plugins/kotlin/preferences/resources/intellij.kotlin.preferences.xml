<idea-plugin visibility="public">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.kotlin.base.plugin"/>
    <module name="intellij.kotlin.base.util"/>
    <module name="intellij.kotlin.plugin.updater"/>
    <module name="intellij.libraries.swingx"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.util.ui"/>
  </dependencies>
  <!-- endregion -->
  <extensionPoints>
    <extensionPoint
            qualifiedName="org.jetbrains.kotlin.experimentalFeature"
            interface="org.jetbrains.kotlin.idea.configuration.ExperimentalFeature"
            dynamic="true"/>
  </extensionPoints>
  <extensions defaultExtensionNs="com.intellij">
    <!--suppress SplitModeXmlApiUsage -->
    <applicationConfigurable
            groupId="language"
            bundle="messages.KotlinPreferencesBundle"
            key="kotlin.language.configurable"
            id="preferences.language.Kotlin"
            instance="org.jetbrains.kotlin.idea.configuration.KotlinLanguageConfiguration"/>

  </extensions>
</idea-plugin>
