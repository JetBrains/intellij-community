            order="last"
            implementation="org.jetbrains.kotlin.idea.actions.KotlinDefaultTemplatePropertiesProvider"
    />
    <referenceImporter
            id="KotlinReferenceImporter"
            implementation="org.jetbrains.kotlin.idea.codeInsight.KotlinReferenceImporter"/>
  </extensions>

