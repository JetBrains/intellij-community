<idea-plugin>
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <plugin id="com.intellij.java-i18n"/>
    <module name="intellij.kotlin.base.codeInsight"/>
    <module name="intellij.kotlin.codeInsight.api"/>
    <module name="intellij.libraries.kotlinc.analysis.api"/>
    <module name="intellij.libraries.kotlinc.kotlin.compiler.common"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
    <module name="kotlin.fir.frontend-independent"/>
  </dependencies>
  <!-- endregion -->

  <extensions defaultExtensionNs="com.intellij">

      <localInspection implementationClass="org.jetbrains.kotlin.idea.i18n.KotlinInvalidBundleOrPropertyInspection"
                       groupBundle="messages.KotlinBundle" groupKey="group.names.kotlin"
                       language="kotlin"
                       enabledByDefault="true"
                       level="ERROR"
                       suppressId="InvalidBundleOrProperty"
                       key="inspection.kotlin.invalid.bundle.or.property.display.name" bundle="messages.KotlinBundle"/>
  </extensions>
</idea-plugin>