<idea-plugin>
  <dependencies>
    <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
    <plugin id="com.intellij.copyright"/>
    <module name="intellij.libraries.kotlinc.kotlin.compiler.common"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.projectModel"/>
    <!-- endregion -->
  </dependencies>

  <extensions defaultExtensionNs="com.intellij.copyright">
    <updater filetype="Kotlin" implementationClass="org.jetbrains.kotlin.idea.copyright.UpdateKotlinCopyrightsProvider"/>
  </extensions>
</idea-plugin>
