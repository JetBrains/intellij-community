    <module name="intellij.kotlin.formatter.minimal" loading="embedded"/>
    <module name="intellij.kotlin.formatter" loading="embedded"/>

    <module name="intellij.kotlin.compilerReferenceIndex"/>

    <module name="intellij.kotlin.compilerPlugins.assignment.fixes"/>
