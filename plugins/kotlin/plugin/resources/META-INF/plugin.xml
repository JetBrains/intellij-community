    <module name="intellij.kotlin.j2k"/>
    <module name="intellij.kotlin.internal"/>

    <module name="intellij.kotlin.performanceExtendedPlugin"/>

    <module name="intellij.kotlin.base.resources" loading="embedded"/>
    <module name="intellij.kotlin.base.analysis" loading="embedded"/>
    <module name="intellij.kotlin.base.analysis.utils" loading="embedded"/>
    <module name="intellij.kotlin.base.codeInsight" loading="embedded"/>
    <module name="intellij.kotlin.base.codeInsight.minimal" loading="embedded"/>
    <module name="intellij.kotlin.codeInsight.api" loading="embedded"/>
    <module name="intellij.kotlin.codeInsight.descriptions" loading="embedded"/>
