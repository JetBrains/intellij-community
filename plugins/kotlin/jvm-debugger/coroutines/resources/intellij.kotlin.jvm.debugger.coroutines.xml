<idea-plugin visibility="public">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.java.debugger"/>
    <module name="intellij.java.debugger.impl"/>
    <module name="intellij.java.debugger.impl.shared"/>
    <module name="intellij.java.execution.impl"/>
    <module name="intellij.java.impl"/>
    <module name="intellij.java.psi"/>
    <module name="intellij.kotlin.base.analysis"/>
    <module name="intellij.kotlin.base.psi"/>
    <module name="intellij.kotlin.base.util"/>
    <module name="intellij.kotlin.codeInsight.utils"/>
    <module name="intellij.kotlin.jvm.debugger.base.util"/>
    <module name="intellij.kotlin.jvm.debugger.core"/>
    <module name="intellij.libraries.kotlinc.analysis.api"/>
    <module name="intellij.libraries.kotlinc.kotlin.compiler.common"/>
    <module name="intellij.libraries.asm"/>
    <module name="intellij.libraries.gson"/>
    <module name="intellij.libraries.kotlinx.serialization.core"/>
    <module name="intellij.libraries.kotlinx.serialization.json"/>
    <module name="intellij.libraries.maven.resolver.provider"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.debugger.impl"/>
    <module name="intellij.platform.debugger.impl.rpc"/>
    <module name="intellij.platform.debugger.impl.shared"/>
    <module name="intellij.platform.debugger.impl.ui"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.execution"/>
    <module name="intellij.platform.execution.impl"/>
    <module name="intellij.platform.externalSystem.impl"/>
    <module name="intellij.platform.ide"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.lang"/>
    <module name="intellij.platform.lang.core"/>
    <module name="intellij.platform.lang.impl"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.smRunner"/>
    <module name="intellij.platform.statistics"/>
    <module name="intellij.platform.threadDumpParser"/>
    <module name="intellij.platform.util.ui"/>
    <module name="kotlin.fir.frontend-independent"/>
  </dependencies>
  <!-- endregion -->
  <projectListeners>
    <listener class="org.jetbrains.kotlin.idea.debugger.coroutine.DisableCoroutineViewListener"
              topic="com.intellij.debugger.impl.DebuggerManagerListener"/>
  </projectListeners>
  <extensions defaultExtensionNs="com.intellij">
    <debugger.creationStackTraceProvider implementation="org.jetbrains.kotlin.idea.debugger.coroutine.CoroutineAsyncStackTraceProvider"/>
    <runConfigurationExtension implementation="org.jetbrains.kotlin.idea.debugger.coroutine.CoroutineDebugConfigurationExtension"/>
    <debugger.dumpItemsProvider implementation="org.jetbrains.kotlin.idea.debugger.coroutine.view.CoroutinesDumpAsyncProvider"/>
    <applicationService
            serviceInterface="org.jetbrains.kotlin.idea.debugger.core.StackFrameInterceptor"
            serviceImplementation="org.jetbrains.kotlin.idea.debugger.coroutine.CoroutineStackFrameInterceptor"/>
    <threadDumpItemFactory implementation="org.jetbrains.kotlin.idea.debugger.coroutine.view.CoroutineThreadDumpItemFactory"/>
  </extensions>
</idea-plugin>
