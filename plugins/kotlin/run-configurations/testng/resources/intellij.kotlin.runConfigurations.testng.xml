<idea-plugin>
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <plugin id="TestNG-J"/>
    <module name="intellij.java.execution.impl"/>
    <module name="intellij.java.psi"/>
    <module name="intellij.kotlin.base.analysis"/>
    <module name="intellij.kotlin.base.codeInsight"/>
    <module name="intellij.kotlin.base.facet"/>
    <module name="intellij.kotlin.base.plugin"/>
    <module name="intellij.kotlin.base.projectStructure"/>
    <module name="intellij.kotlin.base.util"/>
    <module name="intellij.kotlin.runConfigurations.jvm"/>
    <module name="intellij.libraries.kotlinc.analysis.api"/>
    <module name="intellij.libraries.kotlinc.kotlin.compiler.common"/>
    <module name="intellij.libraries.kotlinc.symbol.light.classes"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
    <module name="intellij.platform.execution"/>
    <module name="intellij.platform.execution.impl"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.lang"/>
    <module name="intellij.platform.smRunner"/>
    <module name="intellij.platform.statistics"/>
    <module name="intellij.platform.testRunner"/>
  </dependencies>
  <!-- endregion -->

  <extensions defaultExtensionNs="com.intellij">
    <runConfigurationProducer implementation="org.jetbrains.kotlin.idea.testng.KotlinTestNgConfigurationProducer"/>
    <testFramework implementation="org.jetbrains.kotlin.idea.testng.KotlinTestNGFramework" order="before testNG"/>
  </extensions>
  <extensions defaultExtensionNs="org.jetbrains.kotlin.idea">
    <testFrameworkProvider implementation="org.jetbrains.kotlin.idea.testng.TestNgKotlinTestFrameworkProvider"/>
  </extensions>
</idea-plugin>
