<idea-plugin visibility="internal">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <plugin id="JUnit"/>
    <module name="intellij.java.execution.impl"/>
    <module name="intellij.java.frontback.psi"/>
    <module name="intellij.java.psi"/>
    <module name="intellij.kotlin.base.analysis"/>
    <module name="intellij.kotlin.base.codeInsight"/>
    <module name="intellij.kotlin.base.facet"/>
    <module name="intellij.kotlin.base.indices"/>
    <module name="intellij.kotlin.base.plugin"/>
    <module name="intellij.kotlin.base.projectStructure"/>
    <module name="intellij.kotlin.base.util"/>
    <module name="intellij.kotlin.codeInsight.shared"/>
    <module name="intellij.kotlin.runConfigurations.jvm"/>
    <module name="intellij.libraries.kotlinc.analysis.api"/>
    <module name="intellij.libraries.kotlinc.kotlin.compiler.common"/>
    <module name="intellij.libraries.kotlinc.symbol.light.classes"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
    <module name="intellij.platform.execution"/>
    <module name="intellij.platform.execution.impl"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.indexing"/>
    <module name="intellij.platform.lang"/>
    <module name="intellij.platform.smRunner"/>
    <module name="intellij.platform.testRunner"/>
  </dependencies>
  <!-- endregion -->

  <extensions defaultExtensionNs="com.intellij">
    <runConfigurationProducer implementation="org.jetbrains.kotlin.idea.junit.KotlinJUnitRunConfigurationProducer" id="kotlinJUnit" order="after kotlinMain"/>
    <runConfigurationProducer implementation="org.jetbrains.kotlin.idea.junit.KotlinPatternConfigurationProducer" order="after kotlinJUnit"/>

    <testFramework implementation="org.jetbrains.kotlin.idea.junit.KotlinJUnit3Framework"
                   order="before junit3"/>
    <testFramework implementation="org.jetbrains.kotlin.idea.junit.KotlinJUnit4Framework"
                   order="before junit4"/>
    <testFramework implementation="org.jetbrains.kotlin.idea.junit.KotlinJUnit5Framework"
                   order="before junit5"/>
    <testFramework implementation="org.jetbrains.kotlin.idea.junit.KotlinJUnit6Framework"
                   order="before junit6"/>
  </extensions>

  <extensions defaultExtensionNs="org.jetbrains.kotlin.idea">
    <testFrameworkProvider implementation="org.jetbrains.kotlin.idea.junit.JunitKotlinTestFrameworkProvider"/>
  </extensions>
</idea-plugin>
