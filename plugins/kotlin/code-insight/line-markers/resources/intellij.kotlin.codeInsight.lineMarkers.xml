<idea-plugin>
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.java.psi"/>
    <module name="intellij.kotlin.base.analysis"/>
    <module name="intellij.kotlin.base.codeInsight"/>
    <module name="intellij.kotlin.base.facet"/>
    <module name="intellij.kotlin.base.indices"/>
    <module name="intellij.kotlin.base.platforms"/>
    <module name="intellij.kotlin.base.plugin"/>
    <module name="intellij.kotlin.base.projectStructure"/>
    <module name="intellij.kotlin.base.psi"/>
    <module name="intellij.kotlin.base.util"/>
    <module name="intellij.kotlin.codeInsight"/>
    <module name="intellij.kotlin.highlighting"/>
    <module name="intellij.kotlin.highlighting.minimal"/>
    <module name="intellij.kotlin.projectStructure"/>
    <module name="intellij.kotlin.references"/>
    <module name="intellij.kotlin.searching"/>
    <module name="intellij.libraries.kotlinc.analysis.api"/>
    <module name="intellij.libraries.kotlinc.kotlin.compiler.common"/>
    <module name="intellij.libraries.kotlinc.symbol.light.classes"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.execution.impl"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.indexing"/>
    <module name="intellij.platform.lang"/>
    <module name="intellij.platform.lang.impl"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.util.ui"/>
    <module name="kotlin.fir.frontend-independent"/>
  </dependencies>
  <!-- endregion -->

  <extensions defaultExtensionNs="com.intellij">

    <runLineMarkerContributor
            language="kotlin"
            implementationClass="org.jetbrains.kotlin.idea.codeInsight.lineMarkers.KotlinRunLineMarkerContributor"/>

    <codeInsight.lineMarkerProvider
            language="kotlin"
            implementationClass="org.jetbrains.kotlin.idea.codeInsight.lineMarkers.KotlinSuspendCallLineMarkerProvider"/>
    <codeInsight.lineMarkerProvider
            language="kotlin"
            implementationClass="org.jetbrains.kotlin.idea.codeInsight.lineMarkers.KotlinRecursiveCallLineMarkerProvider"/>

    <codeInsight.lineMarkerProvider
            language="kotlin"
            implementationClass="org.jetbrains.kotlin.idea.codeInsight.lineMarkers.KotlinLineMarkerProvider"/>
    <gotoTargetPresentationProvider implementation="org.jetbrains.kotlin.idea.codeInsight.lineMarkers.KotlinGotoTargetPresentationProvider"/>

    <codeInsight.lineMarkerProvider
            language="kotlin"
            implementationClass="org.jetbrains.kotlin.idea.codeInsight.lineMarkers.KotlinExpectActualLineMarkerProvider"/>
  </extensions>
</idea-plugin>
