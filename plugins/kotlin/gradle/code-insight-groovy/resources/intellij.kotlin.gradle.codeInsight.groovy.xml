<idea-plugin>
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <plugin id="org.intellij.groovy"/>
    <module name="intellij.kotlin.gradle.tooling"/>
    <module name="intellij.kotlin.projectWizard.idea"/>
    <module name="intellij.java.psi"/>
    <module name="intellij.kotlin.base.analysis"/>
    <module name="intellij.kotlin.base.codeInsight"/>
    <module name="intellij.kotlin.base.externalSystem"/>
    <module name="intellij.kotlin.base.facet"/>
    <module name="intellij.kotlin.base.platforms"/>
    <module name="intellij.kotlin.base.plugin"/>
    <module name="intellij.kotlin.base.projectStructure"/>
    <module name="intellij.kotlin.base.util"/>
    <module name="intellij.kotlin.gradle.codeInsight.common"/>
    <module name="intellij.kotlin.gradle.gradle"/>
    <module name="intellij.kotlin.migration"/>
    <module name="intellij.kotlin.projectConfiguration"/>
    <module name="intellij.kotlin.projectWizard.core"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.externalSystem"/>
    <module name="intellij.platform.externalSystem.impl"/>
    <module name="intellij.platform.ide"/>
    <module name="intellij.platform.projectModel"/>
    <module name="kotlin.gradle.gradle-java"/>
  </dependencies>
  <!-- endregion -->

  <extensions defaultExtensionNs="com.intellij">
    <localInspection
            implementationClass="org.jetbrains.kotlin.idea.groovy.inspections.DifferentKotlinGradleVersionInspection"
            groupBundle="messages.KotlinBundle" groupKey="group.names.kotlin"
            enabledByDefault="true"
            language="Groovy"
            hasStaticDescription="true"
            level="WARNING" key="inspection.different.kotlin.gradle.version.display.name" bundle="messages.KotlinBundle"/>

    <localInspection
            implementationClass="org.jetbrains.kotlin.idea.groovy.inspections.DifferentStdlibGradleVersionInspection"
            groupBundle="messages.KotlinBundle" groupKey="group.names.kotlin"
            enabledByDefault="true"
            language="Groovy"
            hasStaticDescription="true"
            level="WARNING" key="inspection.different.stdlib.gradle.version.display.name" bundle="messages.KotlinBundle"/>


    <copyPastePreProcessor implementation="org.jetbrains.kotlin.idea.groovy.GroovyLibraryDependenciesToBuildGradleKtsCopyPastePreprocessor"/>
  </extensions>
  <extensions defaultExtensionNs="org.jetbrains.kotlin.idea">
    <gradleBuildScriptSupport implementation="org.jetbrains.kotlin.idea.groovy.GroovyGradleBuildScriptSupport"/>
  </extensions>
</idea-plugin>
