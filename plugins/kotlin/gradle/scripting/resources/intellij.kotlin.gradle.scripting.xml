<idea-plugin>
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.kotlin.gradle.tooling"/>
    <module name="intellij.gradle"/>
    <module name="intellij.kotlin.gradle.gradle"/>
    <module name="intellij.gradle.java"/>
    <module name="intellij.java.frontback.psi.impl"/>
    <module name="intellij.java.psi"/>
    <module name="intellij.java.psi.impl"/>
    <module name="intellij.java.ui"/>
    <module name="intellij.kotlin.base.analysis.utils"/>
    <module name="intellij.kotlin.base.codeInsight"/>
    <module name="intellij.kotlin.base.plugin"/>
    <module name="intellij.kotlin.base.psi"/>
    <module name="intellij.kotlin.base.scripting"/>
    <module name="intellij.kotlin.base.scripting.shared"/>
    <module name="intellij.kotlin.base.util"/>
    <module name="intellij.kotlin.codeInsight.api"/>
    <module name="intellij.kotlin.codeInsight.shared"/>
    <module name="intellij.kotlin.codeInsight.utils"/>
    <module name="intellij.kotlin.gradle.tooling.impl"/>
    <module name="intellij.kotlin.preferences"/>
    <module name="intellij.kotlin.references"/>
    <module name="intellij.kotlin.uast.base"/>
    <module name="intellij.libraries.jetbrains.annotations"/>
    <module name="intellij.libraries.kotlin.tooling.core"/>
    <module name="intellij.libraries.kotlinc.analysis.api"/>
    <module name="intellij.libraries.kotlinc.kotlin.compiler.common"/>
    <module name="intellij.libraries.kotlinc.kotlin.script.runtime"/>
    <module name="intellij.libraries.kotlinc.kotlin.scripting.common"/>
    <module name="intellij.libraries.kotlinc.kotlin.scripting.compiler.impl"/>
    <module name="intellij.libraries.kotlinc.kotlin.scripting.jvm"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.execution"/>
    <module name="intellij.platform.externalSystem.impl"/>
    <module name="intellij.platform.ide"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.core.impl"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.indexing"/>
    <module name="intellij.platform.lang"/>
    <module name="intellij.platform.lang.core"/>
    <module name="intellij.platform.lang.impl"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.projectModel.impl"/>
    <module name="intellij.platform.util.ui"/>
    <module name="intellij.platform.workspace.jps"/>
    <module name="kotlin.gradle.gradle-java"/>
    <module name="kotlin.scripting"/>
  </dependencies>
  <!-- endregion -->

  <projectListeners>
    <listener
            class="org.jetbrains.kotlin.gradle.scripting.ProjectGradleSettingsListener"
            topic="org.jetbrains.plugins.gradle.settings.GradleSettingsListener"/>
  </projectListeners>

  <extensions defaultExtensionNs="org.jetbrains.plugins.gradle">
    <syncExtension implementation="org.jetbrains.kotlin.gradle.scripting.importing.KotlinDslScriptSyncExtension"/>
    <syncContributor implementation="org.jetbrains.kotlin.gradle.scripting.importing.KotlinDslBaseScriptSyncContributor"/>
    <syncContributor implementation="org.jetbrains.kotlin.gradle.scripting.importing.KotlinDslScriptSyncContributor"/>
  </extensions>

  <extensions defaultExtensionNs="com.intellij">
    <codeInsight.declarativeInlayProvider language="kotlin"
                                          implementationClass="org.jetbrains.kotlin.gradle.scripting.GradleVersionCatalogVersionInlayHintsProvider"
                                          isEnabledByDefault="true"
                                          group="OTHER_GROUP"
                                          providerId="gradle.version.catalog.version"
                                          bundle="messages.KotlinGradleScriptingBundle"
                                          nameKey="inlay.hints.version.catalog.dependencies.name"
                                          descriptionKey="inlay.hints.version.catalog.dependencies.description"/>

    <externalSystemTaskNotificationListener implementation="org.jetbrains.kotlin.gradle.scripting.importing.KotlinDslSyncListener"/>

    <editorNotificationProvider implementation="org.jetbrains.kotlin.gradle.scripting.GradleScriptNotificationProvider"/>
    <editorNotificationProvider implementation="org.jetbrains.kotlin.gradle.scripting.OpenAdvancedSettingsNotificationProvider"/>

    <completion.contributor language="kotlin"
                            id="GradleAccessorsFilterContributor"
                            order="first, before KotlinCompletionContributor"
                            implementationClass="org.jetbrains.kotlin.gradle.scripting.completion.GradleAccessorsFilterContributor"/>

    <localInspection implementationClass="org.jetbrains.kotlin.gradle.scripting.inspections.KotlinOptionsToCompilerOptionsInspection"
                     shortName="KotlinOptionsToCompilerOptions"
                     groupPathKey="group.path.kotlin.migration"
                     groupBundle="messages.KotlinBundle" groupKey="group.names.gradle"
                     enabledByDefault="true"
                     level="WARNING"
                     language="kotlin" editorAttributes="DEPRECATED_ATTRIBUTES"
                     key="inspection.kotlin.options.to.compiler.options.display.name" bundle="messages.KotlinBundle"/>
  </extensions>

  <extensions defaultExtensionNs="org.jetbrains.kotlin">
    <kotlinScriptFilter implementation="org.jetbrains.kotlin.gradle.scripting.GradleKotlinScriptProcessingFilter"/>
    <scriptDefinitionsProvider implementation="org.jetbrains.kotlin.gradle.scripting.definition.GradleScriptDefinitionsProvider"/>
  </extensions>

  <projectListeners>
    <listener class="org.jetbrains.kotlin.gradle.scripting.GradleWorkspaceModelListener"
              topic="com.intellij.platform.backend.workspace.WorkspaceModelChangeListener"/>
  </projectListeners>

  <applicationListeners>
    <listener class="org.jetbrains.kotlin.gradle.scripting.importing.KotlinDslGradleSyncListener"
              topic="org.jetbrains.plugins.gradle.service.syncAction.GradleSyncListener"/>
  </applicationListeners>

  <extensions defaultExtensionNs="org.jetbrains.plugins.gradle">
    <projectResolve implementation="org.jetbrains.kotlin.gradle.scripting.importing.KotlinDslScriptModelResolver" order="first"/>
  </extensions>

  <extensions defaultExtensionNs="org.jetbrains.kotlin">
    <scriptDiagnosticFixProvider implementation="org.jetbrains.kotlin.gradle.scripting.GradleScriptDiagnosticFixProvider"/>
  </extensions>

  <extensions defaultExtensionNs="com.intellij">
    <internalFileTemplate name="Kotlin Script Gradle"/>
  </extensions>

  <actions resource-bundle="messages.KotlinGradleScriptingBundle">
    <action id="Kotlin.Gradle.ShowDslLogs" class="org.jetbrains.kotlin.gradle.scripting.actions.ShowKotlinGradleDslLogs"/>
  </actions>
</idea-plugin>
