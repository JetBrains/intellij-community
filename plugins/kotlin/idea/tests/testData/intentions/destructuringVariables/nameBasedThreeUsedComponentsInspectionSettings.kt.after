// HIGHLIGHT: GENERIC_ERROR_OR_WARNING
// COMPILER_ARGUMENTS: -Xname-based-destructuring=complete

fun myFun(element: Options): State {
    (val autoscrollToSource1 = autoscrollToSource, val openDirectoriesWithSingleClick1 = openDirectoriesWithSingleClick, val autoscrollFromSource1 = autoscrollFromSource) = element
    return State().apply {
        autoscrollToSource = autoscrollToSource1
        openDirectoriesWithSingleClick = openDirectoriesWithSingleClick1
        autoscrollFromSource = autoscrollFromSource1
    }
}

data class Options(
    val autoscrollToSource: Boolean,
    val openDirectoriesWithSingleClick: Boolean,
    val autoscrollFromSource: Boolean,
)

class State {
    var autoscrollToSource: Boolean = false
    var openDirectoriesWithSingleClick: Boolean = false
    var autoscrollFromSource: Boolean = false
}
