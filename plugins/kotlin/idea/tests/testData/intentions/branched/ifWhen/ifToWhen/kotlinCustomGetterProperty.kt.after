// WITH_STDLIB
// KTIJ-38076
class Holder {
    val value: String
        get() = "computed"
}

fun test(h: Holder) {
    when {
        h.value == "a" -> {
            println("a")
        }
        h.value == "b" -> {
            println("b")
        }
        else -> {
            println("c")
        }
    }
}
