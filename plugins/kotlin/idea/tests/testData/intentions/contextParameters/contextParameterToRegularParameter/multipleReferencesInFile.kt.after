// COMPILER_ARGUMENTS: -Xcontext-parameters -Xcallable-references-to-contextual
class Ctx

fun fn(ctx: Ctx, x: Int): String = x.toString()

fun accept(f: (Int) -> String) {}

context(c: Ctx)
fun usage1() {
    val ref: (Int) -> String = { x -> fn(c, x) }
}

context(c: Ctx)
fun usage2() {
    accept({ x -> fn(c, x) })
}
