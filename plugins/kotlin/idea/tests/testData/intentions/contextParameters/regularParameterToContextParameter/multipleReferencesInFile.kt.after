// COMPILER_ARGUMENTS: -Xcontext-parameters -Xcallable-references-to-contextual
class Ctx

context(ctx: Ctx)
fun fn(x: Int): String = x.toString()

fun accept(f: (Ctx, Int) -> String) {}

fun usage1() {
    val ref: (Ctx, Int) -> String = { ctx, x -> context(ctx) { fn(x) } }
}

fun usage2() {
    accept({ ctx, x -> context(ctx) { fn(x) } })
}
