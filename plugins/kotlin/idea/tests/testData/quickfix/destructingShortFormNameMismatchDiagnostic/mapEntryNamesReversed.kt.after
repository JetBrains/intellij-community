// "Convert to positional destructuring syntax with square brackets" "true"
// COMPILER_ARGUMENTS: -Xname-based-destructuring=name-mismatch
// WITH_STDLIB

fun <K, V> putAll(from: Map<out K, V>) {
    for ([value, key] in from) {}
}

