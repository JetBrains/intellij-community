// "Convert to a full name-based destructuring form" "true"
// COMPILER_ARGUMENTS: -Xname-based-destructuring=complete
// WITH_STDLIB

data class Point(val x: Int, val y: Int)

fun test(p: Point): String {
    (var n: Number = x, var s = y) = p
    n = 2.5
    s++
    return "$n $s"
}

