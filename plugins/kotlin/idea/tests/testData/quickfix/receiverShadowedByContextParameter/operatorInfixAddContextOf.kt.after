// "Surround with 'with(contextOf<Foo>()) { ... }'" "true"
// COMPILER_ARGUMENTS: -Xcontext-parameters
// WITH_STDLIB
// API_VERSION: 2.2
// K2_ERROR: RECEIVER_SHADOWED_BY_CONTEXT_PARAMETER

class Bag

class Foo {
    infix fun String.inf(o: Int): String = ""
}

fun withFoo(f: context(Foo) () -> Unit) {}

fun Foo.test() {
    withFoo {
        with(contextOf<Foo>()) { "" inf 1 }
    }
}

