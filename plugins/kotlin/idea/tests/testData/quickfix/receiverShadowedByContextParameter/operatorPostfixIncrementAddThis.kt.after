// "Surround with 'with(this) { ... }'" "true"
// COMPILER_ARGUMENTS: -Xcontext-parameters
// K2_ERROR: RECEIVER_SHADOWED_BY_CONTEXT_PARAMETER

class Bag

class Foo {
    operator fun Bag.inc(): Bag = this
}

fun withFoo(f: context(Foo) () -> Unit) {}

fun Foo.test() {
    var b = Bag()
    withFoo {
        with(this) { b++ }
    }
}

