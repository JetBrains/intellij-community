// K2_ERROR: NO_CONTEXT_ARGUMENT
class Scope

class Vec {
    context(scope: Scope)
    operator fun plus(o: Vec): Vec = this

    context(scope: Scope)
    operator fun get(i: Int): Int = i
}

context(scope: Scope)
infix fun Int.combine(o: Int): Int = this + o

context(x: String)
fun shout(): String = x.uppercase()


context(_: String, _: Scope)
fun useG(a: Vec, b: Vec) {
    a + b
    a[0]
    1 combine 2
    1.combine(2)
    shout()
}

