class A(val b: Byte) {
    fun foo() {

    }

    <caret>override fun equals(other: Any?): Boolean {
        if (this === other) return true
        if (javaClass != other?.javaClass) return false

        other as A

        if (b != other.b) return false

        return true
    }

    override fun hashCode(): Int {
        return b.hashCode()
    }
}