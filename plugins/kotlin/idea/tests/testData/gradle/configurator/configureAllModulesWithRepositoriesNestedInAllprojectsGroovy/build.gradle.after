plugins {
    id 'java'
    id 'org.jetbrains.kotlin.jvm'
}
allprojects {
    buildscript {
        repositories {
            mavenCentral()
        }
    }
}
dependencies {
    testImplementation 'org.jetbrains.kotlin:kotlin-test'
}
repositories {
    mavenCentral()
}
kotlin {
    jvmToolchain(11)
}