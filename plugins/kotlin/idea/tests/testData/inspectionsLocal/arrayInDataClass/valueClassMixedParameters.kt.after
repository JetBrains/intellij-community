// WITH_STDLIB
// COMPILER_ARGUMENTS: -XXLanguage:+CustomEqualsInValueClasses
// DISABLE_K2_ERRORS

value class A(
    val a: IntArray,
    val b: Array<String>,
    val c: String,
    val d: Int,
) {
    override fun equals(other: Any?): Boolean {
        if (other !is A) return false
        if (d != other.d) return false
        if (!a.contentEquals(other.a)) return false
        if (!b.contentEquals(other.b)) return false
        if (c != other.c) return false

        return true
    }

    override fun hashCode(): Int {
        var result = d
        result = 31 * result + a.contentHashCode()
        result = 31 * result + b.contentHashCode()
        result = 31 * result + c.hashCode()
        return result
    }
}
