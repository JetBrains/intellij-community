<idea-plugin>
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.kotlin.base.util"/>
    <module name="intellij.kotlin.projectConfiguration"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.diff"/>
    <module name="intellij.platform.diff.impl"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.util.ui"/>
    <module name="intellij.platform.vcs"/>
    <module name="intellij.platform.vcs.impl"/>
    <module name="intellij.platform.vcs.impl.shared"/>
  </dependencies>
  <!-- endregion -->

  <extensions defaultExtensionNs="org.jetbrains.kotlin">
    <!--
      Automatic Kotlin configuration can show a VCS-style diff of files it changed.
      The Language Server reuses the core project-configuration module, but it does not ship VCS UI/implementation modules.
      Keeping the diff browser here preserves the full IDE action while allowing LS products to package the configurator without VCS.
    -->
    <configuratorChangesViewer implementation="org.jetbrains.kotlin.idea.configuration.ui.changes.KotlinConfiguratorChangesViewerImpl"/>
  </extensions>
</idea-plugin>
