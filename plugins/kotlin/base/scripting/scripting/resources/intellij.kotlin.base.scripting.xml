<idea-plugin visibility="internal">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.java.aetherDependencyResolver"/>
    <module name="intellij.java.execution.impl"/>
    <module name="intellij.java.frontback.psi"/>
    <module name="intellij.java.psi"/>
    <module name="intellij.java.psi.impl"/>
    <module name="intellij.java.ui"/>
    <module name="intellij.kotlin.base.codeInsight"/>
    <module name="intellij.kotlin.base.compilerConfiguration"/>
    <module name="intellij.kotlin.base.facet"/>
    <module name="intellij.kotlin.base.platforms"/>
    <module name="intellij.kotlin.base.plugin"/>
    <module name="intellij.kotlin.base.projectStructure"/>
    <module name="intellij.kotlin.base.psi"/>
    <module name="intellij.kotlin.base.util"/>
    <module name="intellij.kotlin.codeInsight"/>
    <module name="intellij.kotlin.codeInsight.api"/>
    <module name="intellij.kotlin.codeInsight.utils"/>
    <module name="intellij.kotlin.ide"/>
    <module name="intellij.kotlin.preferences"/>
    <module name="intellij.kotlin.runConfigurations.jvm"/>
    <module name="intellij.libraries.guava"/>
    <module name="intellij.libraries.jetbrains.annotations"/>
    <module name="intellij.libraries.kotlinc.analysis.api"/>
    <module name="intellij.libraries.kotlinc.analysis.api.platform.interface"/>
    <module name="intellij.libraries.kotlinc.kotlin.compiler.common"/>
    <module name="intellij.libraries.kotlinc.kotlin.jps.common"/>
    <module name="intellij.libraries.kotlinc.kotlin.script.runtime"/>
    <module name="intellij.libraries.kotlinc.kotlin.scripting.common"/>
    <module name="intellij.libraries.kotlinc.kotlin.scripting.compiler.impl"/>
    <module name="intellij.libraries.kotlinc.kotlin.scripting.dependencies"/>
    <module name="intellij.libraries.kotlinc.kotlin.scripting.jvm"/>
    <module name="intellij.libraries.kotlinx.coroutines.core"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.execution"/>
    <module name="intellij.platform.execution.impl"/>
    <module name="intellij.platform.externalSystem"/>
    <module name="intellij.platform.externalSystem.impl"/>
    <module name="intellij.platform.ide"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.core.impl"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.ide.progress"/>
    <module name="intellij.platform.indexing"/>
    <module name="intellij.platform.lang"/>
    <module name="intellij.platform.lang.core"/>
    <module name="intellij.platform.lang.impl"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.projectModel.impl"/>
    <module name="intellij.platform.refactoring"/>
    <module name="intellij.platform.statistics"/>
    <module name="intellij.platform.util.ui"/>
    <module name="intellij.platform.workspace.jps"/>
    <module name="kotlin.scripting"/>
  </dependencies>
  <!-- endregion -->
  <applicationListeners>
    <listener topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"
              class="org.jetbrains.kotlin.idea.core.script.highlighting.KotlinScriptEditorListener"/>
  </applicationListeners>

  <extensions defaultExtensionNs="com.intellij">
    <jarRepositoryAuthenticationDataProvider
        implementation="org.jetbrains.kotlin.idea.core.script.dependencies.ScriptRepositoryAuthenticationDataProvider"/>
    <localInspection implementationClass="org.jetbrains.kotlin.idea.core.script.inspections.KotlinScriptTemplateNotRegisteredInspection"
                     language="kotlin"
                     groupPath="Kotlin"
                     groupBundle="messages.InspectionsBundle" groupKey="group.names.probable.bugs"
                     enabledByDefault="true"
                     level="WARNING"
                     bundle="messages.KotlinBaseScriptingBundle" key="inspection.script.definition.not.registered.name"/>

    <localInspection implementationClass="org.jetbrains.kotlin.idea.core.script.inspections.MainKtsAnnotationUsageInPlainKtsInspection"
                     language="kotlin"
                     groupPath="Kotlin"
                     groupBundle="messages.InspectionsBundle" groupKey="group.names.probable.bugs"
                     enabledByDefault="true"
                     level="WARNING"
                     bundle="messages.KotlinBaseScriptingBundle" key="inspection.main.kts.annotation.in.plain.script.name"/>

    <notificationGroup id="KotlinScriptNotificationGroup"
                       displayType="BALLOON"
                       bundle="messages.KotlinBaseScriptingBundle"
                       key="notification.group.kotlin.script"/>

    <problemHighlightFilter implementation="org.jetbrains.kotlin.idea.core.script.highlighting.ScriptProblemHighlightFilter"/>

    <statistics.projectUsagesCollector implementation="org.jetbrains.kotlin.idea.core.script.statistics.KotlinScriptingUsageCollector"/>
    <statistics.counterUsagesCollector implementationClass="org.jetbrains.kotlin.idea.core.script.statistics.KotlinScriptingLifecycleCollector"/>

    <highlightVisitor implementation="org.jetbrains.kotlin.idea.core.script.highlighting.KotlinScriptHighlightingVisitor"/>

    <completion.contributor language="kotlin"
                            id="KotlinImportedScriptCompletionContributor"
                            order="first, before KotlinCompletionContributor"
                            implementationClass="org.jetbrains.kotlin.idea.core.script.codeInsight.KotlinImportedScriptCompletionContributor"/>
    <completion.confidence language="kotlin"
                           id="KotlinImportedScriptCompletionConfidence"
                           order="first, before kotlinSkipAutopopupInStrings"
                           implementationClass="org.jetbrains.kotlin.idea.core.script.codeInsight.KotlinImportedScriptCompletionConfidence"/>
    <psi.clsCustomNavigationPolicy
            implementation="org.jetbrains.kotlin.idea.core.script.modules.ScriptDependencySourceNavigationPolicyForJavaClasses"/>

    <useScopeEnlarger implementation="org.jetbrains.kotlin.idea.core.script.navigation.KotlinScriptUseScopeEnlarger"/>

    <resolveScopeProvider implementation="org.jetbrains.kotlin.idea.core.script.dependencies.KotlinScriptResolveScopeProvider"/>
    <resolveScopeProvider implementation="org.jetbrains.kotlin.idea.core.script.dependencies.ScriptDependenciesResolveScopeProvider"/>

    <codeInsight.daemonBoundCodeVisionProvider implementation="org.jetbrains.kotlin.idea.core.script.definitions.KotlinScriptDefinitionCodeVisionProvider"/>
    <config.codeVisionGroupSettingProvider implementation="org.jetbrains.kotlin.idea.core.script.definitions.KotlinScriptingGroupSettingProvider"/>

    <projectConfigurable groupId="language"
                         bundle="messages.KotlinBundle"
                         key="kotlin.scripting.configurable"
                         id="preferences.language.Kotlin.scripting"
                         instance="org.jetbrains.kotlin.idea.core.script.settings.KotlinScriptingSettingsConfigurable"
                         parentId="preferences.language.Kotlin"/>

    <editorNotificationProvider implementation="org.jetbrains.kotlin.idea.core.script.notifications.ScriptingSupportChecker"/>

    <projectService serviceInterface="org.jetbrains.kotlin.scripting.definitions.ScriptDefinitionProvider"
                    serviceImplementation="org.jetbrains.kotlin.idea.core.script.definitions.ScriptDefinitionProviderImpl"/>

    <workspaceModel.fileIndexContributor implementation="org.jetbrains.kotlin.idea.core.script.KotlinScriptWorkspaceFileIndexContributor"/>
    <projectView.externalLibraries.workspaceModelNodesProvider implementation="org.jetbrains.kotlin.idea.core.script.KotlinScriptExternalLibrariesNodesProvider"/>

    <vfs.asyncListener implementation="org.jetbrains.kotlin.idea.core.script.KotlinScriptFileListener"/>

    <configurationType implementation="org.jetbrains.kotlin.idea.core.script.script.KotlinStandaloneScriptRunConfigurationType"/>

    <runConfigurationProducer
            implementation="org.jetbrains.kotlin.idea.core.script.script.KotlinStandaloneScriptRunConfigurationProducer"/>

    <projectService serviceInterface="org.jetbrains.kotlin.scripting.definitions.ScriptConfigurationsProvider"
                    serviceImplementation="org.jetbrains.kotlin.idea.core.script.configurations.ScriptConfigurationsProviderImpl"/>

    <projectService serviceInterface="org.jetbrains.kotlin.scripting.resolve.ScriptReportSink"
                    serviceImplementation="org.jetbrains.kotlin.idea.core.script.notifications.KotlinScriptingReportsSink"/>

    <trafficLightRendererContributor
            implementation="org.jetbrains.kotlin.idea.core.script.highlighting.ScriptTrafficLightRendererContributor"/>

    <editorFloatingToolbarProvider
            implementation="org.jetbrains.kotlin.idea.core.script.ScriptConfigurationFloatingToolbarProvider"
            id="ScriptConfigurationFloatingToolbarProvider"/>
    <projectSettings service="org.jetbrains.kotlin.idea.core.script.settings.KotlinScriptingSettings"/>
    <registryKey
            key="kotlin.scripting.index.dependencies.sources"
            description="Index script dependencies sources eagerly (not deferred)"
            defaultValue="false"
            restartRequired="false"/>

    <fileType name="script-definition-marker" fieldName="INSTANCE"
              implementationClass="org.jetbrains.kotlin.idea.core.script.definition.ScriptDefinitionMarkerFileType"/>
  </extensions>

  <extensionPoints>
    <extensionPoint
            qualifiedName="org.jetbrains.kotlin.kotlinScriptFilter"
            interface="org.jetbrains.kotlin.idea.core.script.configurations.KotlinScriptProcessingFilter"
            area="IDEA_PROJECT"
            dynamic="true"/>

    <extensionPoint
            qualifiedName="org.jetbrains.kotlin.scriptEntityProvider"
            interface="org.jetbrains.kotlin.idea.core.script.modules.KotlinScriptEntityProvider"
            area="IDEA_PROJECT"
            dynamic="true"/>
    <extensionPoint
            qualifiedName="org.jetbrains.kotlin.scriptDefinitionsProvider"
            interface="kotlin.script.experimental.intellij.ScriptDefinitionsProvider"
            area="IDEA_PROJECT"
            dynamic="true"/>

    <extensionPoint
            qualifiedName="org.jetbrains.kotlin.scriptAfterRunCallbackProvider"
            interface="org.jetbrains.kotlin.idea.core.script.ScriptAfterRunCallbackProvider"
            area="IDEA_PROJECT"
            dynamic="true"/>

    <extensionPoint
            qualifiedName="org.jetbrains.kotlin.scripting.definitions.scriptDefinitionProvider"
            interface="org.jetbrains.kotlin.scripting.definitions.ScriptDefinitionProvider"
            area="IDEA_PROJECT"/>

    <extensionPoint
            qualifiedName="org.jetbrains.kotlin.scriptDiagnosticFixProvider"
            interface="org.jetbrains.kotlin.idea.core.script.ScriptDiagnosticFixProvider"
            dynamic="true"/>
  </extensionPoints>

  <extensions defaultExtensionNs="org.jetbrains.kotlin">
    <structureViewExtension
            implementation="org.jetbrains.kotlin.idea.core.script.structureView.KotlinScriptStructureViewFactoryExtension"
            order="first"/>

    <scriptDefinitionsProvider
            implementation="org.jetbrains.kotlin.idea.core.script.definitions.MainKtsScriptDefinitionsProvider"/>

    <scriptAfterRunCallbackProvider
            implementation="org.jetbrains.kotlin.idea.core.script.MainKtsAfterRunCallbackProvider"/>

    <scriptDefinitionsProvider implementation="org.jetbrains.kotlin.idea.core.script.definitions.DefinitionFromDependenciesProvider"/>
    <idea.base.platforms.targetPlatformDetector
            implementation="org.jetbrains.kotlin.idea.core.script.ScriptingTargetPlatformDetector"/>
  </extensions>

  <projectListeners>
    <listener class="org.jetbrains.kotlin.idea.core.script.configurations.KotlinScriptService$KotlinScriptWorkspaceModelListener"
              topic="com.intellij.platform.backend.workspace.WorkspaceModelChangeListener"/>
  </projectListeners>

  <actions resource-bundle="messages.KotlinBaseScriptingBundle">
    <group id="KotlinScripts.ReloadConfigurationActionGroup"/>
    <action id="ReloadScriptConfiguration"
            class="org.jetbrains.kotlin.idea.core.script.ReloadScriptConfigurationAction"
            icon="org.jetbrains.kotlin.idea.KotlinIcons.LOAD_SCRIPT_CONFIGURATION">
      <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift R"/>
      <add-to-group group-id="RunContextGroup"/>
      <add-to-group group-id="KotlinScripts.ReloadConfigurationActionGroup"/>
    </action>
  </actions>
  <actions resource-bundle="messages.KotlinBundle">
    <action id="Kotlin.NewScript" class="org.jetbrains.kotlin.idea.core.script.actions.NewKotlinScriptAction"
            icon="icons.KotlinBaseResourcesIcons.Kotlin_script">
      <add-to-group group-id="NewGroup" anchor="before" relative-to-action="NewWebDevelopment"/>
    </action>
  </actions>
</idea-plugin>
