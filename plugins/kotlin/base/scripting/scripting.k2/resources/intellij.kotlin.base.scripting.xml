<idea-plugin visibility="internal">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.java.frontback.psi"/>
    <module name="intellij.java.psi"/>
    <module name="intellij.java.ui"/>
    <module name="intellij.kotlin.base.compilerConfiguration"/>
    <module name="intellij.kotlin.base.facet"/>
    <module name="intellij.kotlin.base.platforms"/>
    <module name="intellij.kotlin.base.plugin"/>
    <module name="intellij.kotlin.base.projectStructure"/>
    <module name="intellij.kotlin.base.psi"/>
    <module name="intellij.kotlin.base.scripting.shared"/>
    <module name="intellij.kotlin.base.util"/>
    <module name="intellij.kotlin.codeInsight"/>
    <module name="intellij.kotlin.codeInsight.api"/>
    <module name="intellij.kotlin.codeInsight.utils"/>
    <module name="intellij.kotlin.preferences"/>
    <module name="intellij.libraries.guava"/>
    <module name="intellij.libraries.kotlinc.analysis.api"/>
    <module name="intellij.libraries.kotlinc.analysis.api.platform.interface"/>
    <module name="intellij.libraries.kotlinc.kotlin.compiler.common"/>
    <module name="intellij.libraries.kotlinx.coroutines.core"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.execution"/>
    <module name="intellij.platform.externalSystem.impl"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.core.impl"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.ide.progress"/>
    <module name="intellij.platform.lang"/>
    <module name="intellij.platform.lang.core"/>
    <module name="intellij.platform.lang.impl"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.projectModel.impl"/>
    <module name="intellij.platform.statistics"/>
    <module name="intellij.platform.util.ui"/>
  </dependencies>
  <!-- endregion -->
  <applicationListeners>
    <listener topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"
              class="org.jetbrains.kotlin.idea.core.script.k2.highlighting.KotlinScriptEditorListener"/>
  </applicationListeners>

  <extensions defaultExtensionNs="com.intellij">
    <localInspection implementationClass="org.jetbrains.kotlin.idea.core.script.k2.inspections.KotlinScriptTemplateNotRegisteredInspection"
                     language="kotlin"
                     groupPath="Kotlin"
                     groupBundle="messages.InspectionsBundle" groupKey="group.names.probable.bugs"
                     enabledByDefault="true"
                     level="WARNING"
                     bundle="messages.KotlinBaseScriptingBundle" key="inspection.script.definition.not.registered.name"/>

    <localInspection implementationClass="org.jetbrains.kotlin.idea.core.script.k2.inspections.MainKtsAnnotationUsageInPlainKtsInspection"
                     language="kotlin"
                     groupPath="Kotlin"
                     groupBundle="messages.InspectionsBundle" groupKey="group.names.probable.bugs"
                     enabledByDefault="true"
                     level="WARNING"
                     bundle="messages.KotlinBaseScriptingBundle" key="inspection.main.kts.annotation.in.plain.script.name"/>

    <notificationGroup id="KotlinScriptNotificationGroup"
                       displayType="BALLOON"
                       bundle="messages.KotlinBaseScriptingBundle"
                       key="notification.group.kotlin.script"/>

    <problemHighlightFilter implementation="org.jetbrains.kotlin.idea.core.script.k2.highlighting.ScriptProblemHighlightFilter"/>

    <statistics.projectUsagesCollector implementation="org.jetbrains.kotlin.idea.core.script.k2.statistics.KotlinScriptingUsageCollector"/>
    <statistics.counterUsagesCollector implementationClass="org.jetbrains.kotlin.idea.core.script.k2.statistics.KotlinScriptingLifecycleCollector"/>

    <highlightVisitor implementation="org.jetbrains.kotlin.idea.core.script.k2.highlighting.KotlinScriptHighlightingVisitor"/>

    <completion.contributor language="kotlin"
                            id="KotlinImportedScriptCompletionContributor"
                            order="first, before KotlinCompletionContributor"
                            implementationClass="org.jetbrains.kotlin.idea.core.script.k2.codeInsight.KotlinImportedScriptCompletionContributor"/>
    <completion.confidence language="kotlin"
                           id="KotlinImportedScriptCompletionConfidence"
                           order="first, before kotlinSkipAutopopupInStrings"
                           implementationClass="org.jetbrains.kotlin.idea.core.script.k2.codeInsight.KotlinImportedScriptCompletionConfidence"/>
    <psi.clsCustomNavigationPolicy
            implementation="org.jetbrains.kotlin.idea.core.script.k2.modules.ScriptDependencySourceNavigationPolicyForJavaClasses"/>

    <useScopeEnlarger implementation="org.jetbrains.kotlin.idea.core.script.k2.navigation.KotlinScriptUseScopeEnlarger"/>

    <resolveScopeProvider implementation="org.jetbrains.kotlin.idea.core.script.k2.dependencies.KotlinScriptResolveScopeProvider"/>
    <resolveScopeProvider implementation="org.jetbrains.kotlin.idea.core.script.k2.dependencies.ScriptDependenciesResolveScopeProvider"/>

    <codeInsight.daemonBoundCodeVisionProvider implementation="org.jetbrains.kotlin.idea.core.script.k2.definitions.KotlinScriptDefinitionCodeVisionProvider"/>
    <config.codeVisionGroupSettingProvider implementation="org.jetbrains.kotlin.idea.core.script.k2.definitions.KotlinScriptingGroupSettingProvider"/>

    <projectConfigurable groupId="language"
                         bundle="messages.KotlinBundle"
                         key="kotlin.scripting.configurable"
                         id="preferences.language.Kotlin.scripting"
                         instance="org.jetbrains.kotlin.idea.core.script.k2.settings.KotlinScriptingSettingsConfigurable"
                         parentId="preferences.language.Kotlin"/>

    <editorNotificationProvider implementation="org.jetbrains.kotlin.idea.core.script.k2.notifications.ScriptingSupportChecker"/>

    <projectService serviceInterface="org.jetbrains.kotlin.idea.core.script.v1.settings.KotlinScriptingSettings"
                    serviceImplementation="org.jetbrains.kotlin.idea.core.script.k2.settings.ScriptDefinitionSettingsStateComponent"/>

    <projectService serviceInterface="org.jetbrains.kotlin.scripting.definitions.ScriptDefinitionProvider"
                    serviceImplementation="org.jetbrains.kotlin.idea.core.script.k2.definitions.ScriptDefinitionProviderImpl"/>

    <workspaceModel.fileIndexContributor implementation="org.jetbrains.kotlin.idea.core.script.k2.KotlinScriptWorkspaceFileIndexContributor"/>
    <projectView.externalLibraries.workspaceModelNodesProvider implementation="org.jetbrains.kotlin.idea.core.script.k2.KotlinScriptExternalLibrariesNodesProvider"/>

    <vfs.asyncListener implementation="org.jetbrains.kotlin.idea.core.script.k2.KotlinScriptFileListener"/>

    <projectService serviceInterface="org.jetbrains.kotlin.scripting.definitions.ScriptConfigurationsProvider"
                    serviceImplementation="org.jetbrains.kotlin.idea.core.script.k2.configurations.ScriptConfigurationsProviderImpl"/>

    <projectService serviceInterface="org.jetbrains.kotlin.scripting.resolve.ScriptReportSink"
                    serviceImplementation="org.jetbrains.kotlin.idea.core.script.k2.notifications.KotlinScriptingReportsSink"/>

    <trafficLightRendererContributor
            implementation="org.jetbrains.kotlin.idea.core.script.k2.highlighting.ScriptTrafficLightRendererContributor"/>

    <editorFloatingToolbarProvider
            implementation="org.jetbrains.kotlin.idea.core.script.k2.ScriptConfigurationFloatingToolbarProvider"
            id="ScriptConfigurationFloatingToolbarProvider"/>
    <projectSettings service="org.jetbrains.kotlin.idea.core.script.k2.settings.ScriptDefinitionSettingsStateComponent"/>
  </extensions>

  <extensionPoints>
    <extensionPoint
            qualifiedName="org.jetbrains.kotlin.kotlinScriptFilter"
            interface="org.jetbrains.kotlin.idea.core.script.k2.configurations.KotlinScriptProcessingFilter"
            area="IDEA_PROJECT"
            dynamic="true"/>

    <extensionPoint
            qualifiedName="org.jetbrains.kotlin.scriptEntityProvider"
            interface="org.jetbrains.kotlin.idea.core.script.k2.modules.KotlinScriptEntityProvider"
            area="IDEA_PROJECT"
            dynamic="true"/>
  </extensionPoints>

  <extensions defaultExtensionNs="org.jetbrains.kotlin">
    <structureViewExtension
            implementation="org.jetbrains.kotlin.idea.core.script.k2.structureView.KotlinScriptStructureViewFactoryExtension"
            order="first"/>

    <scriptDefinitionsProvider
            implementation="org.jetbrains.kotlin.idea.core.script.k2.definitions.MainKtsScriptDefinitionsProvider"/>

    <scriptAfterRunCallbackProvider
            implementation="org.jetbrains.kotlin.idea.core.script.k2.MainKtsAfterRunCallbackProvider"/>

    <scriptAdditionalIdeaDependenciesProvider implementation="org.jetbrains.kotlin.idea.core.script.k2.dependencies.ModuleScriptAdditionalIdeaDependenciesProvider"/>

    <scriptDefinitionsProvider implementation="org.jetbrains.kotlin.idea.core.script.k2.definitions.DefinitionFromDependenciesProvider"/>
  </extensions>

  <projectListeners>
    <listener class="org.jetbrains.kotlin.idea.core.script.k2.configurations.KotlinScriptService$KotlinScriptWorkspaceModelListener"
              topic="com.intellij.platform.backend.workspace.WorkspaceModelChangeListener"/>
  </projectListeners>

  <actions resource-bundle="messages.KotlinBaseScriptingBundle">
    <group id="KotlinScripts.ReloadConfigurationActionGroup"/>
    <action id="ReloadScriptConfiguration"
            class="org.jetbrains.kotlin.idea.core.script.k2.ReloadScriptConfigurationAction"
            icon="org.jetbrains.kotlin.idea.KotlinIcons.LOAD_SCRIPT_CONFIGURATION">
      <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift R"/>
      <add-to-group group-id="RunContextGroup"/>
      <add-to-group group-id="KotlinScripts.ReloadConfigurationActionGroup"/>
    </action>
  </actions>
</idea-plugin>
