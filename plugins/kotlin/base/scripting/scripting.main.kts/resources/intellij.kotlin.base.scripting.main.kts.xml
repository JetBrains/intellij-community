<idea-plugin visibility="internal">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.java.frontback.psi"/>
    <module name="intellij.java.psi"/>
    <module name="intellij.kotlin.base.plugin"/>
    <module name="intellij.kotlin.base.psi"/>
    <module name="intellij.libraries.kotlinc.analysis.api"/>
    <module name="intellij.libraries.kotlinc.kotlin.compiler.common"/>
    <module name="intellij.libraries.kotlinc.kotlin.script.runtime"/>
    <module name="intellij.libraries.kotlinc.kotlin.scripting.common"/>
    <module name="intellij.libraries.kotlinc.kotlin.scripting.jvm"/>
    <module name="intellij.libraries.kotlinx.coroutines.core"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.execution"/>
    <module name="intellij.platform.externalSystem"/>
    <module name="intellij.platform.ide"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.core.impl"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.indexing"/>
    <module name="intellij.platform.lang"/>
    <module name="intellij.platform.lang.impl"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.util.ui"/>
    <module name="intellij.repository.search.completion"/>
  </dependencies>
  <!-- endregion -->

  <extensions defaultExtensionNs="com.intellij">
    <psi.implicitReferenceProvider
        implementation="org.jetbrains.kotlin.idea.core.script.k2.mainkts.codeInsight.MainKtsReferenceProvider"/>

    <completion.contributor language="kotlin"
                            id="MainKtsDependsOnCompletionContributor"
                            implementationClass="org.jetbrains.kotlin.idea.core.script.k2.mainkts.codeInsight.MainKtsDependsOnCompletionContributor"/>

    <completion.confidence language="kotlin"
                           id="MainKtsDependsOnCompletionConfidence"
                           order="before kotlinSkipAutopopupInStrings"
                           implementationClass="org.jetbrains.kotlin.idea.core.script.k2.mainkts.codeInsight.MainKtsDependsOnCompletionConfidence"/>
  </extensions>
</idea-plugin>
