<idea-plugin>
  <id>org.intellij.kotlinScripting</id>
  <name>Kotlin Scripting Support</name>
  <vendor>JetBrains</vendor>

  <description><![CDATA[
    Provides Kotlin JSR223 Scripting support to the IDE: kotlin scripting console and other features depending on Kotlin JSR223 Scripting.
    ]]></description>

  <!-- kotlin.jsr223 is included in kotlin plugin as well. To avoid conflicts, it's private and is not included in the common namespace -->
  <content>
    <module name="intellij.kotlin.jsr223" loading="embedded"/>
    <!-- several plugins include this wrapper. To avoid conflicts, it's private and is not included in the common namespace -->
    <module name="intellij.libraries.kotlinc.kotlin.script.runtime" loading="embedded"/>
    <module name="intellij.libraries.kotlinc.kotlin.scripting.jvm" loading="embedded"/>
  </content>
</idea-plugin>