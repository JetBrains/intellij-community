<idea-plugin>
  <id>org.intellij.kotlinScripting</id>
  <name>Kotlin Scripting Support</name>
  <vendor>JetBrains</vendor>

  <depends>com.intellij.modules.lang</depends>

  <description><![CDATA[
    Provides Kotlin JSR223 Scripting support to the IDE: kotlin scripting console and other features depending on Kotlin JSR223 Scripting.
    ]]></description>
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.libraries.kotlinc.kotlin.compiler.common"/>
    <module name="intellij.kotlin.jsr223"/>
    <module name="intellij.platform.core.impl"/>
  </dependencies>
  <!-- endregion -->
  <content namespace="jetbrains"/>
</idea-plugin>