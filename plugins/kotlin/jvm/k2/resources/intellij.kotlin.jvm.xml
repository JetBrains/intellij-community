<idea-plugin>
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.kotlin.base.scripting.shared"/>
    <module name="intellij.java.execution.impl"/>
    <module name="intellij.java.frontback.psi"/>
    <module name="intellij.java.frontback.psi.impl"/>
    <module name="intellij.java.psi"/>
    <module name="intellij.java.psi.impl"/>
    <module name="intellij.kotlin.base.codeInsight"/>
    <module name="intellij.kotlin.base.plugin"/>
    <module name="intellij.kotlin.base.projectStructure"/>
    <module name="intellij.kotlin.base.psi"/>
    <module name="intellij.kotlin.base.scripting"/>
    <module name="intellij.kotlin.base.scripting.scratch.definition"/>
    <module name="intellij.kotlin.base.statistics"/>
    <module name="intellij.kotlin.base.util"/>
    <module name="intellij.kotlin.codeInsight"/>
    <module name="intellij.kotlin.codeInsight.shared"/>
    <module name="intellij.kotlin.refactorings.base"/>
    <module name="intellij.libraries.kotlinc.analysis.api"/>
    <module name="intellij.libraries.kotlinc.analysis.api.platform.interface"/>
    <module name="intellij.libraries.kotlinc.kotlin.compiler.common"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.execution"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.ide.progress"/>
    <module name="intellij.platform.lang"/>
    <module name="intellij.platform.lang.core"/>
    <module name="intellij.platform.lang.impl"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.statistics"/>
    <module name="intellij.platform.util.coroutines"/>
    <module name="intellij.platform.util.ui"/>
    <module name="intellij.platform.vcs.impl"/>
    <module name="kotlin.jvm.shared"/>
    <module name="kotlin.scripting"/>
  </dependencies>
  <!-- endregion -->

  <extensions defaultExtensionNs="org.jetbrains.kotlin">
    <scriptDefinitionsProvider implementation="org.jetbrains.kotlin.idea.jvm.k2.scratch.KotlinScratchDefinitionProvider"/>
  </extensions>

  <extensions defaultExtensionNs="com.intellij">
    <scratch.creationHelper language="kotlin"
                            implementationClass="org.jetbrains.kotlin.idea.jvm.k2.scratch.KotlinScratchFileCreationHelper"/>

    <fileEditorProvider id="KtsScratchFileEditorProvider"
                        implementation="org.jetbrains.kotlin.idea.jvm.k2.scratch.KotlinScratchFileEditorProvider"/>

    <projectService serviceInterface="org.jetbrains.kotlin.idea.jvm.shared.scratch.ScratchFileAutoRunner"
                    serviceImplementation="org.jetbrains.kotlin.idea.jvm.k2.scratch.ScratchFileAutoRunnerK2"/>
  </extensions>

  <extensions defaultExtensionNs="com.intellij">
    <testDiffProvider language="kotlin" implementationClass="com.intellij.execution.testframework.JvmTestDiffProvider"/>
  </extensions>

  <resource-bundle>messages.KotlinBundle</resource-bundle>

  <actions>
    <action id="Kotlin.RunScratch" class="org.jetbrains.kotlin.idea.jvm.k2.scratch.RunKotlinScratchAction" icon="AllIcons.Actions.Execute">
      <keyboard-shortcut first-keystroke="control alt W" keymap="$default"/>
      <add-to-group group-id="RunContextPopupGroup" anchor="last"/>
    </action>
  </actions>

</idea-plugin>
