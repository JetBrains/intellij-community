<idea-plugin>
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.kotlin.base.facet"/>
    <module name="intellij.kotlin.base.plugin"/>
    <module name="intellij.kotlin.base.util"/>
    <module name="intellij.kotlin.projectConfiguration"/>
    <module name="intellij.libraries.kotlinx.datetime"/>
    <module name="intellij.libraries.kotlinx.serialization.core"/>
    <module name="intellij.libraries.kotlinx.serialization.json"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.externalSystem"/>
    <module name="intellij.platform.externalSystem.impl"/>
    <module name="intellij.platform.feedback"/>
    <module name="intellij.platform.ide"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.projectModel.impl"/>
    <module name="intellij.platform.statistics"/>
    <module name="intellij.platform.util.ui"/>
  </dependencies>
  <!-- endregion -->

  <projectListeners>
    <listener topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"
              class="org.jetbrains.kotlin.onboarding.KotlinNewUserTrackerFileListener"/>
  </projectListeners>

  <extensions defaultExtensionNs="com.intellij">
    <applicationService serviceImplementation="org.jetbrains.kotlin.onboarding.KotlinNewUserTracker"/>
    <feedback.idleFeedbackSurvey implementation="org.jetbrains.kotlin.onboarding.OnboardingFeedbackSurvey"/>

    <applicationSettings service="org.jetbrains.kotlin.onboarding.KotlinNewUserTracker"/>
  </extensions>
  <actions resource-bundle="messages.FeedbackBundle">
    <group id="OnboardingKotlin" internal="true">
      <action id="org.jetbrains.kotlin.onboarding.ShowKotlinOnboardingFeedbackDialogAction"
              class="org.jetbrains.kotlin.onboarding.ShowKotlinOnboardingFeedbackDialogAction" internal="true"/>
      <add-to-group group-id="FeedbackDialogGroup" anchor="last"/>
    </group>
  </actions>

</idea-plugin>