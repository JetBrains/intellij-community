<idea-plugin visibility="public">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.backend.baseline"/>
    <module name="intellij.platform.consoleView"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.eel.provider"/>
    <module name="intellij.platform.execution"/>
    <module name="intellij.platform.execution.impl"/>
    <module name="intellij.platform.ide"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.lang.impl"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.util.ui"/>
    <module name="intellij.sh.core"/>
  </dependencies>
  <!-- endregion -->

  <!-- The DevKit inspection does not know the backend baseline marker module, hence each suppression of SplitModeXmlApiUsage below. -->
  <extensions defaultExtensionNs="com.intellij">
    <configurationType implementation="com.intellij.sh.run.ShConfigurationType"/>
    <!--suppress SplitModeXmlApiUsage -->
    <runConfigurationProducer implementation="com.intellij.sh.run.ShRunConfigurationProducer"/>
    <!--suppress SplitModeXmlApiUsage -->
    <programRunner implementation="com.intellij.sh.run.ShRunProgramRunner"/>
    <!--suppress SplitModeXmlApiUsage -->
    <runConfigurationBeforeRunProviderDelegate implementation="com.intellij.sh.run.ShBeforeRunProviderDelegate"/>
  </extensions>
</idea-plugin>
