<idea-plugin visibility="internal">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <plugin id="com.jetbrains.performancePlugin"/>
    <module name="intellij.libraries.jackson"/>
    <module name="intellij.libraries.jackson.databind"/>
    <module name="intellij.libraries.jackson.module.kotlin"/>
    <module name="intellij.libraries.kotlinx.coroutines.core"/>
    <module name="intellij.libraries.opentelemetry"/>
    <module name="intellij.libraries.opentelemetry.semconv"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.backend"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.diagnostic.telemetry"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.execution"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.core.impl"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.indexing"/>
    <module name="intellij.platform.lang"/>
    <module name="intellij.platform.lang.impl"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.usageView"/>
    <module name="intellij.platform.usageView.impl"/>
    <module name="intellij.platform.util.ex"/>
    <module name="intellij.platform.util.ui"/>
  </dependencies>
  <!-- endregion -->
  <extensions defaultExtensionNs="com.jetbrains.performancePlugin">
    <commandProvider implementation="com.jetbrains.performancePlugin.backend.BackendCommandProvider"/>
  </extensions>

  <actions resource-bundle="messages.PerformanceTestingBundle">
    <group id="IndexingDiagnosticGroup">
      <action class="com.jetbrains.performancePlugin.actions.OpenIndexingDiagnosticsAction" id="performancePlugin.OpenIndexingDiagnosticsAction"/>
      <add-to-group group-id="HelpDiagnosticTools" anchor="after" relative-to-action="CollectTroubleshootingInformation"/>
    </group>
  </actions>
</idea-plugin>