# The Docker CLI of the UI-lane controller's Docker backend on a macOS host. The pin removes the manual install.
#
# No `BUILD` file may name `@air_docker_darwin_arm64`, `@air_docker_darwin_x86_64`,
# `@air_docker_buildx_darwin_arm64` or `@air_docker_buildx_darwin_x86_64`. The controller asks for the ones of its
# host arch with `bazel cquery` at its first Docker command (`require_available` in
# `crates/avl-vm/src/worker/docker.rs`), and that request is the only fetch. A label in `data` or `deps` puts the
# archive into the analysis of `//...`. Then every IDE sync on a Mac downloads it.
#
# The archives are the static CLI tarballs of `download.docker.com/mac/static/stable/<arch>/`, byte-identical,
# on the Space file mirror. The cache redirector does not serve `download.docker.com`, and
# `bazel_downloader.cfg` routes `packages.jetbrains.team/files/` through the redirector. The tarball holds the
# CLI only. The engine is the controller's Lima VM, see `lima.MODULE.bazel`.
#
# The static CLI has no plugin, and the image build needs BuildKit (`COPY --chmod`), so `docker-buildx` is pinned
# too: the GitHub release binaries `buildx-v<version>.darwin-<arm64|amd64>` of `docker/buildx`, byte-identical, on
# the same mirror. The controller names the plugin's directory in `cliPluginsExtraDirs` of its own `DOCKER_CONFIG`.
#
# To bump the pin:
#   1. Download `docker-<version>.tgz` for `aarch64` and `x86_64`. Docker publishes no checksum, so record the
#      sha256 of each download in the commit message.
#   2. Upload them as `docker-<version>-darwin-<arch>.tgz` to `docker/<version>/` in
#      https://jetbrains.team/p/ij/packages/files/intellij-build-dependencies.
#   3. Change `AIR_DOCKER_CLI_VERSION` and both `sha256` values below.
# To bump the plugin: download the two release binaries, check them against the release `checksums.txt`, upload them
# to `docker-buildx/v<version>/`, and change `AIR_DOCKER_BUILDX_VERSION` and both `sha256` values below.
# `the_pinned_docker_cli_meets_the_floor` and `the_pinned_buildx_meets_the_floor`
# (`crates/avl-vm/src/worker/docker/pin_tests.rs`) keep the pins at or above `MINIMUM_DOCKER_CLI_VERSION` and
# `MINIMUM_BUILDX_VERSION` in `crates/avl-vm/src/worker/docker.rs`.
AIR_DOCKER_CLI_VERSION = "29.8.1"

AIR_DOCKER_BUILDX_VERSION = "0.37.1"

air_docker_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

_AIR_DOCKER_BUILD_FILE = """
filegroup(
    name = "docker",
    srcs = ["docker/docker"],
    visibility = ["//visibility:public"],
)
"""

air_docker_archive(
    name = "air_docker_darwin_arm64",
    build_file_content = _AIR_DOCKER_BUILD_FILE,
    sha256 = "5a8f5604d7673202b2af925229d15eb4bbb86f7f542e4ac8cd7aa3f14cfa0f8b",
    url = "https://packages.jetbrains.team/files/p/ij/intellij-build-dependencies/docker/{v}/docker-{v}-darwin-aarch64.tgz".format(v = AIR_DOCKER_CLI_VERSION),
)

air_docker_archive(
    name = "air_docker_darwin_x86_64",
    build_file_content = _AIR_DOCKER_BUILD_FILE,
    sha256 = "de42b6bb38d0ea08333cdddc18b054d61d4c9f003b3616ae55d85ccea72c47c9",
    url = "https://packages.jetbrains.team/files/p/ij/intellij-build-dependencies/docker/{v}/docker-{v}-darwin-x86_64.tgz".format(v = AIR_DOCKER_CLI_VERSION),
)

air_docker_buildx_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

# The downloaded file is named `docker-buildx`, because the CLI finds a plugin by that file name.
air_docker_buildx_file(
    name = "air_docker_buildx_darwin_arm64",
    downloaded_file_path = "docker-buildx",
    executable = True,
    sha256 = "c3cbbc820d578b0aa8158dd62ef1af25a0c8a75ef53331dbe4e219471e1dbe8c",
    url = "https://packages.jetbrains.team/files/p/ij/intellij-build-dependencies/docker-buildx/v{v}/buildx-v{v}.darwin-arm64".format(v = AIR_DOCKER_BUILDX_VERSION),
)

air_docker_buildx_file(
    name = "air_docker_buildx_darwin_x86_64",
    downloaded_file_path = "docker-buildx",
    executable = True,
    sha256 = "7003a7bae20e7741283db1e23dafdcb957776a8be85de3f459630b1dd4c19db0",
    url = "https://packages.jetbrains.team/files/p/ij/intellij-build-dependencies/docker-buildx/v{v}/buildx-v{v}.darwin-amd64".format(v = AIR_DOCKER_BUILDX_VERSION),
)
