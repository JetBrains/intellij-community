# The BUILD file of the repository `avl_aom` (`avl.MODULE.bazel`): the libaom release that `avl.MODULE.bazel` pins. It
# replaces the cmake build of `crates/avl-aom-sys/build.rs`, so the recorder builds the AV1 encoder of its AVIF stills
# on every host without cmake. Highway, which the release carries, stays out.
#
# The source lists and the config headers are this directory's `sources.bzl` and `config/<arch>/`, which `update.mjs`
# generates with cmake. A C source with a SIMD flag compiles in a library of its own with that flag, as in the cmake
# build. The code picks the SIMD path at run time (`CONFIG_RUNTIME_CPU_DETECT`). The x86_64 assembly needs nasm, the
# module of the Bazel Central Registry.

load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@community//tools/vm/aom:sources.bzl", "AOM_ARM64_SOURCES", "AOM_SOURCES", "AOM_X86_64_ASM", "AOM_X86_64_SOURCES")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

_AARCH64 = "@platforms//cpu:aarch64"

_X86_64 = "@platforms//cpu:x86_64"

# The flags of the cmake build. `-O3` is upstream's optimization level, also in a test build of the recorder.
_COPTS = [
    "-std=c11",
    "-O3",
    "-DNDEBUG",
    "-D_FILE_OFFSET_BITS=64",
    "-D_LARGEFILE_SOURCE",
    "-flax-vector-conversions=none",
    "-w",
]

cc_library(
    name = "aom_headers",
    hdrs = glob([
        "aom/**/*.h",
        "aom_dsp/**/*.h",
        "aom_mem/**/*.h",
        "aom_ports/**/*.h",
        "aom_scale/**/*.h",
        "aom_util/**/*.h",
        "av1/**/*.h",
        "av1/**/*.inc",
        "common/**/*.h",
        "third_party/fastfeat/*.h",
        "third_party/vector/*.h",
    ]),
    includes = ["."],
    linkstatic = True,
    deps = ["@community//tools/vm/aom:config"],
)

write_file(
    name = "aom_config_c",
    out = "aom_config.c",
    content = [
        '#include "aom/aom_codec.h"',
        'static const char *const cfg = "community/tools/vm/aom";',
        "const char *aom_codec_build_config(void) { return cfg; }",
        "",
    ],
)

# One library per SIMD flag of an arch. A library of the other arch has no sources.
[
    cc_library(
        name = "aom_simd_arm64_%d" % index,
        srcs = select({
            _AARCH64: files,
            "//conditions:default": [],
        }),
        copts = _COPTS + flags.split(" ") if flags else _COPTS,
        linkstatic = True,
        deps = [":aom_headers"],
    )
    for index, (flags, files) in enumerate(AOM_ARM64_SOURCES.items())
]

[
    cc_library(
        name = "aom_simd_x86_64_%d" % index,
        srcs = select({
            _X86_64: files,
            "//conditions:default": [],
        }),
        copts = _COPTS + flags.split(" ") if flags else _COPTS,
        linkstatic = True,
        deps = [":aom_headers"],
    )
    for index, (flags, files) in enumerate(AOM_X86_64_SOURCES.items())
]

# `-I` takes a directory with its trailing slash. The assembly includes `config/aom_config.asm`, `x86inc.asm` and
# `x86_abi_support.asm` by these paths. ELF on Linux and Mach-O on an Intel Mac; `x86inc.asm` adds the Mach-O prefix.
[
    genrule(
        name = "aom_asm_" + source.replace("/", "_").replace(".asm", ""),
        srcs = [
            source,
            "aom_ports/x86_abi_support.asm",
            "third_party/x86inc/x86inc.asm",
            "@community//tools/vm/aom:config/x86_64/config/aom_config.asm",
        ],
        outs = [source.replace(".asm", ".o")],
        cmd = select({
                  "@platforms//os:macos": "FORMAT=macho64",
                  "//conditions:default": "FORMAT=elf64",
              }) + " && ROOT=$$(dirname $(execpath third_party/x86inc/x86inc.asm))/../.." +
              " && CONFIG=$$(dirname $(execpath @community//tools/vm/aom:config/x86_64/config/aom_config.asm))/.." +
              " && $(execpath @nasm//:nasm) -f $$FORMAT -I$$ROOT/ -I$$CONFIG/ -o $@ $(execpath %s)" % source,
        target_compatible_with = [_X86_64],
        tools = ["@nasm"],
    )
    for source in AOM_X86_64_ASM
]

cc_library(
    name = "aom",
    srcs = AOM_SOURCES + [":aom_config_c"] + select({
        _AARCH64: [],
        _X86_64: [":aom_asm_" + source.replace("/", "_").replace(".asm", "") for source in AOM_X86_64_ASM],
    }),
    hdrs = [
        "aom/aom.h",
        "aom/aom_codec.h",
        "aom/aom_encoder.h",
        "aom/aom_external_partition.h",
        "aom/aom_frame_buffer.h",
        "aom/aom_image.h",
        "aom/aom_integer.h",
        "aom/aomcx.h",
    ],
    copts = _COPTS,
    linkopts = select({
        "@platforms//os:linux": [
            "-lm",
            "-lpthread",
        ],
        "//conditions:default": [],
    }),
    linkstatic = True,
    visibility = ["//visibility:public"],
    deps = [":aom_headers"] + [":aom_simd_arm64_%d" % index for index in range(len(AOM_ARM64_SOURCES))] +
           [":aom_simd_x86_64_%d" % index for index in range(len(AOM_X86_64_SOURCES))],
)
