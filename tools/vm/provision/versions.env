PACKER_VERSION=1.16.0
PACKER_DARWIN_ARM64_SHA256=6530042cf8f8a1f96b6607cb22b5be298be53b400cd4a2c81ab8b946964fccda
# The Packer Tart plugin version is pinned in air-macos.pkr.hcl: `required_plugins` cannot read a variable.
# A floor. Everything the pipeline and the controller call - `tart exec`, `tart ip --resolver=agent`,
# `tart suspend`, `--root-disk-opts`, `--net-softnet`, `--suspendable` - has been present since this
# release, and newer Tarts are accepted. The Tart the scripts run is the controller's Bazel pin
# (`tart.MODULE.bazel` of the UI-lane controller), so the floor gates only a `TART_BIN` override.
# The floor's other home is `MINIMUM_VERSION` in crates/avl-vm/src/worker/tart.rs of the UI-lane controller.
# `the_image_pipeline_floor_is_the_controller_floor` fails when the two differ: raise both.
TART_MIN_VERSION=2.32.1

# The digest is the only pin that matters: downloads use the immutable digest reference, so a tag move
# cannot change the bytes that become the local base. The tag is kept purely so the pipeline can say
# whether upstream has published something newer - a warning, never a gate.
# The base's registry upload time is deliberately not pinned here. It is a property of the digest, so
# `resolve_base_upload_time` reads it from that digest's own manifest; a hand-maintained copy went on
# describing the previous base after the digest moved.
CIRRUS_BASE_TAG_REFERENCE=ghcr.io/cirruslabs/macos-tahoe-base:latest
CIRRUS_BASE_DIGEST=sha256:fa96c198dd980ae41914db6dd8621e6120d01ba0cd66754dcb4238e072a87444
CIRRUS_BASE_REFERENCE=ghcr.io/cirruslabs/macos-tahoe-base@${CIRRUS_BASE_DIGEST}
MACOS_VERSION=26.6.2
GOLDEN_SEAL_SCHEMA=1

# crates/avl-base/src/config.rs of the UI-lane controller embeds this file at compile time (`pins`):
# `GOLDEN_VM`, `NODE_MAJOR` and `DOCKER_BASE_IMAGE` reach the controller that way.
# The controller parses the file and does not source it, so keep to `NAME=value` lines and `${NAME}` references to
# a name declared above. The controller's own unit tests read every name it uses, so a rename here fails them.
# The Docker Linux worker's base (`--backend docker`): the Docker Hub image of Ubuntu 26.04, pinned by its
# multi-arch index digest for the same reason as the macOS base.
DOCKER_BASE_IMAGE=ubuntu:26.04@sha256:da6fc2be547864451aa253836dd926da33623312df4a9a243e35dc877c378a78

JUNIE_VERSION=2777.8
# The Node major of both guests: the Homebrew Node of the macOS golden, and the Node archive of the Docker image
# (`docker/Dockerfile` of the UI-lane controller). A controller unit test checks that the Dockerfile names it.
NODE_MAJOR=24

BASE_VM=air-cirrus-macos-26.6.2-base-fa96c198dd98
GOLDEN_VM=air-macos-26.6.2-golden
# Reserved public destination for the image after the Tart parity gate. The
# current workflow neither pulls nor pushes this reference; GOLDEN_VM remains
# the active local source.
JETBRAINS_GOLDEN_OCI_REFERENCE=registry.jetbrains.team/p/ij/containers-public/air-macos-ui-tests:26.6.2-v1
WORKER_CPU=8
