load("//tools/vm:avl.bzl", "avl_crate")

avl_crate(
    closure = True,
    # The option file templates of the lane context, which `lane::context` embeds (`include_str!`).
    compile_data = glob(["src/lane/context/options/*.xml"]),
    test_data = [":testdata"],
)

# The goldens of the lane services and the fixture agent jar. Public, because the Kotlin test of the Codex mock model
# holds its event stream to the same golden.
filegroup(
    name = "testdata",
    srcs = glob(["testdata/**"]),
    visibility = ["//visibility:public"],
)

# The sources with the names of the files of an Air performance part. The Kotlin bridge test `AirPerformanceContractTest`
# holds them to the names that the bridge writes, so a rename on one side fails the fast lane.
filegroup(
    name = "performance_contract_sources",
    srcs = [
        "src/lane/performance.rs",
        "src/lane/program.rs",
    ],
    visibility = ["//visibility:public"],
)
