# The crates of the Air UI-lane workspace (`Cargo.toml` next to this file). The repository name is short on
# purpose: every third-party crate becomes a repository `rules_rs++crate+avl__<crate>-<version>`, and long names
# break the Windows build on path length.
crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "avl",
    cargo_config = "//tools/vm:.cargo/config.toml",
    cargo_lock = "//tools/vm:Cargo.lock",
    cargo_toml = "//tools/vm:Cargo.toml",
    # Renders `[workspace.lints]` as `@avl//:workspace_cargo_lints` and names it as the `lint_config` of every
    # crate with `[lints] workspace = true`; `avl_crate` passes it on.
    generate_lint_config = True,
    # Every exec and target platform a build of these crates meets: rules_rs marks each crate incompatible on
    # any other (`RESOLVED_PLATFORMS` in `@avl//:defs.bzl`).
    platform_triples = [
        # An Apple silicon host, and `:vm-guest-agent-darwin-arm64`.
        "aarch64-apple-darwin",
        # An Intel Mac host.
        "x86_64-apple-darwin",
        # A Windows arm64 host (`vm`, `air-trace`, the recorder and the tests), `:clippy-windows-arm64`.
        "aarch64-pc-windows-msvc",
        # The Windows CI host (`vm`, `air-trace`, the recorder and the tests), `:clippy-windows-x86_64`.
        "x86_64-pc-windows-msvc",
        # `:vm-guest-agent-linux-arm64`, `:air-trace-record-linux-arm64` and `:clippy-linux-arm64`.
        "aarch64-unknown-linux-musl",
        # `:vm-guest-agent-linux-x86_64`, `:air-trace-record-linux-x86_64` and `:clippy-linux-x86_64`.
        "x86_64-unknown-linux-musl",
        # A Linux arm64 host.
        "aarch64-unknown-linux-gnu",
        # A Linux x86_64 host, such as a Linux CI agent.
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(crate, "avl")

crate.annotation(
    # The build script only runs `cc` over the vendored Cisco sources. A `cc_library` over the same files replaces it,
    # so no build script runs on any host. The BCR has no `openh264` module.
    additive_build_file = "//tools/vm:openh264-sys2.BUILD.bazel",
    crate = "openh264-sys2",
    extra_aliased_targets = {"openh264_native": "openh264_native"},
    gen_build_script = "off",
    deps = ["@avl//:openh264_native"],
)
crate.annotation(
    # The build script runs cmake over the vendored libaom. `@avl_aom//:aom` builds the same sources with Bazel, so no
    # build script runs on any host, and a Linux host needs no cmake and no nasm of its own.
    crate = "libaom-sys",
    gen_build_script = "off",
    deps = ["@avl_aom//:aom"],
)

# The x86_64 assembly of libaom. The archive comes from `mirror.bazel.build`, which the downloader config allows.
bazel_dep(name = "nasm", version = "2.16.03.bcr.2")

# libaom 3.11.0, the encoder of the recorder's AVIF stills: the `vendor` directory of the crate that `Cargo.lock` pins.
# The BCR module `aom` downloads from `storage.googleapis.com`, which the downloader config refuses, and it builds
# with rules_perl. The crate reaches Bazel through the crates.io mirror, and `aom/config/` holds what rules_perl would
# generate. Keep the version and the checksum equal to the `libaom-sys` entry of `Cargo.lock`, and run
# `aom/update.mjs` after a change of the version.
avl_aom_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

avl_aom_archive(
    name = "avl_aom",
    build_file = "//tools/vm/aom:aom.BUILD.bazel",
    sha256 = "7c4fce8aaf0c2d8534529b0698ed98ec1da8d35319588d20b0d79ce6446e4194",
    strip_prefix = "libaom-sys-0.17.2+libaom.3.11.0/vendor",
    type = "tar.gz",
    url = "https://static.crates.io/crates/libaom-sys/libaom-sys-0.17.2+libaom.3.11.0.crate",
)
