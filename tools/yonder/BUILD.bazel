# yonder, the Cargo workspace in this directory. `community/MODULE.bazel` reads `Cargo.toml`, `Cargo.lock` and
# `.cargo/config.toml` of this package to generate `@yonder`. `defs.bzl` declares each crate. The crate map is
# `README.md`.

load("//build/rust-tools:defs.bzl", "optimized_binary", "rust_lints_as_errors")

# The lint policy of every crate: `[workspace.lints]` of `Cargo.toml` as `@yonder` renders it, with every clippy
# warning an error.
rust_lints_as_errors(
    name = "lints",
    cargo = "@yonder//:workspace_cargo_lints",
    visibility = ["//visibility:public"],
)

# The cargo workspace, which `community/MODULE.bazel` reads.
exports_files([
    ".cargo/config.toml",
    "Cargo.lock",
    "Cargo.toml",
    # The patch of the ring build script for Windows AArch64, which `community/MODULE.bazel` applies.
    "ring-windows-clang-cl.patch",
])

# `yonderd`, the agent, one file, always optimized. `yonder prepare` copies it to the host.
optimized_binary(
    name = "yonderd",
    binary = "//tools/yonder/bins/yonderd",
    visibility = ["//visibility:public"],
)

# `yonder`, the client CLI, one file, always optimized. `bt --host` links the client crate instead.
optimized_binary(
    name = "yonder",
    binary = "//tools/yonder/bins/yonder",
    visibility = ["//visibility:public"],
)
