# jscpd, the copy-paste detector that `community/tools/jscpd.cmd` runs. The pin replaces the tool-wrapper download.
#
# Two readers fetch the archive of the host. The wrapper asks for the binary with `bazel cquery` at its first run of a
# version. The `jscpd_test` rule of `//tools/jscpd-test:defs.bzl` runs it for the copy-paste tests of the repository,
# such as `//plugins/air:air-duplicate-code_test`, `//plugins/code-findings:code-findings-duplicate-code_test` and
# `//build/rust-tools:duplicate-code_test`. A build of any of them fetches the archive of the host only. Put `@jscpd_*`
# or `//tools:jscpd` in no other `data` or `deps`.
#
# The archives are the GitHub release archives. `build/bazel_downloader.cfg` rewrites `github.com/` to the cache
# redirector, and the redirector serves `github.com/kucherenko/jscpd`. jscpd ships only `.tar.gz` archives for
# Windows. Bazel extracts them on every host, and `tool-wrapper.ps1` cannot.
#
# To bump the pin:
#   1. Change `JSCPD_VERSION` and copy the six `sha256` below from the `checksums.txt` of the release.
#   2. Run every `jscpd_test` target. A new version can find a clone that the old one did not.
# `jscpd.cmd` reads `JSCPD_VERSION` from this file, so the line keeps the shape `JSCPD_VERSION = "<version>"`.
JSCPD_VERSION = "5.4.3"

JSCPD_BASE_URL = "https://github.com/kucherenko/jscpd/releases/download"

# The host key of the `config_setting` in `BUILD.bazel`, to the release platform and the sha256 of its archive.
JSCPD_PLATFORMS = {
    "darwin_aarch64": ("darwin-arm64", "e119c4c5388118ad348a799c478589f7ad0fa707c0b7c819d6febc94f6f98522"),
    "darwin_x64": ("darwin-x64", "7e5b81a0b30f1d261bf9cd8d8e72be43f0ce55a54a9374f1111123bb29362362"),
    "linux_aarch64": ("linux-arm64-gnu", "221a62a254ab4cc42f26e076943ca79ecd311ae41646a76a08e4b790ed8c5fbe"),
    "linux_x64": ("linux-x64-gnu", "a19d719331b21a047a7537f982566dabcf6d6e5f51581c3b80d9c420979cc92c"),
    "windows_aarch64": ("windows-arm64-msvc", "ac398ff10ddee4c6f0e57dd82db32ab17a82a397238ea8fd56cbd419b8edb63b"),
    "windows_x64": ("windows-x64-msvc", "1e9416d179c54cbaf1f8854c764b2bc774a1a15850043160b7e58e63948ffb9d"),
}

jscpd_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# Each archive is flat: the executable and `LICENSE`. Only the executable is a target.
[
    jscpd_archive(
        name = "jscpd_%s" % host,
        build_file_content = """
filegroup(
    name = "binary",
    srcs = ["{binary}"],
    visibility = ["//visibility:public"],
)
""".format(binary = "jscpd.exe" if host.startswith("windows") else "jscpd"),
        sha256 = archive[1],
        url = "{base}/v{version}/jscpd-{platform}.tar.gz".format(
            base = JSCPD_BASE_URL,
            platform = archive[0],
            version = JSCPD_VERSION,
        ),
    )
    for host, archive in JSCPD_PLATFORMS.items()
]
