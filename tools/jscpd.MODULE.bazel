# jscpd, the copy-paste detector that `community/tools/jscpd.cmd` runs. The pin replaces the tool-wrapper download.
#
# Three readers fetch the archive of the host. The wrapper asks for the binary with `bazel cquery` at its first run of a
# version. The `jscpd_test` rule of `//tools/jscpd-test:defs.bzl` runs it for the copy-paste tests of the repository,
# such as `//plugins/air:air-duplicate-code_test` and `//build/rust-tools:duplicate-code_test`. The Code Findings test
# target `//plugins/code-findings/plugin:code-findings-plugin-tests_test` has `@community//tools:jscpd` in `data`, so
# `CodeFindingsDuplicateCodeTest` runs the pinned binary. A build of any of them fetches the archive of the host only.
# Put `@jscpd_*` or `//tools:jscpd` in no other `data` or `deps`.
#
# The archives are the GitHub release archives. `build/bazel_downloader.cfg` rewrites `github.com/` to the cache
# redirector, and the redirector serves `github.com/kucherenko/jscpd`. jscpd ships only `.tar.gz` archives for
# Windows. Bazel extracts them on every host, and `tool-wrapper.ps1` cannot.
#
# To bump the pin:
#   1. Change `JSCPD_VERSION` and copy the six `sha256` below from the `checksums.txt` of the release.
#   2. Run every `jscpd_test` target and `CodeFindingsDuplicateCodeTest`. A new version can find a clone that the old one
#      did not.
# `jscpd.cmd` reads `JSCPD_VERSION` from this file, so the line keeps the shape `JSCPD_VERSION = "<version>"`.
JSCPD_VERSION = "5.4.1"

JSCPD_BASE_URL = "https://github.com/kucherenko/jscpd/releases/download"

# The host key of the `config_setting` in `BUILD.bazel`, to the release platform and the sha256 of its archive.
JSCPD_PLATFORMS = {
    "darwin_aarch64": ("darwin-arm64", "48dedc0b8fa4f2900fc6ac8f06797e8eee7e36a8ab4f67f54b1ad25fd7ae103c"),
    "darwin_x64": ("darwin-x64", "101a9b9e0d1a4ffea7b9ac86d91003745ef471f00a8a2a921353a65647b5d12f"),
    "linux_aarch64": ("linux-arm64-gnu", "6f8ddab0aec0232d08a6aa0c36cddb435ddde2c24a447cc9afe603ac8556748c"),
    "linux_x64": ("linux-x64-gnu", "f2017a17de2a8d5708f8354c6e7223f82da3dc6489675bce543ba00d9d529468"),
    "windows_aarch64": ("windows-arm64-msvc", "d4c098cc3157f889748820ae6b926f0e577526957da53a57597b4f7f3cb4bdba"),
    "windows_x64": ("windows-x64-msvc", "69b3868a271a7f9c33c4dc0c82b861c290abc70cfb98ea59fba235a25776afe7"),
}

jscpd_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# Each archive is flat: the executable and `LICENSE`. Only the executable is a target.
[
    jscpd_archive(
        name = "jscpd_%s" % host,
        build_file_content = """
filegroup(
    name = "binary",
    srcs = ["{binary}"],
    visibility = ["//visibility:public"],
)
""".format(binary = "jscpd.exe" if host.startswith("windows") else "jscpd"),
        sha256 = archive[1],
        url = "{base}/v{version}/jscpd-{platform}.tar.gz".format(
            base = JSCPD_BASE_URL,
            platform = archive[0],
            version = JSCPD_VERSION,
        ),
    )
    for host, archive in JSCPD_PLATFORMS.items()
]
