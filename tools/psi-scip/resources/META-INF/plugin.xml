<idea-plugin>
  <id>com.intellij.tools.psiScip</id>
  <name>PSI SCIP Export</name>
  <category>Platform Development</category>
  <vendor>JetBrains</vendor>
  <description><![CDATA[
    <p>Writes a SCIP index of the source files of a project from PSI resolve, and the answer of the unused-declaration
    analysis for the Java and Kotlin declarations of a project, and what the IDE links to each message bundle key. All are
    reference oracles for code search benchmarks. Start them headless with the <code>psiScip</code>, <code>psiUnused</code>
    and <code>psiBundleRefs</code> commands.</p>
  ]]></description>

  <!-- the first content tag gives the plugin its namespace; the namespace makes the internal library modules visible -->
  <content namespace="jetbrains">
    <!-- The Go plugin may be absent, so keep this module optional.
         required-if-available can reject this plugin when Go is absent. -->
    <module name="intellij.tools.psiScip.go" loading="optional"/>
  </content>

  <dependencies>
    <plugin id="org.jetbrains.kotlin"/>
    <module name="intellij.java.analysis"/>
    <module name="intellij.java.analysis.impl"/>
    <module name="intellij.java.backend"/>
    <module name="intellij.java"/>
    <module name="intellij.java.frontback.psi"/>
    <module name="intellij.java.impl"/>
    <module name="intellij.java.psi"/>
    <module name="intellij.java.psi.impl"/>
    <module name="intellij.libraries.kotlinc.analysis.api"/>
    <module name="intellij.libraries.kotlinc.kotlin.compiler.common"/>
    <module name="intellij.libraries.kotlinc.symbol.light.classes"/>
    <module name="intellij.libraries.protobuf"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.analysis.impl"/>
    <module name="intellij.platform.backend.observation"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.core.impl"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.lang.core"/>
    <module name="intellij.platform.lang.impl"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.uast"/>
    <plugin id="com.intellij.properties"/>
    <module name="intellij.properties.backend.psi"/>
  </dependencies>

  <extensionPoints>
    <extensionPoint name="documentCollector" interface="com.intellij.tools.psiScip.ScipDocumentCollector" />
  </extensionPoints>

  <extensions defaultExtensionNs="com.intellij">
    <appStarter id="psiScip" implementation="com.intellij.tools.psiScip.PsiScipStarter" internal="true"/>
    <appStarter id="psiUnused" implementation="com.intellij.tools.psiScip.PsiUnusedStarter" internal="true"/>
    <appStarter id="psiBundleRefs" implementation="com.intellij.tools.psiScip.PsiBundleRefsStarter" internal="true"/>
  </extensions>

  <extensions defaultExtensionNs="com.intellij.tools.psiScip">
    <documentCollector implementation="com.intellij.tools.psiScip.JavaDocumentCollectorExtension"/>
    <documentCollector implementation="com.intellij.tools.psiScip.KotlinDocumentCollectorExtension"/>
  </extensions>
</idea-plugin>
