{
  "name": "@ij/docs-site",
  "private": true,
  "type": "module",
  "description": "The shared kernel of the architecture docs sites: the diagram grammar, the doc checks, the diagram renderer, the theme, and the styles. TypeScript sources, no build step.",
  "engines": {
    "node": ">=26.0.0"
  },
