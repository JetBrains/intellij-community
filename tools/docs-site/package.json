    "test:scripts": "node --test scripts/*.test.ts src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@shikijs/langs": "4.4.3",
    "@xyflow/react": "12.11.6",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.4.0",
    "lucide-react": "1.52.0",
    "marked": "18.0.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shiki": "4.4.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
