diff --git a/runner.bash.template b/runner.bash.template
index b9951e9..3bdf79e 100644
--- a/runner.bash.template
+++ b/runner.bash.template
@@ -4,6 +4,7 @@ set -euo pipefail
 
 BUILDIFIER_SHORT_PATH={BUILDIFIER_SHORT_PATH}
 ARGS={ARGS}
+EXCLUDE_ARGS={EXCLUDE_ARGS}
 WORKSPACE="{WORKSPACE}"
 
 function resolve_runfile() {
@@ -71,19 +72,48 @@ else
   fi
 fi
 
-# Run buildifier on all starlark files
-find . \
-  {EXCLUDE_PATTERNS} \
-  -type "${FIND_FILE_TYPE:-f}" \
-  \( -name '*.bzl' \
-    -o -name '*.sky' \
-    -o -name '*.star' \
-    -o -name '*.bazel' \
-    -o -name BUILD \
-    -o -name '*.BUILD' \
-    -o -name 'BUILD.*.oss' \
-    -o -name WORKSPACE \
-    -o -name WORKSPACE.bzlmod \
-    -o -name WORKSPACE.oss \
-    -o -name 'WORKSPACE.*.oss' \
-  \) -exec "$buildifier_short_path" "${ARGS[@]}" {} +
+# Starlark files, with excluded paths pruned
+find_expression=(
+  ${EXCLUDE_ARGS[@]+"${EXCLUDE_ARGS[@]}"}
+  -type "${FIND_FILE_TYPE:-f}"
+  \( -name '*.bzl'
+    -o -name '*.sky'
+    -o -name '*.star'
+    -o -name '*.bazel'
+    -o -name BUILD
+    -o -name '*.BUILD'
+    -o -name 'BUILD.*.oss'
+    -o -name WORKSPACE
+    -o -name WORKSPACE.bzlmod
+    -o -name WORKSPACE.oss
+    -o -name 'WORKSPACE.*.oss'
+  \) -print0
+)
+
+# Walking the workspace dominates the run time, so walk it in parallel: files
+# at depths 1 and 2 first, then the directories at depth 2, in batches of 16
+# per find to limit process spawns. Each walk writes its own list so that
+# concurrent output never interleaves.
+jobs=$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4)
+# More jobs do not walk faster
+if [[ $jobs -gt 8 ]]; then
+  jobs=8
+fi
+lists=$(mktemp -d)
+files=$(mktemp)
+trap 'rm -rf "$lists" "$files"' EXIT
+walk_status=0
+find . -maxdepth 2 "${find_expression[@]}" > "$lists/shallow" || walk_status=1
+# The inner script expands its own arguments: the find expression, then the roots
+# shellcheck disable=SC2016
+find . -maxdepth 2 ${EXCLUDE_ARGS[@]+"${EXCLUDE_ARGS[@]}"} -type d -path './*/*' -print0 |
+  LISTS="$lists" xargs -0 -n 16 -P "$jobs" bash -c \
+    'n=$1; shift; find "${@:n+1}" -mindepth 1 "${@:1:n}" > "$(mktemp "$LISTS/subtrees.XXXXXX")"' \
+    find-subtrees "${#find_expression[@]}" "${find_expression[@]}" || walk_status=1
+
+# Run buildifier on all starlark files, sorted for a stable output
+cat "$lists"/* | sort -z > "$files"
+if [[ -s "$files" ]] && ! xargs -0 "$buildifier_short_path" "${ARGS[@]}" < "$files"; then
+  exit 1
+fi
+exit "$walk_status"
