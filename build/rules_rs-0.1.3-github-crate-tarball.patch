Subject: [PATCH] feat: download the GitHub source archive instead of using `git`, and add `allow_git` to forbid `git`
---
diff --git a/rs/extensions.bzl b/rs/extensions.bzl
--- a/rs/extensions.bzl
+++ b/rs/extensions.bzl
@@ -697,6 +697,16 @@
     )
 
     return facts
+
+_ALLOW_GIT_ENV = "RULES_RS_ALLOW_GIT"
+
+def _allow_git(mctx, cfg):
+    value = cfg.allow_git
+    if value == "auto":
+        value = mctx.getenv(_ALLOW_GIT_ENV, "true")
+        if value not in ("true", "false"):
+            fail("%s must be \"true\" or \"false\", got \"%s\"" % (_ALLOW_GIT_ENV, value))
+    return value == "true"
 
 def _crate_impl(mctx):
     # TODO(zbarsky): Kick off `cargo` fetch early to mitigate https://github.com/bazelbuild/bazel/issues/26995
@@ -728,6 +738,7 @@
     parsed_cargo_configs = {}
     cargo_credentials_by_hub_name = {}
     annotations_by_hub_name = {}
+    allow_git_by_hub_name = {}
 
     for mod in mctx.modules:
         if not mod.tags.from_cargo:
@@ -764,6 +775,19 @@
                 if source:
                     package["source"] = source
             packages_by_hub_name[cfg.name] = parsed_packages
+            allow_git_by_hub_name[cfg.name] = _allow_git(mctx, cfg)
+
+            # Only a GitHub source can skip `git`. Check here, because a cached fact can skip the clone below.
+            if not allow_git_by_hub_name[cfg.name]:
+                for package in parsed_packages:
+                    source = package.get("source", "")
+                    if source.startswith("git+") and not source.startswith("git+https://github.com/"):
+                        fail("The crate %s %s of the hub `%s` comes from %s, which needs git, and `allow_git` is false." % (
+                            package["name"],
+                            package["version"],
+                            cfg.name,
+                            source,
+                        ))
 
             # Process git downloads first because they may require a followup download if the repo is a workspace,
             # so we want to enqueue them early so they don't get delayed by 1-shot registry downloads.
@@ -846,6 +870,7 @@
                 git_repo = git_repos.get(repo_name)
                 if not git_repo:
                     git_repo = {
+                        "allow_git": allow_git_by_hub_name[cfg.name],
                         "build_files": {},
                         "gen_binaries": {},
                         "commit": commit,
@@ -893,6 +918,7 @@
 
         git_cargo_workspace_repository(
             name = repo_name,
+            allow_git = git_repo["allow_git"],
             build_files = git_repo["build_files"],
             commit = git_repo["commit"],
             hub_name = git_repo["hub_name"],
@@ -942,6 +968,12 @@
         ),
         "cargo_lock": attr.label(),
         "cargo_config": attr.label(),
+        "allow_git": attr.string(
+            doc = "If \"false\", never run `git`. Fail when a crate from git needs it: a remote not on github.com, or a repository with a submodule. " +
+                  "\"auto\" reads `--repo_env=%s=true|false`, and is \"true\" when the variable is not set." % _ALLOW_GIT_ENV,
+            values = ["auto", "true", "false"],
+            default = "auto",
+        ),
         "generate_lint_config": attr.bool(
             doc = "If true, generate per-package Cargo lint configuration by reading workspace member manifests.",
             default = False,
diff --git a/rs/private/git_cargo_workspace_repository.bzl b/rs/private/git_cargo_workspace_repository.bzl
--- a/rs/private/git_cargo_workspace_repository.bzl
+++ b/rs/private/git_cargo_workspace_repository.bzl
@@ -60,8 +60,40 @@
         package_metadata_bazel_additive_build_file_content = cargo.bazel_metadata.get("additive_build_file_content", ""),
     ))
 
+_GITHUB_PREFIX = "https://github.com/"
+
+def _download_github_tarball(rctx):
+    """Downloads the crate sources from the GitHub archive.
+
+    Returns `False` when the caller must fall back to `git`.
+    """
+    repo_path = rctx.attr.remote.removeprefix(_GITHUB_PREFIX).removesuffix(".git")
+    rctx.download_and_extract(
+        url = "https://github.com/%s/archive/%s.tar.gz" % (repo_path, rctx.attr.commit),
+        type = "tar.gz",
+        stripPrefix = "%s-%s" % (repo_path.split("/")[-1], rctx.attr.commit),
+        canonical_id = "%s@%s" % (rctx.attr.remote, rctx.attr.commit),
+        # No checksum: GitHub does not promise a byte-stable archive. The commit pins the content.
+    )
+
+    # A GitHub archive holds no submodule.
+    if rctx.path(".gitmodules").exists:
+        return False
+
+    return True
+
 def _git_cargo_workspace_repository_impl(rctx):
-    git_repo(rctx, rctx.path("."))
+    # The archive goes through the Bazel downloader. The downloader retries a failed request and it
+    # obeys `--downloader_config`. The `git` subprocess does neither. `git_repo` deletes the
+    # directory first, so it can still take over after the archive lands.
+    if not rctx.attr.remote.startswith(_GITHUB_PREFIX) or not _download_github_tarball(rctx):
+        if not rctx.attr.allow_git:
+            fail("%s at %s needs git: the remote is not on github.com, or it uses a submodule. `allow_git` is false for the hub `%s`." % (
+                rctx.attr.remote,
+                rctx.attr.commit,
+                rctx.attr.hub_name,
+            ))
+        git_repo(rctx, rctx.path("."))
 
     patch(rctx)
     rctx.delete(rctx.path(".git"))
@@ -75,6 +107,7 @@
 git_cargo_workspace_repository = repository_rule(
     implementation = _git_cargo_workspace_repository_impl,
     attrs = {
+        "allow_git": attr.bool(default = True),
         "remote": attr.string(mandatory = True),
         "commit": attr.string(mandatory = True),
         "hub_name": attr.string(mandatory = True),
