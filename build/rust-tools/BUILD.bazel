# The shared configuration of the Rust tool workspaces. `README.md` is the spec: what every workspace has and the
# commands that check it. `lints.toml`, `rustfmt.toml` and `clippy.toml` are the sources, `sync.mjs` writes the copies,
# and `defs.bzl` holds the rules that apply them under Bazel.

load("@avl//:data.bzl", AVL = "DEP_DATA")
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@bt//:data.bzl", BT = "DEP_DATA")
load("@ddt//:data.bzl", DDT = "DEP_DATA")
load("//tools/jscpd-test:defs.bzl", "code_gates")
load(":defs.bzl", "COMMUNITY_WORKSPACE_LINTS", "NOT_ON_WINDOWS", "rust_lints_equal_check", "rust_tool_sources")

# `community/.bazelrc` gives `clippy.toml` to the Bazel clippy aspect as `@rules_rust//rust/settings:clippy.toml`.
exports_files(
    [
        "clippy.toml",
        "lints.toml",
    ],
    visibility = ["//visibility:public"],
)

# The lint tables of the community workspaces, as Bazel reads them. `//build/dev-dist-tools:lints_equal_check` of the
# ultimate root checks the same tables from that root. The test makes `bazel test --build_tests_only` analyze the check
# too.
rust_lints_equal_check(
    name = "lints_equal_check",
    targets = COMMUNITY_WORKSPACE_LINTS,
)

build_test(
    name = "lints_equal_test",
    targets = [":lints_equal_check"],
)

# The code gates of the community Rust tool workspaces. The copy-paste gate `duplicate-code_test` fails on each clone
# that jscpd finds with `.jscpd.json`. It reads the declared sources of every crate of the three crate hubs and of the
# two binaries without a hub, so Bazel caches it until a Rust file changes. A Windows host has no runfiles tree to scan.
# The unused gate `rust-tools-unused-code_test` reads the same directories in the checkout, without the generated
# libaom headers, and it is off by default (`//tools/jscpd-test:unused`).
code_gates(
    name = "rust-tools",
    size = "small",
    srcs = rust_tool_sources(AVL, BT, DDT) + [
        "//build/rust-tools/libtest-junit-wrapper:libtest-junit-wrapper_sources",
        "//build/rust-tools/libtest-junit-wrapper/e2e:e2e_sources",
        "//tools/jscpd-test:jscpd-test_sources",
    ],
    duplicate_code_name = "duplicate-code_test",
    guide = "See the copy-paste item of community/build/rust-tools/README.md.",
    jscpd_config = ".jscpd.json",
    junit_class = "community.build.rust-tools.DuplicateCode",
    target_compatible_with = NOT_ON_WINDOWS,
    unused_guide = "See the dead-code item of community/build/rust-tools/README.md.",
    unused_junit_class = "community.build.rust-tools.UnusedCode",
    unused_scopes = [
        "../../tools/bt",
        "../../tools/vm",
        "../dev-dist-tools",
        ".",
        "../../tools/jscpd-test",
        "!**/vm/aom/config/**",
    ],
)
