# Whether the community repository is loaded inside the ultimate repository. The `.bazelrc` of the ultimate repository sets it.
# The `ij_plugin` rule reads it to decide what to do with a content module that it cannot resolve.
bool_flag(
    name = "inside_ultimate",
    build_setting_default = False,
    visibility = ["//platform/build-scripts/bazel-rules:__pkg__"],
)

# Use this setting only to include the ultimate modules in the `content_modules` of a community plugin.
# Do not use it to select any other dependency on a target of the ultimate repository.
config_setting(
    name = "is_inside_ultimate",
    flag_values = {":inside_ultimate": "true"},
    visibility = ["//:__subpackages__"],
)

# The pinned build-dependency versions, for tests that gate shared dev-launch dependency sets
# against version bumps, and for a dev assembly that reads them out of a materialized project tree
# rather than a checkout (see `DependenciesProperties`).
exports_files(
    [
        "dependencies/dependencies.properties",
        "dependencies/runtime.properties",
    ],
    visibility = ["//visibility:public"],
)

# The product registry, for a dev assembly that materializes its own project tree.
exports_files(
    ["dev-build.json"],
    visibility = ["//visibility:public"],
)

# The distribution index, for the tests of the IDE Starter build server.
exports_files(
    ["dev-dist-distributions.json"],
    visibility = ["//tools/intellij.tools.ide.starter.build.server:__pkg__"],
)

jps_library_derivation_pipeline_test_suite(name = "jps_library_derivation_pipeline_test")

# The IDEA Community branding images, read from the checkout while a distribution is laid out (`imagesDirectoryPath`
# of `IdeaCommunityProperties`). Android Studio inherits them, so the ultimate `//build` package reads the group too.
filegroup(
    name = "idea_community_images",
    srcs = glob(["idea-community-images/**"]),
    visibility = ["//visibility:public"],
)

# Which product a `dev_dist_plugin_descriptor` action stamps for. One plugin's patched descriptor differs between two
# products in the product facts only, so the facts are a configuration and one descriptor target serves every product.
#
# The default states no product, and the leaf rule fails on it. A product's own set target transitions its descriptors
# onto the product's own `dev_dist_product_info`, so nothing a distribution reads ever sees this default.
dev_dist_product_info(name = "no_dev_dist_product_info")

label_flag(
    name = "dev_dist_product_info",
    build_setting_default = ":no_dev_dist_product_info",
    visibility = ["//visibility:public"],
)

# The JPS project model of the community half, named once: the targets-json generator and the project model tree
# of `intellij_dev_project_model_tree_community` read exactly this set.
filegroup(
    name = "community_project_model_files",
    srcs = [
        "//:jps_to_bazel_community_model_root_files",
    ] + ALL_COMMUNITY_IML_TARGETS + ALL_COMMUNITY_MODULE_DESCRIPTOR_TARGETS,
    visibility = ["//visibility:public"],
)

# == BAZEL_TARGETS_JSON_COMMUNITY
jps_to_bazel_targets_json(
    name = "community_bazel_targets_json",
    srcs = [":community_project_model_files"],
    jps_to_bazel_treat_kotlin_dev_version_as_snapshot = JPS_TO_BAZEL_TREAT_KOTLIN_DEV_VERSION_AS_SNAPSHOT,
    mode = "community",
    starlark_iml_targets = ALL_COMMUNITY_IML_TARGETS,
    starlark_library_targets = ALL_LIBRARY_COMMUNITY_TARGETS,
    starlark_plugin_distribution_targets = ALL_COMMUNITY_PLUGIN_DISTRIBUTION_TARGETS,
    starlark_production_targets = ALL_PRODUCTION_COMMUNITY_TARGETS,
    starlark_test_targets = ALL_TEST_COMMUNITY_TARGETS,
    tool = "@jps_to_bazel//:jps-to-bazel-targets-only",
    visibility = ["//visibility:public"],
)

[
    config_setting(
        name = "host_%s" % name,
        constraint_values = constraints,
        # The select axis of every per-platform dependency set, in this repository and in ultimate. A setting matches
        # the target platform of the configuration, which is the host platform unless `--platforms` states another.
        # No dev-dist rule transitions the target platform. A cross distribution passes its `target_platform` to the
        # tools only as the `--os` and `--arch` arguments, so a setting still matches the host there. Under an exec
        # transition, the target platform is the exec platform.
        visibility = ["//visibility:public"],
    )
    for name, constraints in {
        "darwin_aarch64": [
            "@platforms//os:macos",
            "@platforms//cpu:arm64",
        ],
        "darwin_x64": [
            "@platforms//os:macos",
            "@platforms//cpu:x86_64",
        ],
        "linux_aarch64": [
            "@platforms//os:linux",
            "@platforms//cpu:arm64",
        ],
        "linux_x64": [
            "@platforms//os:linux",
            "@platforms//cpu:x86_64",
        ],
        "windows_aarch64": [
            "@platforms//os:windows",
            "@platforms//cpu:arm64",
        ],
        "windows_x64": [
            "@platforms//os:windows",
            "@platforms//cpu:x86_64",
        ],
    }.items()
]

# Can't name the target 'installers' since it triggers elevation in Windows
java_binary(
    name = "i_build_target",
    add_opens = INTELLIJ_ADD_OPENS,
    data = ALL_COMMUNITY_TARGETS + [BAZEL_TARGETS_JSON_COMMUNITY],
    jvm_flags = [
        "-Dintellij.build.bazel.targets.json.file=$(rlocationpath %s)" % BAZEL_TARGETS_JSON_COMMUNITY,
    ],
    main_class = "OpenSourceCommunityInstallersBuildTarget",
    runtime_deps = [":build"],
)

java_binary(
    name = "run_tests_build_target",
    add_opens = INTELLIJ_ADD_OPENS,
    data = ALL_COMMUNITY_TARGETS + [BAZEL_TARGETS_JSON_COMMUNITY],
    jvm_flags = [
        # Reduce output which is not strictly required to run tests, but keep it discoverable
        # see org.jetbrains.intellij.build.telemetry.ConsoleSpanExporter.Companion.getTempFile
        "-Dintellij.build.console.exporter.to.temp.file=true",
        # Reduce output which is not strictly required to run tests, but keep it discoverable
        # it prints where all debug logs are in org.jetbrains.intellij.build.impl.logging.BuildMessagesImpl.setDebugLogPath
        "-Dintellij.build.console.messages.verbose=false",
        "-Dintellij.build.bazel.targets.json.file=$(rlocationpath %s)" % BAZEL_TARGETS_JSON_COMMUNITY,
    ],
    main_class = "CommunityRunTestsBuildTarget",
    runtime_deps = [":build"],
)

java_binary(
    name = "update_from_sources",
    add_opens = INTELLIJ_ADD_OPENS,
    data = ALL_COMMUNITY_TARGETS + [BAZEL_TARGETS_JSON_COMMUNITY],
    jvm_flags = [
        # Reduce output which is not strictly required to run tests, but keep it discoverable
        # see org.jetbrains.intellij.build.telemetry.ConsoleSpanExporter.Companion.getTempFile
        "-Dintellij.build.console.exporter.to.temp.file=true",
        # Reduce output which is not strictly required to run tests, but keep it discoverable
        # it prints where all debug logs are in org.jetbrains.intellij.build.impl.logging.BuildMessagesImpl.setDebugLogPath
        "-Dintellij.build.console.messages.verbose=false",
        "-Dintellij.build.bazel.targets.json.file=$(rlocationpath %s)" % BAZEL_TARGETS_JSON_COMMUNITY,
    ],
    main_class = "OpenSourceCommunityUpdateFromSourcesBuildTarget",
    runtime_deps = [":build"],
)

# The community binary of the dev-dist generator. It regenerates the dev-distribution files of the community half:
# `bazel run //build:dev_dist_generator` in `community/`, or `bazel run @community//build:dev_dist_generator` in the
# monorepo root. `--check` writes nothing and fails when a file is out of sync.
java_binary(
    name = "dev_dist_generator",
    add_opens = INTELLIJ_ADD_OPENS,
    data = ALL_COMMUNITY_TARGETS + [BAZEL_TARGETS_JSON_COMMUNITY],
    jvm_flags = [
        "-Dintellij.build.bazel.targets.json.file=$(rlocationpath %s)" % BAZEL_TARGETS_JSON_COMMUNITY,
    ],
    main_class = "com.intellij.platform.buildScripts.devDistGenerator.CommunityDevDistGenerator",
    runtime_deps = ["//platform/build-scripts/dev-dist-generator"],
)

# The tests of the community binary. The identity of the two renders of the community half is a test of the monorepo,
# `DevDistCommunityHalfIdentityTest` in `//build:ultimate-build-tests_test`, because only the monorepo has both JSON files.
jps_test(
    name = "dev_dist_generator_identity_test",
    data = ALL_COMMUNITY_TARGETS + [BAZEL_TARGETS_JSON_COMMUNITY],
    env = {
        "JB_TEST_JUNIT5_FILTERS": "include-classname=com.intellij.platform.buildScripts.devDistGenerator.CommunityDevDistGeneratorTest",
    },
    jvm_flags = [
        "-Dintellij.build.bazel.targets.json.file=$(rlocationpath %s)" % BAZEL_TARGETS_JSON_COMMUNITY,
    ],
    runtime_deps = ["//platform/build-scripts/dev-dist-generator:buildScripts-devDistGenerator-tests_test_lib"],
)

java_binary(
    name = "report_junit_xml_test_metadata_build_target",
    main_class = "com.intellij.platform.testFramework.teamCity.BazelJUnitXmlTestMetadataReporter",
    runtime_deps = ["//platform/testFramework/teamCity"],
)

java_binary(
    name = "jewel_standalone_maven_artifacts",
    add_opens = INTELLIJ_ADD_OPENS,
    data = ALL_PRODUCTION_COMMUNITY_TARGETS + ALL_LIBRARY_COMMUNITY_TARGETS + [BAZEL_TARGETS_JSON_COMMUNITY],
    jvm_flags = [
        "-Dintellij.build.bazel.targets.json.file=$(rlocationpath %s)" % BAZEL_TARGETS_JSON_COMMUNITY,
    ],
    main_class = "JewelMavenArtifactsBuildTarget",
    runtime_deps = [":build"],
)

java_binary(
    name = "standalone_maven_artifacts",
    add_opens = INTELLIJ_ADD_OPENS,
    data = ALL_PRODUCTION_COMMUNITY_TARGETS + ALL_LIBRARY_COMMUNITY_TARGETS + [BAZEL_TARGETS_JSON_COMMUNITY],
    jvm_flags = [
        "-Dintellij.build.bazel.targets.json.file=$(rlocationpath %s)" % BAZEL_TARGETS_JSON_COMMUNITY,
    ],
