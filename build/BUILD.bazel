# Turns the `lib/` jars that `jvm_library` packs into a distribution component. It evaluates no layout and reads no
# project model.
alias(
    name = "dev_dist_packed_jars",
    actual = "//platform/build-scripts/bazel-rules:dev_dist_collector",
    visibility = ["//visibility:public"],
)

alias(
    name = "dev_dist_composer",
    actual = "//platform/build-scripts/bazel-rules:dev_dist_composer",
    visibility = ["//visibility:public"],
)

# The platform set of every community split product. The distribution of every community run configuration comes from
# `dev_server_run_configurations()` below and reads these components. `DEV_DIST_PRODUCTS` in
# `build/dev_dist_products.bzl` is the one list of the products.
#
# Public: a distribution of a community product in the ultimate checkout composes these components too, see
# `DEV_DIST_COMMUNITY_PRODUCTS` of the ultimate plan.
[
    intellij_dev_platform_set_community(
        product = product,
        visibility = ["//visibility:public"],
    )
    for product in DEV_DIST_PRODUCTS
]

# The names of the launchers before they became rows of `dev_server_run_configurations.bzl`.
alias(
    name = "idea_community_devkit",
    actual = ":idea_with_compose_dev_build",
)

alias(
    name = "android_studio",
    actual = ":android_studio_dev_build",
)

# The plain `Idea` run configuration on the split path, `:idea_community`. The first test checks that the launch-only
# distribution states its home. The second test checks that the row builds.
dev_dist_local_launch_test(
    name = "idea_community_local_launch_test",
    target_under_test = ":idea_community_dist_launch",
)

intellij_dev_launch_assembles_test(
    name = "idea_community_assembles_test",
    rows = [":idea_community"],
)

# The `AndroidStudio` run configuration on the split path, `:android_studio_dev_build`: the same pair of checks.
dev_dist_local_launch_test(
    name = "android_studio_dev_build_local_launch_test",
    target_under_test = ":android_studio_dev_build_dist_launch",
)

intellij_dev_launch_assembles_test(
    name = "android_studio_dev_build_assembles_test",
    rows = [":android_studio_dev_build"],
)

