# What the JPS-to-Bazel converter reads besides the project model: which plugins get a content leaf at all, the layout
# exclusions that make a module output unpackable, and the candidacy a community-only checkout cannot fold for itself.
# A hermetic run that does not materialize them is not the checkout run - it silently decides all three questions the
# other way - so both targets-json generators name this group.
#
# The population is the one that decides whether a plugin gets a leaf. Without it a hermetic run states content for no
# plugin, `contentTarget` empties for every one of them, and the dev-distribution plan then declares one input less per
# plugin than its assembly reads.
filegroup(
    name = "dev_dist_plugin_content_tables",
    srcs = [
        "dev_dist_plugin_content_candidate_overrides.txt",
        "dev_dist_plugin_content_population.txt",
        "dev_dist_plugin_content_vetoes.txt",
    ],
    visibility = ["//visibility:public"],
)

# What the converter reads to decide which plugins get a `dev_dist_plugin_descriptor` target. A hermetic run that does
# not materialize it emits no such target at all, so both targets-json generators name this group.
filegroup(
    name = "dev_dist_plugin_descriptor_tables",
    srcs = ["dev_dist_plugin_descriptor_population.txt"],
    visibility = ["//visibility:public"],
)

# Which product a `dev_dist_plugin_descriptor` action stamps for. One plugin's patched descriptor differs between two
# products in three scalars only, so the scalars are a configuration and one descriptor target serves every product.
#
# The default states no product, and the leaf rule fails on it. A product's own set target transitions its descriptors
# onto the product's own `dev_dist_product_info`, so nothing a distribution reads ever sees this default.
dev_dist_product_info(name = "no_dev_dist_product_info")

label_flag(
    name = "dev_dist_product_info",
    build_setting_default = ":no_dev_dist_product_info",
    visibility = ["//visibility:public"],
)

