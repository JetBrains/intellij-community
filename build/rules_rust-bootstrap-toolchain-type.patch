 def find_toolchain(ctx):
     """Finds the first rust toolchain that is configured.
 
+    A `*_without_process_wrapper` rule asks for `//rust:bootstrap_toolchain_type`, and gets that toolchain. All other
+    rules get the `//rust:toolchain_type` toolchain.
+
     Args:
         ctx (ctx): The ctx object for the current target.
 
     Returns:
         rust_toolchain: A Rust toolchain context.
     """
+    if _BOOTSTRAP_TOOLCHAIN_TYPE in ctx.toolchains:
+        return ctx.toolchains[_BOOTSTRAP_TOOLCHAIN_TYPE]
     return ctx.toolchains[Label("//rust:toolchain_type")]
 
