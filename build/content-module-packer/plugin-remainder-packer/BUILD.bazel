load("@rules_go//go:def.bzl", "go_binary", "go_test")

go_binary(
    name = "plugin-remainder-packer",
    srcs = ["main.go"],
    gc_linkopts = [
        "-s",
        "-w",
    ],
    importpath = "jetbrains.com/content-module-packer/plugin-remainder-packer",
    pure = "on",
    visibility = ["//visibility:public"],
    deps = [
        "//build/content-module-packer/internal/planfile",
        "//build/content-module-packer/internal/pluginpack",
    ],
)

go_test(
    name = "plugin-remainder-packer_test",
    srcs = [
        "main.go",
        "main_test.go",
    ],
    pure = "on",
    deps = [
        "//build/content-module-packer/internal/planfile",
        "//build/content-module-packer/internal/pluginclasspath",
        "//build/content-module-packer/internal/pluginpack",
    ],
)
