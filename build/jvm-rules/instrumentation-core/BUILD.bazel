load("@rules_java//java:defs.bzl", "java_library")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")

pkg_files(
    name = "files_to_zip",
    srcs = glob(
        ["**"],
        exclude = ["*.iml"],
    ),
    prefix = "instrumentation-core",
    strip_prefix = strip_prefix.from_pkg(),
    visibility = ["//visibility:public"],
)

# The NotNull and the threading model instrumenters with their class finder and class writer. The library holds no
# worker code, so a host other than the jvm-inc-builder worker can run the instrumenters.
java_library(
    name = "instrumentation-core",
    srcs = glob(["src/**/*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//:annotations_import",
        "//:asm-all_import",
    ],
)

exports_files(
    ["instrumentation-core.iml"],
    visibility = ["//visibility:public"],
)

