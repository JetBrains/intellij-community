[
    http_file(
        name = "%s_http" % name,
        downloaded_file_path = path.rpartition("/")[2],
        sha256 = sha256,
        url = "https://cache-redirector.jetbrains.com/repo1.maven.org/maven2/%s" % path,
    )
    for name, (path, sha256) in WASMJS_TEST_HARNESS_JARS.items()
]

