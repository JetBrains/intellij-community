# The javac options of every target that sets none, in every workspace: the default of the default-javac-opts
# flag, which no root redirects. The JPS backend never runs ErrorProne, so disable it here for behavior parity:
# the golden behavior is "whatever compiles under --config=jps compiles under --config=bta". No `warn` here:
# rules_kotlin derives the javac warning mode from the effective Kotlin `warn` option when the javac options set
# none, matching the JPS worker's single WARN flag driving both compilers.
kt_javac_options(
    name = "default-javac-opts-value",
    no_proc = True,
    visibility = ["//visibility:public"],
    x_ep_disable_all_checks = True,
)

# The default of the default-kotlinc-opts flag: the kotlinc options of every target that sets none, in a build
# without the flag, the standalone workspace and the test workspaces. They are the defaults of the generated
# modules (create_kotlinc_options in community/build/compiler-options.bzl), which a root build selects through
# the flag (community/common.bazelrc). The language and api version are not set here: a target without options
# takes them from the toolchain attributes.
kt_kotlinc_options(
    name = "default-kotlinc-opts-value",
    jvm_default = "no-compatibility",
    jvm_target = "25",
    progressive = True,
    visibility = ["//visibility:public"],
    warn = "off",
    x_lambdas = "indy",
    x_sam_conversions = "indy",
    x_xlanguage = [
        "+AllowEagerSupertypeAccessibilityChecks",
        "-WrapContinuationForTailCallFunctions",
    ],
)

label_flag(
    name = "default-javac-opts",
    build_setting_default = ":default-javac-opts-value",
    visibility = ["//visibility:public"],
)

