# Java toolchain for `java_proto_library` with the prebuilt runtime jar above.
# Without it, resolution falls back to `@protobuf//java/core:toolchain`, which
# compiles the runtime from source. Registered in MODULE.bazel.
proto_lang_toolchain(
    name = "protoc_java_toolchain",
    command_line = "--java_out=%s",
    progress_message = "Generating Java proto_library %{label}",
    runtime = ":protobuf_java",
    toolchain_type = "@protobuf//bazel/private:java_toolchain_type",
    visibility = ["//visibility:public"],
)

# The protobuf code of the monorepo takes a prebuilt protobuf-java runtime, not the protobuf module's source build, that
# runtime is the release of the protobuf module the rules_kotlin builder compiles its own code against, and protoc is
# never built from source: the guard fails the analysis otherwise, in the target configuration and, through
# its exec_check instance, in the exec configuration where tools and their protos are built. Build it to check
# the toolchain registration of a root module.
proto_toolchain_guard(
    name = "proto_toolchain_guard",
    exec_check = ":proto_toolchain_guard_exec",
    toolchain_registration = "@rules_jvm//:protoc_java_toolchain_toolchain",
    visibility = ["//visibility:public"],
)

proto_toolchain_guard(
    name = "proto_toolchain_guard_exec",
    toolchain_registration = "@rules_jvm//:protoc_java_toolchain_toolchain",
)

kt_kotlinc_options(
    name = "rules_jvm_bootstrap_kotlinc_options",
    api_version = "2.5",
    include_stdlibs = "none",
    jvm_target = "25",
    # The language level of the tool targets of rules_jvm: 2.5, the level of the monorepo modules. The
    # toolchain rule defaults to 2.4.
    language_version = "2.5",
    visibility = ["//visibility:public"],
    x_jdk_release = "25",
    # The pinned rules_kotlin emits -Xlambdas=class by default; the monorepo modules compile with indy.
    x_lambdas = "indy",
)

# Controls IC for the custom rules_jvm Kotlin toolchain.
