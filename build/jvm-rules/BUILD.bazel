)

# Kotlin toolchain for rules_kotlin backend.
# ABI-generation options are kept in sync with the JPS backend's invocation of
# JvmAbiCommandLineProcessor in
# jvm-inc-builder/src/.../kotlinPlugins.kt::configurePlugins so that both
# backends produce the same Kotlin ABI bytes.
#
# Mapping (jvm-abi-gen plugin option -> source of truth here):
#   removePrivateClasses=true                    -> experimental_remove_private_classes_in_abi_jars
#   removeDebugInfo=false                        -> experimental_remove_debug_info_in_abi_jars (default False)
#   treatInternalAsPrivate (not set)             -> experimental_treat_internal_as_private_in_abi_jars (default False)
#   removeDataClassCopyIfConstructorIsPrivate=true -> experimental_remove_data_class_copy_if_constructor_is_private
#   preserveDeclarationOrder=true                -> experimental_preserve_declaration_order
# The Build Tools API compilation runtime of the toolchain below: the _KOTLIN_VERSION artifacts,
# every one in the embeddable dialect. It sets every artifact, so nothing is inherited from the
# rules_kotlin default runtime of the bundled Kotlin release.
kt_btapi_runtime(
    name = "kotlin_btapi_runtime",
    build_tools_impl = [":kotlin-build-tools-impl_import"],
    compiler = [":kotlin-compiler-embeddable_import"],
    # jdeps-gen comes from the rules_kotlin repository: its embeddable variant.
    jdeps_gen = ["@rules_kotlin//src/main/kotlin:jdeps-gen-embeddable"],
    jvm_abi_gen = [":jvm-abi-gen-embeddable_import"],
    # The kapt plugin of the release of the compiler: the runtime loads them together.
    kapt = [":kotlin-annotation-processing-embeddable_import"],
    # The libraries the implementation and the compiler need. The kotlinx-serialization runtime
    # the Build Tools implementation needs is listed explicitly.
    libraries = [
        ":kotlin-daemon-client_import",
        ":kotlin-stdlib_import",
        ":kotlin-reflect_import",
        ":kotlinx-coroutines-core_import",
        ":annotations_import",
        ":kotlin-tooling-core_import",
        "@kotlinx-serialization-core-jvm_http//file",
        "@kotlinx-serialization-json-jvm_http//file",
    ],
)

# The Kotlin toolchain of every target that compiles through the rules_kotlin rules. Each MODULE.bazel registers it;
# a root registration outranks the default toolchain of rules_kotlin, the compiler distribution with the legacy
# invocation.
define_kt_toolchain(
    name = "kotlin_toolchain",
    # The language and api version of a target whose kotlinc options set none: the highest value the toolchain
    # rule accepts. The modules and the generated defaults set 2.5 in their options, which override these
    # attributes.
    api_version = "2.4",
    # The runtime enables the Build Tools API compilation; the legacy invocation stays available
    # upstream but this toolchain never uses it.
    btapi_runtime = ":kotlin_btapi_runtime",
    # Run the BTA Kotlin worker in multiplex mode (concurrency-safe), on par with the JPS JvmCompile path.
    experimental_multiplex_workers = True,
    experimental_preserve_declaration_order = True,
    experimental_remove_data_class_copy_if_constructor_is_private = True,
    experimental_remove_private_classes_in_abi_jars = True,
    # Generate ABI jars with jvm-abi-gen. Without this switch the options above are inert and
    # the .abi.jar is a fold of the full class jar.
    experimental_use_abi_jars = True,
    # The javac options of a target that sets none: the default-javac-opts flag, the fallback the rules_jvm rules
    # take too.
    javac_options = ":default-javac-opts",
    jvm_runtime = [
        ":kotlin-stdlib_import",
    ],

    # Implicit Kotlin stdlib + jetbrains-annotations injected by rules_kotlin into
    # every kt_jvm_library's JavaInfo. Without these overrides the toolchain falls
    # back to rules_kotlin's defaults (@kotlin_rules_maven//...)
    jvm_stdlibs = [
        ":annotations_import",
        ":kotlin-stdlib_import",
    ],
    # The kotlinc options of a target that sets none: the default-kotlinc-opts flag, the fallback the rules_jvm
    # rules take too. A root build points the flag to the generated module defaults (community/common.bazelrc).
    kotlinc_options = ":default-kotlinc-opts",
    language_version = "2.4",
)

