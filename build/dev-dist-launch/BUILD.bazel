# The launch model of every community split product, `<product>.launch.json`, which the community half of the dev-dist
# generator writes. The `platform_resources` component of a platform set renders `build.txt`, `bin/idea.properties`, the
# vmoptions file and `bin/product-info.json` from it, see `dev_dist_product_files`. Only the platform sets of `//build`
# read the models. A distribution of a community product in the ultimate checkout composes those platform sets too.
exports_files(
    glob(["*.launch.json"]),
    visibility = ["//build:__pkg__"],
)
