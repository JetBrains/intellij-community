{
  "name": "ij-mcp-proxy",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=18"
  },
  "scripts": {
    "build": "bun build.ts",
    "start": "bun dist/ij-mcp-proxy.mjs",
    "test": "bun test ./*.test.ts ./integration-tests/*.test.ts",
    "test:jb-mcp": "JETBRAINS_MCP_STREAM_URL=http://127.0.0.1:64344/stream bun test ./integration-tests/jb-mcp-*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "is-port-reachable": "^4.0.0",
    "p-retry": "^7.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.1",
    "@types/node": "^25.9.5"
  }
}
