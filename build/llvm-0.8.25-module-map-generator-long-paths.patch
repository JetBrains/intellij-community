+  if (MultiByteToWideChar(CP_UTF8, 0, path, -1, wide, WIDE_PATH_CAPACITY) == 0) {
+    errno = EINVAL;
     return -1;
   }
+  length = GetFullPathNameW(wide, WIDE_PATH_CAPACITY, full, NULL);
+  if (length == 0 || length >= WIDE_PATH_CAPACITY) {
+    errno = ENAMETOOLONG;
+    return -1;
+  }
+  if (full[0] == L'\\' && full[1] == L'\\') {
+    // A UNC path `\\server\share\...` becomes `\\?\UNC\server\share\...`.
+    wcscpy(prefixed, L"\\\\?\\UNC\\");
+    wcscat(prefixed, full + 2);
+  } else {
+    wcscpy(prefixed, L"\\\\?\\");
+    wcscat(prefixed, full);
+  }
+  if (!GetFileAttributesExW(prefixed, GetFileExInfoStandard, &data)) {
+    errno = ENOENT;
+    return -1;
+  }
+  *size = ((unsigned long long)data.nFileSizeHigh << 32) | data.nFileSizeLow;
+  return 0;
+}
