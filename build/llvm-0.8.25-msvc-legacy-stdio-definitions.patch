Expose `legacy_stdio_definitions.lib` with the MSVC runtime libraries.

The Rust `libc` crate links `legacy_stdio_definitions` on MSVC with `#[link]`, with and without a static CRT.
When rustc drives the link, it asks for the library, and lld-link fails with "could not open
'legacy_stdio_definitions.lib'". It ships next to the other runtime libraries of the MSVC toolset, but the
runtime allowlists leave it out. Add it to both the dynamic and the static list.
--- a/runtimes/msvc/BUILD.bazel
+++ b/runtimes/msvc/BUILD.bazel
@@ -6,6 +6,7 @@
 
 _MSVC_DYNAMIC_RUNTIME_LIBRARIES = [
     "iso_stdio_wide_specifiers.lib",
+    "legacy_stdio_definitions.lib",
     "msvcprt.lib",
     "msvcrt.lib",
     "oldnames.lib",
@@ -14,6 +15,7 @@
 
 _MSVC_STATIC_RUNTIME_LIBRARIES = [
     "iso_stdio_wide_specifiers.lib",
+    "legacy_stdio_definitions.lib",
     "libcmt.lib",
     "libcpmt.lib",
     "libvcruntime.lib",
