{
    "version": 2,
    "plugin": "intellij.code.provenance",
    "variant": "{platform}",
    "layoutSignature": "{platform:layoutSignature}",
    "assets": [
        {
            "module": "intellij.code.provenance.dev"
        },
        {
            "module": "intellij.code.provenance.ui"
        },
        {
            "module": "intellij.code.provenance.core"
        },
        {
            "module": "intellij.code.provenance.core.claude"
        },
        {
            "module": "intellij.code.provenance.core.fus"
        },
        {
            "module": "intellij.code.provenance.core.git"
        },
        {
            "module": "intellij.code.provenance.core.mcp"
        },
        {
            "module": "intellij.code.provenance.core.llm"
        },
        {
            "destination": "lib/code-provenance.jar",
            "recipe": {
                "sources": [
                    {
                        "input": "descriptor:intellij.code.provenance",
                        "kind": "file",
                        "filter": "none",
                        "entry": "META-INF/plugin.xml",
                        "options": [
                            "patch"
                        ]
                    },
                    {
                        "input": "intellij.code.provenance",
                        "kind": "module",
                        "filter": "module-v1"
                    }
                ],
                "writer": {
                    "mergeEntities": true
                }
            }
        },
        {
            "destination": "{platform:destination}",
            "inputs": [
                "layout-assets:platform-custom-asset:0:output"
            ],
            "kind": "tree",
            "classPath": false
        }
    ],
    "preparations": [
        {
            "id": "layout-assets:platform-custom-asset:0",
            "inputs": [
                "layout-source:platform-custom-asset:0:0"
            ],
            "outputs": [
                "layout-assets:platform-custom-asset:0:output"
            ],
            "modelSignature": "{platform:modelSignature}"
        }
    ],
    "operations": [
        {
            "id": "layout-assets:platform-custom-asset:0",
            "kind": "layout-assets",
            "inputs": [
                {
                    "artifact": "layout-source:platform-custom-asset:0:0"
                }
            ],
            "output": "layout-assets:platform-custom-asset:0:output",
            "manifest": "keep",
            "layoutAssets": {
                "format": "tree",
                "root": "{platform:destination}",
                "assets": [
                    {
                        "destination": "",
                        "sources": [
                            0
                        ],
                        "transform": {
                            "kind": "archive-tree"
                        }
                    }
                ]
            }
        }
    ]
}
