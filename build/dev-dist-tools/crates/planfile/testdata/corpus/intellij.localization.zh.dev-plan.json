{
    "version": 1,
    "plugin": "intellij.localization.zh",
    "variant": "",
    "assets": [
        {
            "destination": "lib/localization-zh.jar",
            "recipe": {
                "sources": [
                    {
                        "input": "descriptor:intellij.localization.zh",
                        "kind": "file",
                        "filter": "none",
                        "entry": "META-INF/plugin.xml",
                        "options": [
                            "patch"
                        ]
                    },
                    {
                        "input": "intellij.localization.zh",
                        "kind": "module",
                        "filter": "module-v1"
                    },
                    {
                        "input": "layout-assets:custom-asset:0:output",
                        "kind": "prepared",
                        "filter": "prepared"
                    }
                ],
                "writer": {
                    "manifest": "drop",
                    "mergeEntities": true
                }
            }
        }
    ],
    "operations": [
        {
            "id": "layout-assets:custom-asset:0",
            "kind": "layout-assets",
            "inputs": [
                {
                    "artifact": "localization:properties/zh"
                },
                {
                    "artifact": "localization:inspections_intentions/zh"
                }
            ],
            "output": "layout-assets:custom-asset:0:output",
            "manifest": "keep",
            "layoutAssets": {
                "format": "entries",
                "assets": [
                    {
                        "destination": "",
                        "sources": [
                            0
                        ]
                    },
                    {
                        "destination": "",
                        "sources": [
                            1
                        ]
                    }
                ]
            }
        }
    ]
}
