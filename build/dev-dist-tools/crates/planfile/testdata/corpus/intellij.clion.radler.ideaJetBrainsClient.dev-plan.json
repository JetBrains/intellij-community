{
    "version": 1,
    "plugin": "intellij.clion.radler",
    "variant": "{platform}",
    "layoutSignature": "{platform:layoutSignature}",
    "assets": [
        {
            "module": "intellij.rider.rdclient.xml"
        },
        {
            "module": "intellij.rider.rdclient.dotnet.startup"
        },
        {
            "module": "intellij.rider.rdclient.languages"
        },
        {
            "module": "intellij.rider.cpp.core.languages"
        },
        {
            "module": "intellij.rider.model.generated"
        },
        {
            "module": "intellij.resharper.cpp.lexer"
        },
        {
            "module": "intellij.resharper.assist"
        },
        {
            "module": "intellij.resharper.cpp.assist"
        },
        {
            "module": "intellij.rider.icons"
        },
        {
            "module": "intellij.clion.radler.icons"
        },
        {
            "module": "intellij.clion.radler.common"
        },
        {
            "module": "intellij.clion.radler.frontend.split"
        },
        {
            "module": "intellij.clion.radler.ide"
        },
        {
            "destination": "lib/clion-radler.jar",
            "recipe": {
                "sources": [
                    {
                        "input": "descriptor:intellij.clion.radler",
                        "kind": "file",
                        "filter": "none",
                        "entry": "META-INF/plugin.xml",
                        "options": [
                            "patch"
                        ]
                    },
                    {
                        "input": "intellij.clion.radler",
                        "kind": "module",
                        "filter": "module-v1"
                    }
                ],
                "writer": {
                    "mergeEntities": true
                }
            }
        }
    ]
}
