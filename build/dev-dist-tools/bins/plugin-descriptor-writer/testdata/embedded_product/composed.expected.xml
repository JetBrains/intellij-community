<idea-plugin xmlns:xi="http://www.w3.org/2001/XInclude">
  <id>com.intellij</id>
  <module value="embedded.alias.a" />
  <module value="embedded.alias.b" />
  <content>
    <module name="intellij.embedded.jar" loading="required"><![CDATA[<idea-plugin xmlns:xi="http://www.w3.org/2001/XInclude" package="from.jar" separate-jar="true">
  <extensions defaultExtensionNs="test">
    <extension value="a &amp; b" />
  </extensions>
</idea-plugin>]]></module>
    <module name="intellij.embedded.file"><![CDATA[<idea-plugin xmlns:xi="http://www.w3.org/2001/XInclude" package="from.file" separate-jar="true">
  <extensions defaultExtensionNs="test">
    <extension value="a &amp; b" />
  </extensions>
</idea-plugin>]]></module>
  </content>
  <extensions defaultExtensionNs="test">
    <extension value="from file" />
  </extensions>
  <xi:include href="optional.xml">
    <xi:fallback />
  </xi:include>
  <content namespace="jetbrains">
    <module name="intellij.embedded.noPackage"><![CDATA[<idea-plugin>
  <dependencies>
    <module name="intellij.platform.core" />
  </dependencies>
</idea-plugin>]]></module>
    <module name="intellij.embedded/fragment" loading="embedded"><![CDATA[<idea-plugin xmlns:xi="http://www.w3.org/2001/XInclude" package="from.file">
  <extensions defaultExtensionNs="test">
    <extension value="a &amp; b" />
  </extensions>
</idea-plugin>]]></module>
  </content>
  <content>
    <module name="intellij.embedded.notSeparate" loading="on-demand"><![CDATA[<idea-plugin xmlns:xi="http://www.w3.org/2001/XInclude" package="from.file">
  <extensions defaultExtensionNs="test">
    <extension value="a &amp; b" />
  </extensions>
</idea-plugin>]]></module>
  </content>
  <content namespace="jetbrains">
    <module name="intellij.embedded.existing" required-if-available="intellij.embedded.noPackage"><![CDATA[<idea-plugin xmlns:xi="http://www.w3.org/2001/XInclude" package="from.file" separate-jar="true">
  <extensions defaultExtensionNs="test">
    <extension value="a &amp; b" />
  </extensions>
</idea-plugin>]]></module>
  </content>
</idea-plugin>