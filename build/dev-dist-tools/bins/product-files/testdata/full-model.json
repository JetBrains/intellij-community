{
  "productCode": "IIS",
  "envVarBaseName": "IDEA_SERVER",
  "dataDirectoryName": "IntelliJServer2026.3",
  "minRequiredJavaVersion": 21,
  "customProperties": [
    {
      "key": "k1",
      "value": "v\n1"
    },
    {
      "key": "k2",
      "value": ""
    }
  ],
  "flavors": [
    "server",
    "remote"
  ],
  "baseFileName": "server",
  "languageServer": true,
  "launch": {
    "mainClass": "com.intellij.platform.runtime.loader.IntellijLoader",
    "bootClassPathJarNames": [],
    "jvmArguments": {
      "multiRoutingFileSystem": true,
      "classLoader": "com.example.ServerClassLoader",
      "vendorName": "JetBrains",
      "pathsSelector": "IntelliJServer2026.3",
      "jnaNativeDir": "plugins/jna-plugin/lib/jna",
      "pty4jNativeDir": "plugins/pty4j-plugin/lib/pty4j",
      "skikoNativeDir": "plugins/skiko-plugin/lib/skiko-awt-runtime-all",
      "runtimeModuleRepository": true,
      "rootModule": "intellij.server.main",
      "productMode": "backend",
      "platformPrefix": "IntelliJServer",
      "additional": [
        "-Dfirst=1",
        "-Dsecond=\"2\""
      ],
      "splash": true,
      "nativeAccess": true
    },
    "stdioRedirectArg": "--stdio"
  },
  "customCommands": [
    {
      "commands": [
        "qodana",
        "inspect"
      ],
      "vmOptionsFilePath": {
        "Linux": "bin/qodana.vmoptions"
      },
      "jvmArguments": {
        "multiRoutingFileSystem": true,
        "classLoader": "com.intellij.util.lang.PathClassLoader",
        "vendorName": "JetBrains",
        "pathsSelector": "Qodana2026.3",
        "rootModule": "intellij.qodana"
      },
      "qodana": true,
      "macJvmArguments": [
        "-Dapple.awt.application.icon=$APP_PACKAGE/Contents/Resources/x.icns"
      ],
      "extraJvmArguments": [
        "-Dextra=1"
      ],
      "mainClass": "com.intellij.qodana.Main",
      "envVarBaseName": "QODANA",
      "dataDirectoryName": "Qodana2026.3"
    },
    {
      "commands": []
    }
  ],
  "vmOptions": {
    "macOS": [
      "-Xmx4g",
      "-Dmac=1"
    ],
    "Linux": [],
    "Windows": [
      "-Xmx4g",
      "-Dwindows=\"1\""
    ]
  },
  "ideaProperties": {
    "languageServerBase": true,
    "additions": [
      "x=@@settings_dir@@/x",
      ""
    ],
    "settingsDir": "IntelliJServer",
    "suffix": ""
  }
}
