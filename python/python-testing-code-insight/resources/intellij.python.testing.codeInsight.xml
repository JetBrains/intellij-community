<idea-plugin visibility="public">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.libraries.jetbrains.annotations"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.indexing"/>
    <module name="intellij.platform.lang"/>
    <module name="intellij.platform.lang.impl"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.util.ui"/>
    <module name="intellij.python.ast"/>
    <module name="intellij.python.psi"/>
    <module name="intellij.python.psi.impl"/>
    <module name="intellij.python.sdk.backend"/>
  </dependencies>
  <!-- endregion -->

  <extensionPoints>
    <extensionPoint qualifiedName="Pythonid.pyTestFixtureExtension"
                    interface="com.jetbrains.python.testing.pyTestFixtures.PyTestFixtureExtension" dynamic="true"/>
  </extensionPoints>

  <extensions defaultExtensionNs="com.intellij">
    <completion.contributor language="Python"
                            implementationClass="com.jetbrains.python.testing.PyTestParameterCompletionContributor"/>

    <localInspection language="Python" shortName="PyTestParametrizedInspection" suppressId="PyTestParametrized"
                     bundle="messages.PyPsiBundle" key="INSP.NAME.pytest-parametrized"
                     groupPathKey="INSP.GROUP.python" groupKey="INSP.GROUP.python.test.frameworks"
                     enabledByDefault="true" level="WARNING"
                     implementationClass="com.jetbrains.python.testing.pyTestParametrized.PyTestParametrizedInspection"/>
    <localInspection language="Python" shortName="PyTestUnpassedFixtureInspection" suppressId="PyTestUnpassedFixture"
                     bundle="messages.PyPsiBundle" key="INSP.NAME.pytest.unpassed.fixture"
                     groupPathKey="INSP.GROUP.python" groupKey="INSP.GROUP.python.test.frameworks"
                     enabledByDefault="true" level="WARNING"
                     implementationClass="com.jetbrains.python.testing.pyTestFixtures.PyTestUnpassedFixtureInspection"/>
    <localInspection language="Python" shortName="PyMockPatchArgumentCountInspection" suppressId="PyMockPatchArgumentCount"
                     bundle="messages.PyPsiBundle"
                     groupPathKey="INSP.GROUP.python" groupKey="INSP.GROUP.python.test.frameworks"
                     key="INSP.NAME.mock-patch-argument-count" enabledByDefault="true" level="WARNING"
                     implementationClass="com.jetbrains.python.testing.pyMock.PyMockPatchArgumentCountInspection"/>
    <localInspection language="Python" shortName="PyMockPatchTargetInspection" suppressId="PyMockPatchTarget"
                     bundle="messages.PyPsiBundle" key="INSP.NAME.mock-patch-target"
                     groupPathKey="INSP.GROUP.python" groupKey="INSP.GROUP.python.test.frameworks"
                     enabledByDefault="true" level="WARNING"
                     implementationClass="com.jetbrains.python.testing.pyMock.PyMockPatchTargetInspection"/>

    <psi.referenceContributor implementation="com.jetbrains.python.testing.pyTestFixtures.PyTestFixtureReferenceContributor"
                              language="Python"/>
    <psi.referenceContributor implementation="com.jetbrains.python.testing.pyTestParametrized.PyTestParametrizedContributor"
                              language="Python"/>
    <psi.referenceContributor implementation="com.jetbrains.python.testing.pyMock.PyMockReferenceContributor"
                              language="Python"/>
    <psi.referenceContributor implementation="com.jetbrains.python.testing.pyMonkeypatch.PyMonkeypatchReferenceContributor"
                              language="Python"/>
  </extensions>

  <extensions defaultExtensionNs="Pythonid">
    <pyReferenceCustomTargetChecker implementation="com.jetbrains.python.testing.pyTestFixtures.PyTestFixtureTargetChecker"/>

    <!--pytest fixture -->
    <inspectionExtension implementation="com.jetbrains.python.testing.pyTestFixtures.PyTestFixtureInspectionExtension"/>
    <inspectionExtension implementation="com.jetbrains.python.testing.pyTestParametrized.PyTestParametrizedInspectionExtension"/>
    <inspectionExtension implementation="com.jetbrains.python.testing.pyMock.PyMockInspectionExtension"/>
    <typeProvider implementation="com.jetbrains.python.testing.pyTestParametrized.PyTestParametrizedTypeProvider"/>
    <typeProvider implementation="com.jetbrains.python.testing.pyTestFixtures.PyTextFixtureTypeProvider"/>
    <typeProvider implementation="com.jetbrains.python.testing.pyMock.PyMockTypeProvider"/>
    <typeProvider implementation="com.jetbrains.python.testing.pyMock.PyMockerFixtureTypeProvider"/>
    <typeCheckerExtension implementation="com.jetbrains.python.testing.pyMock.PyMockTypeCheckerExtension"/>
  </extensions>
</idea-plugin>
