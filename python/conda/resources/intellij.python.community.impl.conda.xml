<idea-plugin visibility="internal">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.json.backend"/>
    <module name="intellij.libraries.caffeine"/>
    <module name="intellij.libraries.commons.compress"/>
    <module name="intellij.libraries.gson"/>
    <module name="intellij.libraries.jackson3"/>
    <module name="intellij.libraries.jackson3.databind"/>
    <module name="intellij.libraries.jackson3.dataformat.yaml"/>
    <module name="intellij.libraries.jetbrains.annotations"/>
    <module name="intellij.libraries.kotlin.reflect"/>
    <module name="intellij.libraries.kotlinx.io"/>
    <module name="intellij.libraries.kotlinx.serialization.core"/>
    <module name="intellij.libraries.kotlinx.serialization.json"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.eel.provider"/>
    <module name="intellij.platform.execution"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.remote.core"/>
    <module name="intellij.python.community"/>
    <module name="intellij.python.community.execService"/>
    <module name="intellij.python.community.execService.python"/>
    <module name="intellij.python.community.impl.conda.common"/>
    <module name="intellij.python.community.impl.installer"/>
    <module name="intellij.python.packaging"/>
    <module name="intellij.python.processOutput.common"/>
    <module name="intellij.python.pyproject"/>
    <module name="intellij.python.pytools.backend"/>
    <module name="intellij.python.requirements.backend"/>
    <module name="intellij.python.requirements.common"/>
    <module name="intellij.python.sdk.backend"/>
    <module name="intellij.python.sdk.common"/>
    <module name="intellij.python.venv"/>
    <module name="intellij.yaml"/>
  </dependencies>
  <!-- endregion -->
  <extensions defaultExtensionNs="com.intellij">
    <python.processOutput.common.processOutputIconMapping implementation="com.intellij.python.community.impl.conda.CondaIconMapping"/>
    <python.pytools.pyTool implementation="com.intellij.python.community.impl.conda.CondaPyTool"/>
    <!-- Claim environment.yml/environment.yaml as YAML files belonging to the Python plugin so that the
         plugin advertiser doesn't promote unrelated third-party plugins for these conda env files (PY-89976). -->
    <fileType name="YAML" fileNames="environment.yml;environment.yaml"/>
  </extensions>

  <extensions defaultExtensionNs="Pythonid">
    <pyDependenciesFileProvider implementation="com.intellij.python.community.impl.conda.environmentYml.CondaEnvironmentYmlFileProvider"/>
    <pythonFlavorProvider implementation="com.jetbrains.python.sdk.flavors.conda.CondaEnvSdkFlavorProvider"/>
    <pySdkDataProvider implementation="com.jetbrains.python.sdk.conda.CondaSdkDataProvider"/>
    <pythonPackageManagerProvider implementation="com.jetbrains.python.packaging.conda.CondaPackageManagerProvider"/>
    <pythonEnvironmentProvider id="conda" order="after venv"
                               implementation="com.intellij.python.community.impl.conda.environment.CondaEnvironmentProvider"/>
  </extensions>

  <extensions defaultExtensionNs="JavaScript.JsonSchema">
    <ProviderFactory implementation="com.intellij.python.community.impl.conda.environmentYml.CondaEnvironmentYmlSchemaProviderFactory"/>
  </extensions>
</idea-plugin>
