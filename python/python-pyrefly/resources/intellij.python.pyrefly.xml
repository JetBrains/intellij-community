<idea-plugin visibility="internal">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.platform.lsp.impl"/>
    <module name="intellij.libraries.eclipse.lsp4j"/>
    <module name="intellij.libraries.fastutil"/>
    <module name="intellij.libraries.guava"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.codeStyle.impl"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.editor.ex"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.eel.provider"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.ide.observable"/>
    <module name="intellij.platform.lang.impl"/>
    <module name="intellij.platform.lsp"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.smRunner"/>
    <module name="intellij.platform.statistics"/>
    <module name="intellij.platform.util.ex"/>
    <module name="intellij.platform.util.ui"/>
    <module name="intellij.python.lsp.core"/>
    <module name="intellij.python.psi"/>
    <module name="intellij.python.psi.impl"/>
    <module name="intellij.python.pyrefly.common"/>
    <module name="intellij.python.pytools.backend"/>
    <module name="intellij.xml.parser"/>
  </dependencies>
  <!-- endregion -->

  <extensions defaultExtensionNs="com.intellij">
    <platform.lsp.integrationProvider implementation="com.intellij.python.pyrefly.lsp.PyreflyLspIntegrationProvider"/>
    <platform.lsp.integrationProvider implementation="com.intellij.python.pyrefly.lsp.BundledPyreflyLspIntegrationProvider"/>

    <statistics.counterUsagesCollector implementationClass="com.intellij.python.pyrefly.PyreflyUsageCollector"/>

    <registryKey key="pyrefly.heartbeat.interval.ms" defaultValue="60000"
                 description="Interval in milliseconds between the resource usage heartbeats of a Pyrefly server process"/>

    <projectSettings service="com.intellij.python.pyrefly.PyreflyConfiguration"/>
    <projectSettings service="com.intellij.python.pyrefly.BundledPyreflyConfiguration"/>
    <python.pytools.pyTool implementation="com.intellij.python.pyrefly.PyreflyPyTool"/>
  </extensions>
</idea-plugin>
