load("@community//build:community_build_target.bzl", "community_build_target")
load("@community//build:tests-options.bzl", "jps_test")
load("@rules_jvm//:jvm.bzl", "jvm_library")
load("//build:compiler-options.bzl", "create_kotlinc_options")

# The product images directory of PyCharm Community. The split platform set of the ultimate checkout reads it as an
# extra project file.
filegroup(
    name = "images",
    srcs = glob(["images/**"]),
    visibility = ["//visibility:public"],
)

# `PyCharmCommunityProperties` reads the bundled plugin list; the split platform set of the ultimate checkout reads it
# as an extra project file.
exports_files(
    ["plugin-list.txt"],
    visibility = ["//visibility:public"],
)

community_build_target(
    name = "pycharm_community_installers",
    main_class = "PyCharmCommunityInstallersBuildTarget",
    runtime_deps = [":build"],
)

# Use this target for local development only. Do not use it for CI builds.
community_build_target(
    name = "pycharm_community_installers_local",
    jvm_flags = [
        "-Dintellij.build.target.os=current",
        "-Dintellij.build.target.arch=current",
        "-Dintellij.build.skip.build.steps=search_index,sources_archive,scramble,maven_artifacts,mac_dmg,windows_exe_installer,linux_tar_gz_without_jre,repair_utility_bundle_step",
    ],
    main_class = "PyCharmCommunityInstallersBuildTarget",
    runtime_deps = [":build"],
)

# Temporary alias until TeamCity config is migrated to the new target
alias(
    name = "i_build_target",
    actual = "//python/build:pycharm_community_installers",
    visibility = ["//visibility:public"],
)

