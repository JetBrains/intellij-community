<idea-plugin visibility="internal">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.libraries.gson"/>
    <module name="intellij.libraries.jetbrains.annotations"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.python.community"/>
    <module name="intellij.python.community.execService"/>
    <module name="intellij.python.community.execService.python"/>
    <module name="intellij.python.community.impl.pipenv.common"/>
    <module name="intellij.python.packaging"/>
    <module name="intellij.python.processOutput.common"/>
    <module name="intellij.python.pyproject"/>
    <module name="intellij.python.pytools.backend"/>
    <module name="intellij.python.requirements.backend"/>
    <module name="intellij.python.requirements.common"/>
    <module name="intellij.python.sdk.backend"/>
  </dependencies>
  <!-- endregion -->
  <extensions defaultExtensionNs="com.intellij">
    <python.pytools.pyTool implementation="com.intellij.python.community.impl.pipenv.PipEnvPyTool"/>
    <python.processOutput.common.processOutputIconMapping implementation="com.intellij.python.community.impl.pipenv.PipenvIconMapping"/>
  </extensions>
  <extensions defaultExtensionNs="Pythonid">
    <pythonFlavorProvider implementation="com.jetbrains.python.sdk.pipenv.PyPipEnvSdkFlavorProvider"/>
    <pythonPackageManagerProvider implementation="com.jetbrains.python.packaging.pipenv.PipEnvPackageManagerProvider"/>
  </extensions>
</idea-plugin>
