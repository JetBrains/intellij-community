<idea-plugin>
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.libraries.kotlinx.serialization.core"/>
    <module name="intellij.libraries.kotlinx.serialization.json"/>
    <module name="intellij.libraries.semver"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.execution"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.python.community"/>
    <module name="intellij.python.community.common"/>
    <module name="intellij.python.community.execService"/>
    <module name="intellij.python.community.execService.python"/>
    <module name="intellij.python.community.services.systemPython"/>
    <module name="intellij.python.processOutput.common"/>
    <module name="intellij.python.pyproject"/>
    <module name="intellij.python.pytools"/>
    <module name="intellij.python.sdk.backend"/>
    <module name="intellij.python.sdk.common"/>
  </dependencies>
  <!-- endregion -->

  <extensions defaultExtensionNs="Pythonid">
    <!-- Between conda and pip. Declared from this side because this is the optional module: both anchors it names are
         in the python plugin, which is always loaded when this one is. -->
    <evoEnvironmentProvider id="HatchEvoProvider"
                            order="after CondaEvoProvider, before PipEvoProvider"
                            implementation="com.intellij.python.hatch.sdk.evolution.HatchEvoEnvironmentProvider"/>

    <pySdkProvider implementation="com.intellij.python.hatch.impl.sdk.HatchSdkProvider"/>
    <pythonFlavorProvider implementation="com.intellij.python.hatch.impl.sdk.HatchSdkFlavorProvider"/>
  </extensions>
  <extensions defaultExtensionNs="com.intellij">
    <python.pytools.pyTool implementation="com.intellij.python.hatch.HatchPyTool"/>
    <python.community.common.toolToIconMapper implementation="com.intellij.python.hatch.impl.HatchIdMapper"/>
    <python.processOutput.common.processOutputIconMapping implementation="com.intellij.python.hatch.impl.HatchIconMapping"/>
  </extensions>
</idea-plugin>