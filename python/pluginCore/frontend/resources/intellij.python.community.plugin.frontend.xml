<idea-plugin visibility="internal">
  <!--Settings tree for other (not PyCharm) IDEs-->
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <!--Any IDE but NOT PyCharm-->
    <plugin id="com.intellij.modules.python-in-non-pycharm-ide-capable"/>
    <module name="intellij.platform.frontend"/>
    <module name="intellij.platform.ide.impl"/>
  </dependencies>
  <!-- endregion -->

  <extensions defaultExtensionNs="com.intellij">
    <!-- PyCharm declares the same group on the top level, in
      [community\python\ide\impl\resources\intellij.pycharm.community.ide.impl.xml] and
      [python\pycharm\frontend\split\customization\resources\META-INF\plugin.xml].
      This module loads in any IDE but PyCharm, so the two declarations never meet.
      The group must exist in every IDE. The platform drops a child group whose parent is absent,
      which hides the Python tool pages. -->
    <groupConfigurable id="python.group.settings"
                       parentId="language"
                       bundle="messages.PyPluginFrontendBundle"
                       displayNameKey="settings.python.group.title"
                       descriptionKey="settings.python.group.description"/>
  </extensions>
</idea-plugin>
