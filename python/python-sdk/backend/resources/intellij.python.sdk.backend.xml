<idea-plugin visibility="public">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.libraries.caffeine"/>
    <module name="intellij.libraries.gson"/>
    <module name="intellij.libraries.guava"/>
    <module name="intellij.libraries.jackson"/>
    <module name="intellij.libraries.jackson.databind"/>
    <module name="intellij.libraries.jackson.module.kotlin"/>
    <module name="intellij.libraries.jna"/>
    <module name="intellij.libraries.stream"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.analysis.impl"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.execution"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.core.impl"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.ide.progress"/>
    <module name="intellij.platform.lang"/>
    <module name="intellij.platform.project"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.projectModel.impl"/>
    <module name="intellij.platform.remote.core"/>
    <module name="intellij.platform.rpc.backend"/>
    <module name="intellij.platform.util.ex"/>
    <module name="intellij.platform.util.ui"/>
    <module name="intellij.platform.workspace.jps"/>
    <module name="intellij.python.community"/>
    <module name="intellij.python.community.common"/>
    <module name="intellij.python.community.execService"/>
    <module name="intellij.python.community.execService.python"/>
    <module name="intellij.python.community.helpersLocator"/>
    <module name="intellij.python.community.services.shared"/>
    <module name="intellij.python.pytools"/>
    <module name="intellij.python.requirements.backend"/>
    <module name="intellij.python.sdk.common"/>
  </dependencies>
  <!-- endregion -->
  <extensionPoints>
    <extensionPoint qualifiedName="Pythonid.pythonSdkFlavor" interface="com.jetbrains.python.sdk.flavors.PythonSdkFlavor" dynamic="true"/>
    <extensionPoint qualifiedName="Pythonid.pythonFlavorProvider"
                    interface="com.jetbrains.python.sdk.flavors.PythonFlavorProvider"
                    dynamic="true"/>
    <extensionPoint qualifiedName="Pythonid.projectSdkConfigurationExtension"
                    interface="com.jetbrains.python.sdk.configuration.PyProjectSdkConfigurationExtension"
                    dynamic="true"/>
    <!-- Experimental sdk EP, avoid using it -->
    <extensionPoint qualifiedName="Pythonid.pySdkProvider"
                    interface="com.jetbrains.python.sdk.PySdkProvider"
                    dynamic="true"/>
    <extensionPoint qualifiedName="Pythonid.evoEnvironmentProvider"
                    interface="com.intellij.python.sdk.backend.evolution.PyEvoEnvironmentProvider"
                    dynamic="true"/>
    <extensionPoint qualifiedName="Pythonid.interpreterPresentationProvider"
                    interface="com.intellij.python.sdk.backend.PythonInterpreterPresentationProvider"
                    dynamic="true"/>
    <!-- The `id` names the kind of environment. It is the only place a kind is named. -->
    <extensionPoint qualifiedName="Pythonid.pythonEnvironmentProvider"
                    interface="com.intellij.python.sdk.backend.PythonEnvironmentProvider"
                    dynamic="true"/>
  </extensionPoints>

  <extensions defaultExtensionNs="Pythonid">
    <pythonSdkFlavor implementation="com.jetbrains.python.sdk.flavors.MacPythonSdkFlavor"/>
    <pythonSdkFlavor implementation="com.jetbrains.python.sdk.flavors.UnixPythonSdkFlavor"/>
    <pythonSdkFlavor implementation="com.jetbrains.python.sdk.flavors.WinPythonSdkFlavor"/>
    <!-- Claims any layout, so it must stay last. -->
    <pythonEnvironmentProvider id="system" order="last"
                               implementation="com.intellij.python.sdk.backend.impl.SystemPythonEnvironmentProvider"/>
  </extensions>

  <extensions defaultExtensionNs="com.intellij">
    <applicationService serviceInterface="com.jetbrains.python.sdk.WinRegistryService"
                        serviceImplementation="com.jetbrains.python.sdk.WinRegistryServiceImpl"/>
    <applicationService serviceImplementation="com.jetbrains.python.sdk.PySdkSettings"/>
    <applicationSettings service="com.jetbrains.python.sdk.PySdkSettings"/>
    <registryKey key="python.activate.env.reader.timeout.ms"
                 defaultValue="60000"
                 restartRequired="false"
                 description="Timeout (ms) for reading a Python interpreter's activation environment (e.g. conda activate). Increase it if slow conda activation times out and the launched process is missing environment variables."/>
  </extensions>

</idea-plugin>
