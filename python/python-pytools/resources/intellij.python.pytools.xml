<idea-plugin visibility="public">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.libraries.caffeine"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.execution"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.statistics"/>
    <module name="intellij.platform.util.ui"/>
    <module name="intellij.python.community"/>
    <module name="intellij.python.community.execService"/>
  </dependencies>
  <!-- endregion -->

  <extensionPoints>
    <extensionPoint qualifiedName="com.intellij.python.pytools.pyTool"
                    interface="com.intellij.python.pytools.PyTool"
                    dynamic="true"/>
    <extensionPoint qualifiedName="com.intellij.python.pytools.genericPyToolManagerProvider"
                    interface="com.intellij.python.pytools.GenericPyToolManagerProvider"
                    dynamic="true"/>
  </extensionPoints>

  <extensions defaultExtensionNs="com.intellij">
    <statistics.counterUsagesCollector implementationClass="com.intellij.python.pytools.statistics.PyToolUsagesCollector"/>
    <applicationService serviceInterface="com.intellij.python.pytools.PyExecutableCache"
                        serviceImplementation="com.intellij.python.pytools.services.PyExecutableCacheImpl"/>
  </extensions>
</idea-plugin>
