<idea-plugin visibility="internal">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.libraries.eclipse.lsp4j"/>
    <module name="intellij.libraries.eclipse.lsp4j.jsonrpc"/>
    <module name="intellij.libraries.fastutil"/>
    <module name="intellij.libraries.guava"/>
    <module name="intellij.libraries.jackson"/>
    <module name="intellij.libraries.jackson.databind"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.editor.ex"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.ide.progress"/>
    <module name="intellij.platform.lang.impl"/>
    <module name="intellij.platform.lsp"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.projectModel.impl"/>
    <module name="intellij.platform.smRunner"/>
    <module name="intellij.platform.statistics"/>
    <module name="intellij.python.lsp.core"/>
    <module name="intellij.python.pytools"/>
    <module name="intellij.python.pytools.ui"/>
    <module name="intellij.xml.parser"/>
  </dependencies>
  <!-- endregion -->

  <extensions defaultExtensionNs="com.intellij">
    <platform.lsp.integrationProvider implementation="com.intellij.python.ty.TyLspIntegrationProvider"/>
    <statistics.counterUsagesCollector implementationClass="com.intellij.python.ty.TyUsageCollector"/>

    <registryKey key="ty.type.engine.support" defaultValue="false"
                 description="Support ty type engine"/>

    <python.lsp.typeEngineConfigurable implementation="com.intellij.python.ty.typeEngine.TyPyTypeEngine"/>
    <projectSettings service="com.intellij.python.ty.TyConfiguration"/>
    <python.pytools.pyTool implementation="com.intellij.python.ty.TyPyTool"/>
  </extensions>

  <extensions defaultExtensionNs="Pythonid">
    <typeEvalTypeEngineProvider implementation="com.intellij.python.ty.typeEngine.TyLspTypeEngineProvider"/>
  </extensions>
</idea-plugin>
