<idea-plugin visibility="internal">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.libraries.eclipse.lsp4j"/>
    <module name="intellij.libraries.eclipse.lsp4j.jsonrpc"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.ide.observable"/>
    <module name="intellij.platform.lang"/>
    <module name="intellij.platform.lang.impl"/>
    <module name="intellij.platform.lsp"/>
    <module name="intellij.platform.lsp.impl"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.util.ui"/>
    <module name="intellij.python.community.execService"/>
    <module name="intellij.python.community.impl"/>
    <module name="intellij.python.lsp.core.common"/>
    <module name="intellij.python.pyproject"/>
    <module name="intellij.python.pytools.backend"/>
    <module name="intellij.python.pytools.backend.runtime"/>
    <module name="intellij.python.pytools.common"/>
  </dependencies>
  <!-- endregion -->
  <extensionPoints>
    <extensionPoint qualifiedName="com.intellij.python.lsp.notebookLanguageResolver"
                    interface="com.intellij.python.lsp.core.NotebookLanguageResolver"
                    dynamic="true"/>
  </extensionPoints>
  <extensions defaultExtensionNs="com.intellij">
    <completion.contributor language="Python"
                            id="PyLspCompletionContributor"
                            order="first, after pythonConsoleCompletionBlocking, after comboEditor, before pyClassNameCompletionContributor"
                            implementationClass="com.intellij.python.lsp.core.completion.PyLspCompletionContributor"/>

    <notificationGroup id="Python LSP Tools" displayType="STICKY_BALLOON" isLogByDefault="true" bundle="messages.PyBundle"
                       key="notification.group.python.lsp.tools"/>
  </extensions>
</idea-plugin>
