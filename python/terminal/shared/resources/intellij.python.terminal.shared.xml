<idea-plugin>
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <plugin id="org.jetbrains.plugins.terminal"/>
    <module name="intellij.libraries.jetbrains.annotations"/>
    <module name="intellij.libraries.kotlinx.serialization.core"/>
    <module name="intellij.libraries.kotlinx.serialization.json"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.execution"/>
    <module name="intellij.platform.execution.impl"/>
    <module name="intellij.platform.ide"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.kernel"/>
    <module name="intellij.platform.project"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.rpc"/>
    <module name="intellij.platform.rpc.topics"/>
  </dependencies>
  <!-- endregion -->
  <extensions defaultExtensionNs="com.intellij">
    <projectSettings service="com.intellij.python.terminal.shared.PyVirtualEnvTerminalSettings"/>
    <rdct.remoteSettingProvider implementation="com.intellij.python.terminal.shared.PyVirtualEnvTerminalRemoteSettingInfoProvider"/>
    <platform.rpc.projectRemoteTopicListener implementation="com.intellij.python.terminal.shared.PyTerminalCurrentVenvPathTopicListener"/>
  </extensions>
  <extensions defaultExtensionNs="org.jetbrains.plugins.terminal">
    <shellExecOptionsCustomizer implementation="com.intellij.python.terminal.shared.PyVirtualEnvTerminalCustomizerShared"/>
  </extensions>
</idea-plugin>
