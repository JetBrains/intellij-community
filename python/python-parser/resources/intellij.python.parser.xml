<idea-plugin visibility="public">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.libraries.fastutil"/>
    <module name="intellij.libraries.kotlinx.collections.immutable"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.impl"/>
  </dependencies>
  <!-- endregion -->
  <extensions defaultExtensionNs="com.intellij">
    <fileType name="Python"
              language="Python"
              extensions="py;pyw"
              hashBangs="python"
              implementationClass="com.jetbrains.python.PythonFileType"
              fieldName="INSTANCE"/>
    <fileType name="PythonStub"
              language="PythonStub"
              extensions="pyi"
              implementationClass="com.jetbrains.python.pyi.PyiFileType"
              fieldName="INSTANCE"/>
    <registryKey key="python.ast.leaves.incremental.reparse" defaultValue="false"
                 description="Enables incremental reparse for Python leaf elements (string literals, identifiers, comments)"/>
    <registryKey key="python.statement.lists.incremental.reparse" defaultValue="true"
                 description="Enables incremental reparse for statement lists"/>
    <registryKey key="python.statement.lists.incremental.reparse.min.file.chars" defaultValue="20000"
                 description="Minimum file size (chars) below which incremental reparse of Python statement lists is skipped."/>
    <registryKey key="python.statement.lists.incremental.reparse.max.list.chars" defaultValue="10000"
                 description="Hard cap on the statement list size (chars) for incremental reparse."/>
    <registryKey key="python.statement.lists.incremental.reparse.max.ratio.percent" defaultValue="10"
                 description="Maximum statement list size as a percentage of the containing file for incremental reparse."/>
  </extensions>
  <extensionPoints>
    <extensionPoint qualifiedName="Pythonid.dialectsTokenSetContributor"
                    interface="com.jetbrains.python.PythonDialectsTokenSetContributor"
                    dynamic="true"/>
    <extensionPoint qualifiedName="Pythonid.psiElementFactory"
                    interface="com.jetbrains.python.PyPsiElementFactory"
                    dynamic="true"/>
  </extensionPoints>
  <extensions defaultExtensionNs="Pythonid">
    <dialectsTokenSetContributor implementation="com.jetbrains.python.PythonTokenSetContributor"/>
  </extensions>
</idea-plugin>