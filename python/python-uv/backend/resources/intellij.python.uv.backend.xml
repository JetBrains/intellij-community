<idea-plugin visibility="public">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.python.sdk.backend"/>
    <module name="intellij.platform.backend"/>
    <module name="intellij.libraries.jackson3"/>
    <module name="intellij.libraries.jackson3.databind"/>
    <module name="intellij.libraries.jackson3.module.kotlin"/>
    <module name="intellij.libraries.jetbrains.annotations"/>
    <module name="intellij.libraries.kotlinx.serialization.core"/>
    <module name="intellij.libraries.kotlinx.serialization.json"/>
    <module name="intellij.libraries.semver"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.eel.provider"/>
    <module name="intellij.platform.execution"/>
    <module name="intellij.platform.ide"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.remote.core"/>
    <module name="intellij.platform.util.ex"/>
    <module name="intellij.platform.util.progress"/>
    <module name="intellij.python.community"/>
    <module name="intellij.python.community.common"/>
    <module name="intellij.python.community.execService"/>
    <module name="intellij.python.packaging"/>
    <module name="intellij.python.pyproject"/>
    <module name="intellij.python.pytools.backend"/>
    <module name="intellij.python.pytools.backend.runtime"/>
    <module name="intellij.python.requirements.backend"/>
    <module name="intellij.python.requirements.common"/>
    <module name="intellij.python.uv.common"/>
  </dependencies>
  <!-- endregion -->
  <extensions defaultExtensionNs="Pythonid">
    <!-- Uv -->
    <pythonFlavorProvider implementation="com.jetbrains.python.sdk.uv.UvSdkFlavorProvider"/>
    <pythonPackageManagerProvider implementation="com.jetbrains.python.sdk.uv.UvPackageManagerProvider"/>
  </extensions>
  <extensions defaultExtensionNs="com.intellij">
    <python.pytools.pyTool implementation="com.intellij.python.uv.backend.UvPyTool"/>
    <python.pytools.genericPyToolManagerProvider implementation="com.intellij.python.uv.backend.UvToolManagerProvider" order="first"/>
  </extensions>
</idea-plugin>
