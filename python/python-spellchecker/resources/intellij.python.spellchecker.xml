<idea-plugin visibility="public">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.libraries.jetbrains.annotations"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.python.ast"/>
    <module name="intellij.python.psi"/>
    <module name="intellij.python.psi.impl"/>
    <module name="intellij.python.pyproject"/>
    <module name="intellij.python.sdk.backend"/>
    <module name="intellij.spellchecker"/>
  </dependencies>
  <!-- endregion -->

  <extensions defaultExtensionNs="com.intellij.spellchecker">
    <support language="Python" implementationClass="com.jetbrains.python.spellchecker.PythonSpellcheckerStrategy"/>
    <bundledDictionaryProvider implementation="com.jetbrains.python.spellchecker.PythonBundledDictionaryProvider"/>
  </extensions>

  <actions resource-bundle="messages.PySpellcheckerBundle">
    <action id="PythonGenerateDictionaries" class="com.jetbrains.python.spellchecker.PythonSpellcheckerGenerateDictionariesAction"
            internal="true">
      <add-to-group group-id="Internal"/>
    </action>
  </actions>
</idea-plugin>
