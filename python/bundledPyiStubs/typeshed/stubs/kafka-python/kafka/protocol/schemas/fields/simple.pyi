from _typeshed import Incomplete
from typing_extensions import Self

from .base import BaseField

class SimpleField(BaseField):
    TYPES: dict[str, type[Incomplete]]
    @classmethod
    def parse_json(cls, json) -> Self | None: ...
    def __init__(self, json) -> None: ...
    def is_batchable(self) -> bool: ...
    def encode(self, value, version=None, compact: bool = False, tagged: bool = False) -> bytes: ...
    def encode_into(self, value, out, version=None, compact: bool = False, tagged: bool = False) -> None: ...
    def emit_encode_into(self, ctx, val_expr, indent, version=None, compact: bool = False, tagged: bool = False) -> None: ...
    def emit_decode_from(self, ctx, var_name, indent, version=None, compact: bool = False, tagged: bool = False) -> None: ...
    def decode(self, data, version=None, compact: bool = False, tagged: bool = False): ...
    def to_json(self, val): ...
