<idea-plugin visibility="internal">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.libraries.kotlinx.serialization.core"/>
    <module name="intellij.mcpserver"/>
    <module name="intellij.mcpserver.skills"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.python.community.common"/>
    <module name="intellij.python.community.impl"/>
    <module name="intellij.python.community.impl.poetry.backend"/>
    <module name="intellij.python.hatch"/>
    <module name="intellij.python.pyproject"/>
    <module name="intellij.python.sdk.backend"/>
    <module name="intellij.python.uv.backend"/>
  </dependencies>
  <!-- endregion -->

  <extensions defaultExtensionNs="com.intellij">
    <mcpServer.mcpToolset implementation="com.intellij.python.mcp.environment.PythonEnvironmentMcpToolset"/>
    <mcpServer.bundledSkillsProvider implementation="com.intellij.python.mcp.skills.PyCharmBundledSkillsProvider"/>
    <registryKey defaultValue="true"
                 description="Enable the PyCharm python-tools bundled skill (Python environment MCP tools)"
                 key="llm.agents.contrib.pycharm.python.tools.skill.enabled"/>
    <registryKey defaultValue="true"
                 description="Enable the PyCharm code analysis bundled skill"
                 key="llm.agents.contrib.pycharm.code.analysis.skill.enabled"/>
  </extensions>
</idea-plugin>
