# Read more about project view files here:
# https://www.jetbrains.com/help/idea/bazel-project-view.html

dot_idea_directory_location: .idea.bazel

directories:
  .
  -build/download
  -build/dependencies/build/android-sdk
  -config
  -out
  -platform/sqlite/target
  -system
  -test-config
  -test-system

targets:
  //...
  @rules_jvm//...
  @lib//...

run_config_run_with_bazel: false

# those sections are still needed for pre 263 Bazel plugin
# will be removed/migrated in BAZEL-3508
# suppress: deprecation
index_all_files_in_directories: true
# suppress: unsupported_section
use_jetbrains_test_runner: true
# suppress: unsupported_section
java_source_root_optimization_enable: true
# suppress: unsupported_section
java_source_root_optimization_patterns: *

import_run_configurations:
  tools/bazelRunConfigurations/Run___build_android_studio.xml
  tools/bazelRunConfigurations/Run___build_i_build_target.xml
  tools/bazelRunConfigurations/Run___build_idea_community.xml
  tools/bazelRunConfigurations/Run___build_jewel_standalone_sample.xml