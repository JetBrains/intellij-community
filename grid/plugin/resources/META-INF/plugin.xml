<!-- BUILD_USING_BAZEL_MARKER: this plugin is also packaged by the `ij_plugin` Bazel rule, and IjPluginDistributionEquivalenceTest
     checks that the result matches the distribution produced by the build scripts. See MRI-4743. -->
<!--suppress SplitModeMixedDependencies -->
<!--suppress AllContentModulesOptionalLoadingRule -->
<idea-plugin>
  <id>com.intellij.grid</id>
  <name>Data Editor and Viewer</name>
  <vendor>JetBrains</vendor>
  <category>Other Tools</category>
  <description><![CDATA[
    Provides UI component and <b>Settings | Appearance & Behavior | Data Editor and Viewer</b>.
  ]]></description>

  <!-- old ID for Backward compatibility -->
  <module value="intellij.grid.plugin"/>

  <content namespace="jetbrains">
    <module name="intellij.grid" loading="required"/>
    <module name="intellij.grid.core.impl" loading="required"/>
    <module name="intellij.grid.csv.core.impl" loading="required"/>
    <module name="intellij.grid.impl" loading="required"/>
    <module name="intellij.grid.impl.ide"/>
    <module name="intellij.grid.types" loading="required"/>
    <module name="intellij.grid.json.impl"/>
    <module name="intellij.grid.scripting.rt"/>
    <module name="intellij.grid.scripting.impl"/>
    <module name="intellij.grid.images.impl"/>
    <module name="intellij.grid.charts.impl"/>
    <module name="intellij.grid.structureview"/>
  </content>
</idea-plugin>
