<idea-plugin implementation-detail="true">
  <id>com.intellij.idea.customization</id>
  <!--suppress PluginXmlValidity -->
  <name>IntelliJ IDEA Customization</name>
  <description>Brings customizations specific for IntelliJ IDEA to the IDE and to its JetBrains Client</description>
  <vendor>JetBrains</vendor>
  <dependencies>
    <plugin id="com.intellij.modules.platform"/>
  </dependencies>
  <content namespace="jetbrains">
    <module name="intellij.idea.customization.base" loading="required"/>
    <module name="intellij.idea.customization.backend"/>
    <module name="intellij.platform.ide.nonModalWelcomeScreen"/>
    <module name="intellij.platform.ide.nonModalWelcomeScreen.frontend"/>
    <module name="intellij.platform.ide.nonModalWelcomeScreen.backend"/>
    <!-- ultimate-homed modules, skipped in community-based dists -->
    <module name="intellij.idea.customization.ultimate"/>
    <module name="intellij.idea.ultimate.customizationTrial"/>
    <module name="intellij.platform.trialPromotion.common"/>
    <module name="intellij.platform.trialPromotion.idesWithFreeTier"/>
    <module name="intellij.platform.trialPromotion.idesWithFreeTier.jcef" loading="optional"/>
    <module name="intellij.platform.trialPromotion.idesWithFreeTier.welcomeScreen"/>
  </content>
</idea-plugin>
