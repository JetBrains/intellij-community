<idea-plugin>
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.xml.emmet"/>
    <module name="intellij.platform.backend"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.ide"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.lang.impl"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.rpc.backend"/>
    <module name="intellij.platform.util.ui"/>
    <module name="intellij.xml.emmet.shared"/>
  </dependencies>
  <!-- endregion -->

  <extensions defaultExtensionNs="com.intellij">
    <applicationConfigurable groupId="editor" key="emmet.configuration.title" bundle="messages.XmlEmmetBundle"
                             id="reference.idesettings.emmet"
                             dynamic="true" provider="com.intellij.application.options.emmet.EmmetConfigurableProvider"/>
    <lookup.actionProvider implementation="com.intellij.codeInsight.template.emmet.completion.EmmetLookupActionProvider"/>
    <platform.rpc.backend.remoteApiProvider
      implementation="com.intellij.codeInsight.template.emmet.rpc.EmmetAbbreviationBaloonRpcBackendProvider"
      apiInterfaces="com.intellij.xml.emmet.shared.EmmetAbbreviationBaloonRpc"/>
  </extensions>
</idea-plugin>
