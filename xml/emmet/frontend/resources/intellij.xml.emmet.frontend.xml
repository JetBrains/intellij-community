<idea-plugin visibility="public">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="fleet.rpc"/>
    <module name="intellij.platform.frontend"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.rpc.topics"/>
    <module name="intellij.platform.util.coroutines"/>
    <module name="intellij.xml.emmet"/>
    <module name="intellij.xml.emmet.shared"/>
  </dependencies>
  <!-- endregion -->

  <extensions defaultExtensionNs="com.intellij">
    <platform.rpc.projectRemoteTopicListener
      implementation="com.intellij.codeInsight.template.emmet.EmmetAbbreviationBalloonListener"
      topicId="emmet.showAbbreviationBaloon"/>
  </extensions>
</idea-plugin>
