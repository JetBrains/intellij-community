<idea-plugin visibility="internal">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.libraries.kotlin.reflect"/>
    <module name="intellij.libraries.rd.core"/>
    <module name="intellij.libraries.rd.framework"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.bootstrap"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.diagnostic.telemetry"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.execution"/>
    <module name="intellij.platform.ide"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.core.impl"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.lang.core"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.rd.community"/>
    <module name="intellij.platform.runtime.product"/>
    <module name="intellij.platform.statistics"/>
    <module name="intellij.platform.util.coroutines"/>
    <module name="intellij.platform.util.ui"/>
    <module name="intellij.platform.welcomeScreen.impl"/>
    <module name="intellij.remoteDev.util"/>
  </dependencies>
  <!-- endregion -->

  <extensions defaultExtensionNs="com.intellij">
    <applicationService serviceImplementation="com.intellij.remoteDev.tests.impl.LambdaTestHost" preload="true"/>
    <applicationService serviceImplementation="com.intellij.remoteDev.tests.impl.DistributedTestHost" preload="true"/>
    <applicationService serviceInterface="com.intellij.remoteDev.tests.RemoteDevTestModeService"
                        serviceImplementation="com.intellij.remoteDev.tests.impl.RemoteDevTestModeServiceImpl"/>
  </extensions>
</idea-plugin>
