<idea-plugin visibility="internal">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.libraries.bouncy.castle.pgp"/>
    <module name="intellij.libraries.download.pgp.verifier"/>
    <module name="intellij.libraries.gson"/>
    <module name="intellij.libraries.jackson3"/>
    <module name="intellij.libraries.jackson3.databind"/>
    <module name="intellij.libraries.jna"/>
    <module name="intellij.libraries.kotlin.reflect"/>
    <module name="intellij.libraries.kotlinx.serialization.core"/>
    <module name="intellij.libraries.kotlinx.serialization.json"/>
    <module name="intellij.libraries.miglayout.swing"/>
    <module name="intellij.libraries.opentelemetry"/>
    <module name="intellij.libraries.opentelemetry.semconv"/>
    <module name="intellij.libraries.rd.core"/>
    <module name="intellij.libraries.rd.framework"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.bootstrap"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.diagnostic.telemetry"/>
    <module name="intellij.platform.diagnostic.telemetry.impl"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.execution"/>
    <module name="intellij.platform.ide"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.core.impl"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.ide.progress"/>
    <module name="intellij.platform.lang.core"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.rd.community"/>
    <module name="intellij.platform.runtime.product"/>
    <module name="intellij.platform.statistics"/>
    <module name="intellij.platform.util.coroutines"/>
    <module name="intellij.platform.util.ui"/>
    <module name="intellij.platform.welcomeScreen.impl"/>
  </dependencies>
  <!-- endregion -->
  <extensionPoints>
    <extensionPoint qualifiedName="com.intellij.remoteDev.configureClientHook" interface="com.intellij.remoteDev.downloader.ConfigureClientHook" dynamic="true"/>
  </extensionPoints>
  <extensions defaultExtensionNs="com.intellij">
    <statistics.counterUsagesCollector implementationClass="com.intellij.remoteDev.downloader.RemoteDevStatisticsCollector"/>
    <applicationService serviceInterface="com.intellij.remoteDev.downloader.JetBrainsClientDownloaderConfigurationProvider"
                        serviceImplementation="com.intellij.remoteDev.downloader.RealJetBrainsClientDownloaderConfigurationProvider"
                        testServiceImplementation="com.intellij.remoteDev.downloader.TestJetBrainsClientDownloaderConfigurationProvider"/>
    <openTelemetryExporterProvider implementation="com.intellij.remoteDev.tracing.RdctExportersProvider"/>
    <openTelemetryExporterProvider implementation="com.intellij.remoteDev.tracing.LuxExportersProvider"/>
    <applicationInitializedListener implementation="com.intellij.remoteDev.tracing.CustomExportersListener"/>
    <registryKey key="rdct.use.embedded.client" defaultValue="true"
                 description="Enable to run JetBrains Client process from the current IDE instead of downloading it when connecting to an IDE of same version"/>
    <registryKey key="rdct.always.use.embedded.client" defaultValue="false"
                 description="Enable to run embedded client unconditionally
                              (may have compatibility problems if the backend and client protocols do not match)"/>
    <registryKey key="rdct.path.to.custom.snapshot.frontend.installation" defaultValue=""
                 description="Specifies path to a standalone frontend installation (JetBrains Client) which will be used while connecting to backends with *.snapshot build numbers"/>
    <registryKey key="rdct.embedded.client.debug.port" defaultValue="-1"
                 description="Specify a positive value to make a client process started from an IDE listen for debug connections on that port."/>
    <registryKey key="rdct.embedded.client.debug.suspend" defaultValue="false"
                 description="Enable this option to suspend a client process started from an IDE until a debugger connects to it."/>
    <registryKey key="rdct.embedded.client.prefer.jetrains_client64.exe" defaultValue="true"
                 description="Disable this option to start JetBrains Client process on Windows from a full IDE using the IDE's launcher instead of a special jetbrains_client64.exe launcher."/>
    <registryKey key="rdct.use.native.client.launcher.on.linux" defaultValue="true"
                 description="If enabled, the native launcher is used to run JetBrains Client process on Linux instead of jetbrains_client.sh script"/>
  </extensions>
</idea-plugin>