      <with attribute="implementationClass" implements="com.intellij.packageDependencies.DependencyVisitorFactory"/>
    </extensionPoint>
    <extensionPoint qualifiedName="com.intellij.filetype.prebuiltStubsProvider" beanClass="com.intellij.openapi.fileTypes.FileTypeExtensionPoint" dynamic="true">
      <with attribute="implementationClass" implements="com.intellij.psi.stubs.PrebuiltStubsProvider"/>
    </extensionPoint>
    <extensionPoint qualifiedName="com.intellij.highlightInfoPostFilter" interface="com.intellij.codeInsight.daemon.impl.HighlightInfoPostFilter" area="IDEA_PROJECT" dynamic="true"/>
    <extensionPoint qualifiedName="com.intellij.internalHighlightingLayerSupplier" interface="com.intellij.codeInsight.daemon.impl.InternalLayerSupplier" dynamic="true"/>
