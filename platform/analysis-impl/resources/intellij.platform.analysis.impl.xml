  <xi:include href="/META-INF/AnalysisImpl.analyzer.xml"/>
  <extensionPoints>
    <extensionPoint qualifiedName="com.intellij.highlightingPassFactory" interface="com.intellij.codeHighlighting.TextEditorHighlightingPassFactoryRegistrar" dynamic="true"/>
