    <extensionPoint qualifiedName="com.intellij.highlightRangeExtension" interface="com.intellij.codeInsight.daemon.impl.HighlightRangeExtension" dynamic="true"/>
    <extensionPoint qualifiedName="com.intellij.silentChangeVetoer" interface="com.intellij.codeInsight.daemon.impl.SilentChangeVetoer" dynamic="true" />
    <extensionPoint qualifiedName="com.intellij.referenceImporter" interface="com.intellij.codeInsight.daemon.ReferenceImporter" dynamic="true"/>
    <extensionPoint qualifiedName="com.intellij.templateCompletionProcessor" interface="com.intellij.codeInsight.template.macro.TemplateCompletionProcessor" dynamic="true"/>
    <extensionPoint qualifiedName="com.intellij.idIndexer" beanClass="com.intellij.openapi.fileTypes.FileTypeExtensionPoint" dynamic="true">
      <with attribute="implementationClass" implements="com.intellij.psi.impl.cache.impl.id.IdIndexer"/>
    </extensionPoint>
    <extensionPoint qualifiedName="com.intellij.todoExtraPlaces" interface="com.intellij.psi.impl.cache.impl.todo.TodoIndexers$ExtraPlaceChecker" dynamic="true"/>
