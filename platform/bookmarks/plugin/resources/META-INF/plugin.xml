<!-- BUILD_USING_BAZEL_MARKER: this plugin is also packaged by the `ij_plugin` Bazel rule, and IjPluginDistributionEquivalenceTest
     checks that the result matches the distribution produced by the build scripts. See IJPL-251444. -->
<!--suppress SplitModeMixedDependencies -->
<idea-plugin>
  <id>com.intellij.bookmarks</id>
  <name>Bookmarks</name>
  <vendor>JetBrains</vendor>
  <description><![CDATA[
    Marks lines of code, files, folders, classes, and editor tabs for quick navigation,
    supports anonymous and mnemonic bookmarks accessible via keyboard shortcuts,
    and organizes them into named lists in a dedicated tool window.
  ]]></description>

  <!-- old ID for Backward compatibility -->
  <module value="intellij.bookmarks.plugin"/>

  <content namespace="jetbrains">
    <module name="intellij.platform.bookmarks" loading="required"/>
    <module name="intellij.platform.bookmarks.backend"/>
    <module name="intellij.platform.bookmarks.frontend"/>
    <module name="intellij.platform.debugger.impl.bookmarks"/>
    <module name="intellij.platform.vcs.log.impl.bookmarks" loading="optional"/>
  </content>
</idea-plugin>
