<idea-plugin>
  <dependencies>
    <module name="intellij.platform.backend"/>
    <module name="intellij.platform.statistics.devkit"/>
  </dependencies>

  <resource-bundle>messages.ActionsBundle</resource-bundle>
  <extensions defaultExtensionNs="com.intellij">
    <!-- Shared implementation; in remote development, the backend window is projected into the client (IJPL-149684). -->
    <!--suppress PluginXmlRegistrationCheck, SplitModeXmlApiUsage -->
    <toolWindow id="Statistics Event Log (On Host)"
                factoryClass="com.intellij.platform.statistics.devkit.toolwindow.StatisticsEventLogToolWindowFactory"
                anchor="bottom" canCloseContents="true" order="last"/>
  </extensions>
</idea-plugin>
