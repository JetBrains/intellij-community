<idea-plugin visibility="internal">
  <dependencies>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.frontend"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.todo"/>
  </dependencies>
  <resource-bundle>messages.TodoBundle</resource-bundle>

  <actions>
    <action id="TodoViewEditSource" class="com.intellij.platform.todo.frontend.TodoEditSourceAction"
            icon="AllIcons.Actions.EditSource" use-shortcut-of="EditSource"/>
  </actions>
</idea-plugin>
