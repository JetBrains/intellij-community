<idea-plugin visibility="internal">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.platform.concurrency"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.util.ex"/>
  </dependencies>
  <!-- endregion -->
  <extensions defaultExtensionNs="com.intellij">
    <applicationService
      open="true"
      serviceInterface="com.intellij.credentialStore.CredentialStoreManager"
      serviceImplementation="com.intellij.credentialStore.CredentialStoreManagerImpl"
    />
  </extensions>
</idea-plugin>