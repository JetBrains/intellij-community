<idea-plugin visibility="internal" package="com.intellij.platform.project.backend">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.backend"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.ide"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.rpc"/>
    <module name="intellij.platform.project"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.rpc.backend"/>
  </dependencies>
  <!-- endregion -->

  <extensions defaultExtensionNs="com.intellij">
    <platform.rpc.backend.remoteApiProvider implementation="com.intellij.platform.project.backend.module.ModuleStateApiProvider"
                                            apiInterfaces="com.intellij.platform.project.module.ModuleStateApi"/>
    <platform.rpc.backend.remoteApiProvider implementation="com.intellij.platform.project.backend.OpenFileChooserApiProvider"
                                            apiInterfaces="com.intellij.platform.project.OpenFileChooserApi"/>
  </extensions>
</idea-plugin>