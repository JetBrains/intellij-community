<idea-plugin visibility="internal">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="fleet.rhizomedb"/>
    <module name="intellij.libraries.kotlinx.coroutines.core"/>
    <module name="intellij.libraries.kotlinx.serialization.core"/>
    <module name="intellij.libraries.kotlinx.serialization.json"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.kernel"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.util.coroutines"/>
    <module name="intellij.platform.util.ex"/>
    <module name="intellij.platform.util.ui"/>
    <module name="intellij.platform.workspace.jps"/>
  </dependencies>
  <!-- endregion -->
  <extensions defaultExtensionNs="com.intellij">
    <applicationSettings service="com.intellij.ide.GeneralSettings"/>
    <applicationService serviceImplementation="com.intellij.ide.GeneralSettings"/>
    <applicationService serviceImplementation="com.intellij.platform.ide.core.customization.IdeLifecycleUiCustomization" open="true"/>
    <applicationService serviceImplementation="com.intellij.platform.ide.core.customization.ProjectLifecycleUiCustomization" open="true"/>
    <applicationSettings service="com.intellij.ide.GeneralLocalSettings"/>
    <applicationService serviceInterface="com.intellij.execution.sudo.SudoCommandProvider" open="true"
                        serviceImplementation="com.intellij.execution.sudo.LocalSudoCommandProvider"/>
  </extensions>
  <extensionPoints>
    <extensionPoint qualifiedName="com.intellij.applicationInitializedListener" interface="com.intellij.ide.ApplicationInitializedListener" dynamic="false"/>
    <!-- The platform skips such listeners on dynamic loading/unloading of plugins assuming it is safe -->
    <extensionPoint qualifiedName="com.intellij.dynamicApplicationInitializedListener" interface="com.intellij.ide.ApplicationInitializedListener" dynamic="true"/>
    <extensionPoint qualifiedName="com.intellij.applicationActivity" interface="com.intellij.ide.ApplicationActivity" dynamic="false"/>
    <extensionPoint qualifiedName="com.intellij.registryKey" beanClass="com.intellij.openapi.util.registry.RegistryKeyBean" dynamic="true"/>
    <extensionPoint qualifiedName="com.intellij.registry.managed" interface="com.intellij.openapi.util.registry.ManagedRegistry" dynamic="false"/>
    <extensionPoint qualifiedName="com.intellij.applicationSettings"
                    beanClass="com.intellij.ide.settings.SettingsComponentDescriptor"
                    dynamic="true">
      <with attribute="service" implements="com.intellij.openapi.components.PersistentStateComponent"/>
    </extensionPoint>
    <extensionPoint qualifiedName="com.intellij.projectSettings"
                    beanClass="com.intellij.ide.settings.SettingsComponentDescriptor"
                    area="IDEA_PROJECT"
                    dynamic="true">
      <with attribute="service" implements="com.intellij.openapi.components.PersistentStateComponent"/>
    </extensionPoint>
    <extensionPoint qualifiedName="com.intellij.appStarter" beanClass="com.intellij.openapi.application.ApplicationStarterEP" dynamic="true">
      <with attribute="implementation" implements="com.intellij.openapi.application.ApplicationStarter"/>
    </extensionPoint>
    <extensionPoint qualifiedName="com.intellij.projectConfigurable"
                    beanClass="com.intellij.openapi.options.ConfigurableEP"
                    area="IDEA_PROJECT"
                    dynamic="true">
      <with attribute="instance" implements="com.intellij.openapi.options.Configurable"/>
    </extensionPoint>
    <extensionPoint qualifiedName="com.intellij.applicationConfigurable"
                    dynamic="true"
                    beanClass="com.intellij.openapi.options.ConfigurableEP">
      <with attribute="instance" implements="com.intellij.openapi.options.Configurable"/>
    </extensionPoint>
    <extensionPoint qualifiedName="com.intellij.fileTypeFactory"
                    interface="com.intellij.openapi.fileTypes.FileTypeFactory" dynamic="false"/>
    <extensionPoint qualifiedName="com.intellij.fileTypeRegistrar" interface="com.intellij.ide.highlighter.FileTypeRegistrar" dynamic="false"/>
    <extensionPoint qualifiedName="com.intellij.eventLogCategory" interface="com.intellij.notification.EventLogCategory" dynamic="true"/>
    <extensionPoint qualifiedName="com.intellij.projectAttachProcessor" interface="com.intellij.projectImport.ProjectAttachProcessor" dynamic="true"/>
    <extensionPoint qualifiedName="com.intellij.cachesInvalidator" interface="com.intellij.ide.caches.CachesInvalidator" dynamic="true"/>
    <extensionPoint qualifiedName="com.intellij.notificationRemindLaterHandler" interface="com.intellij.notification.NotificationRemindLaterHandler" dynamic="true"/>
    <extensionPoint qualifiedName="com.intellij.notificationRouter" interface="com.intellij.notification.NotificationRouter" dynamic="true"/>
    <extensionPoint qualifiedName="com.intellij.universalFileChooserContributor"
                    interface="com.intellij.openapi.fileChooser.universal.UniversalFileChooserContributor"
                    dynamic="true"/>
  </extensionPoints>
  <applicationListeners>
    <listener class="com.intellij.openapi.fileTypes.StdFileTypes$StdFileTypesUpdater" activeInHeadlessMode="true" activeInTestMode="false"
              topic="com.intellij.openapi.fileTypes.FileTypeListener"/>
  </applicationListeners>
</idea-plugin>
