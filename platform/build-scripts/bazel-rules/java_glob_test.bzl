def _records_test_impl(ctx):
    env = unittest.begin(ctx)
    for pattern, name, expected in _RECORDS:
        asserts.equals(env, expected, java_glob_matches(java_glob(pattern, "test"), name), "%s against %s" % (pattern, name))
    return unittest.end(env)

_records_test = unittest.make(_records_test_impl)

def _destinations_test_impl(ctx):
    """Only a destination below the plugin directory takes part, and a pattern matches its plugin-relative path."""
    env = unittest.begin(ctx)
    destinations = ["plugins/x/bin/tool", "plugins/x/bin/a/b", "plugins/xy/bin/tool", "bin/tool", "plugins/x/lib/x.jar"]
    asserts.equals(env, ["plugins/x/bin/a/b", "plugins/x/bin/tool"], executable_destinations(["bin/**"], "test", "plugins/x", destinations))
    asserts.equals(env, ["plugins/x/bin/tool"], executable_destinations(["bin/*", "none"], "test", "plugins/x", destinations))
    asserts.equals(env, [], executable_destinations([], "test", "plugins/x", destinations))
    return unittest.end(env)

_destinations_test = unittest.make(_destinations_test_impl)

def java_glob_test_suite(name):
    unittest.suite(name, _records_test, _destinations_test)
