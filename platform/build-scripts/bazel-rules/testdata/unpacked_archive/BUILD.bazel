# The fixture of an unpacked archive. It mirrors the BUILD file of a `extracted_download_repo`: each file is exported
# by its path below the package, and `files` groups them. The executable list stays out of `files`.
package(default_visibility = ["//platform/build-scripts/bazel-rules:__pkg__"])

files = glob(
    ["**"],
    exclude = [
        "BUILD.bazel",
        "executables.json",
    ],
)

exports_files(files + ["executables.json"])

filegroup(
    name = "files",
    srcs = files,
)
