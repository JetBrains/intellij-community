load("@community//build:tests-options.bzl", "jps_test")
load("@rules_java//java:defs.bzl", "java_binary")
load("@rules_jvm//:jvm.bzl", "jvm_library")

java_binary(
    name = "generate_icon_classes",
    main_class = "org.jetbrains.intellij.build.images.GenerateIconClassesKt",
    runtime_deps = [":images-build"],
)

jps_test(
    name = "images-build-tests_test_smoke",
    timeout = "moderate",
    env = {
        "JB_TEST_JUNIT5_FILTERS": "include-classname=org.jetbrains.intellij.build.images.CommunityIconClassesTest;include-classname=org.jetbrains.intellij.build.images.CommunityImageResourcesSanityTest",
    },
    tags = ["ultimate-smoke"],
    runtime_deps = [":images-build-tests_test_lib"],
)

jps_test(
    name = "images-build-tests_test",
    timeout = "moderate",
    tags = ["community-aggregator"],
    runtime_deps = [":images-build-tests_test_lib"],
)

