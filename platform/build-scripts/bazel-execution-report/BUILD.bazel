# Reports where the actions came from, and the largest blobs the Bazel remote cache can hold, from compact Bazel execution logs.
# Write the logs first:
#
#   ./bazel-build-all.cmd --execution_log_compact_file=<file>
#
# Then read them. The tool reads one log, or every `*.zst` file directly in a directory, and merges the logs into one report.
# The path is resolved against the directory Bazel runs the binary in, so pass an absolute one.
# From the root of the ultimate repository, the label is `@community//platform/build-scripts/bazel-execution-report:bazel_execution_report`.
#
#   ./bazel.cmd run //platform/build-scripts/bazel-execution-report:bazel_execution_report -- <exec log or directory with them> [--largest-blobs-count N] [--blob-size-limit-mb N] [--blob-size-limit-extensions LIST] [--html-report-path FILE]
java_binary(
    name = "bazel_execution_report",
    main_class = "com.intellij.platform.buildScripts.bazelExecutionReport.BazelExecutionReport",
    visibility = ["//visibility:public"],
    runtime_deps = [":bazel-execution-report"],
)

