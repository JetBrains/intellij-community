<idea-plugin visibility="public">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.libraries.kotlinx.collections.immutable"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.projectModel"/>
  </dependencies>
  <!-- endregion -->
  <extensionPoints>
    <extensionPoint qualifiedName="com.intellij.documentMerger" interface="com.intellij.formatting.service.DocumentMerger" dynamic="true"/>
    <extensionPoint qualifiedName="com.intellij.lineIndentProvider" interface="com.intellij.psi.codeStyle.lineIndent.LineIndentProvider" dynamic="true"/>
    <extensionPoint qualifiedName="com.intellij.formatting.injectedOptions" interface="com.intellij.formatting.InjectedFormattingOptionsProvider" dynamic="true"/>
    <extensionPoint qualifiedName="com.intellij.predefinedCodeStyle" interface="com.intellij.psi.codeStyle.PredefinedCodeStyle" dynamic="true"/>
    <extensionPoint qualifiedName="com.intellij.fileSetDescriptorFactory" interface="com.intellij.formatting.fileSet.FileSetDescriptorFactory" dynamic="true"/>
  </extensionPoints>
  <extensions defaultExtensionNs="com.intellij">
    <applicationService serviceImplementation="com.intellij.psi.codeStyle.AppCodeStyleSettingsManager"/>
    <projectService serviceImplementation="com.intellij.psi.codeStyle.ProjectCodeStyleSettingsManager" preload="true"/>
  </extensions>
</idea-plugin>
