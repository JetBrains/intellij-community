<idea-plugin visibility="public">
  <module value="com.intellij.platform.ide.impl.wsl"/>

  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.libraries.caffeine"/>
    <module name="intellij.libraries.jetbrains.annotations"/>
    <module name="intellij.libraries.pty4j"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.diagnostic.telemetry.impl"/>
    <module name="intellij.platform.eel.nioFs.impl"/>
    <module name="intellij.platform.execution"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.util.coroutines"/>
    <module name="intellij.platform.util.ex"/>
    <module name="intellij.platform.util.ui"/>
  </dependencies>
  <!-- endregion -->

  <extensions defaultExtensionNs="com.intellij">
    <platform.eel.impl.portAccessibleLocally implementation="com.intellij.platform.ide.impl.wsl.WslEelPortAccessibleLocally"/>
    <eelEnvironmentInitializer implementation="com.intellij.platform.ide.impl.wsl.WslEelEnvironmentInitializer" os="windows"/>
    <eelAlternativeRootProvider implementation="com.intellij.platform.ide.impl.wsl.WslEelAlternativeRootProvider" os="windows"/>
    <eelMachineResolver implementation="com.intellij.platform.ide.impl.wsl.WslEelMachineResolver" os="windows"/>
    <applicationService serviceInterface="com.intellij.execution.wsl.WslIjentManager"
                        serviceImplementation="com.intellij.platform.ide.impl.wsl.ProductionWslIjentManager"/>
    <multiRoutingFileSystemBackend implementation="com.intellij.platform.ide.impl.wsl.EelWslMrfsBackend" os="windows"/>
    <universalFileChooserContributor os="windows" implementation="com.intellij.platform.ide.impl.wsl.fileChooser.WslFileChooserContributor"/>
  </extensions>
</idea-plugin>