<idea-plugin visibility="public">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="fleet.util.core"/>
    <module name="intellij.libraries.jetbrains.annotations"/>
    <module name="intellij.libraries.kotlinx.coroutines.core"/>
    <module name="intellij.libraries.kotlinx.serialization.core"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.ide"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.progress"/>
    <module name="intellij.platform.project"/>
    <module name="intellij.platform.rpc.lite"/>
    <module name="intellij.platform.settings.v2"/>
    <module name="intellij.platform.settings.v2.shared"/>
  </dependencies>
  <!-- endregion -->
  <extensions defaultExtensionNs="com.intellij">
    <applicationService serviceInterface="com.intellij.platform.settings.v2.impl.ShutdownSaver"
                        serviceImplementation="com.intellij.platform.settings.v2.impl.ModalShutdownSaver"/>
  </extensions>
  <actions resource-bundle="messages.SettingsV2Bundle">
    <action id="internal.settings.v2.DumpSettingsContext" internal="true"
            class="com.intellij.platform.settings.v2.impl.SettingsContextDumpAction"/>
  </actions>
</idea-plugin>
