<idea-plugin visibility="public">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.libraries.jetbrains.annotations"/>
    <module name="intellij.libraries.kotlinx.coroutines.core"/>
    <module name="intellij.libraries.kotlinx.serialization.core"/>
    <module name="intellij.platform.core"/>
  </dependencies>
  <!-- endregion -->
  <extensionPoints>
    <extensionPoint qualifiedName="com.intellij.settings.v2.keyPrefix"
                    beanClass="com.intellij.platform.settings.v2.SettingsKeyPrefixBean"
                    dynamic="true"/>
    <extensionPoint qualifiedName="com.intellij.settings.v2.layerProvider"
                    interface="com.intellij.platform.settings.v2.LayerProvider"
                    dynamic="true"/>
  </extensionPoints>
</idea-plugin>
