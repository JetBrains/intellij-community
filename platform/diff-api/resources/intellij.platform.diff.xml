<idea-plugin visibility="internal">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.libraries.kotlinx.collections.immutable"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.util.diff"/>
    <module name="intellij.platform.util.ui"/>
  </dependencies>
  <!-- endregion -->
  <extensionPoints>
    <!--suppress PluginXmlValidity -->
    <extensionPoint qualifiedName="com.intellij.diff.DiffTool" interface="com.intellij.diff.DiffTool" dynamic="true"/>
    <!--suppress PluginXmlValidity -->
    <extensionPoint qualifiedName="com.intellij.diff.merge.MergeTool" interface="com.intellij.diff.merge.MergeTool" dynamic="true"/>
    <!--suppress PluginXmlValidity -->
    <extensionPoint qualifiedName="com.intellij.diff.DiffExtension" interface="com.intellij.diff.DiffExtension" dynamic="true"/>
    <extensionPoint name="diff.frontendDiffExtension" interface="com.intellij.diff.frontend.FrontendDiffExtension" dynamic="true"/>
    <extensionPoint name="diff.frontendUserDataKey" interface="com.intellij.diff.frontend.FrontendDiffUserDataKeyDescriptor" dynamic="true"/>
    <!--suppress PluginXmlValidity -->
    <extensionPoint qualifiedName="com.intellij.diff.merge.external.AutomaticExternalMergeTool" interface="com.intellij.diff.merge.external.AutomaticExternalMergeTool" dynamic="true"/>
    <extensionPoint qualifiedName="com.intellij.diffPreviewProvider" interface="com.intellij.openapi.diff.impl.settings.DiffPreviewProvider"/>
  </extensionPoints>
  <extensions defaultExtensionNs="com.intellij">
    <applicationService serviceImplementation="com.intellij.diff.DiffApplicationSettings"/>
  </extensions>
</idea-plugin>