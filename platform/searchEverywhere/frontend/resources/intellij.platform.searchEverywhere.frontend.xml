<idea-plugin visibility="public" package="com.intellij.platform.searchEverywhere.frontend">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.platform.frontend"/>
    <module name="fleet.rpc"/>
    <module name="intellij.libraries.jetbrains.annotations"/>
    <module name="intellij.libraries.kotlinx.coroutines.core"/>
    <module name="intellij.libraries.kotlinx.serialization.core"/>
    <module name="intellij.libraries.kotlinx.serialization.json"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.credentialStore"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.ide.observable"/>
    <module name="intellij.platform.ide.rpc"/>
    <module name="intellij.platform.indexing"/>
    <module name="intellij.platform.lang"/>
    <module name="intellij.platform.lang.impl"/>
    <module name="intellij.platform.project"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.refactoring"/>
    <module name="intellij.platform.runtime.product"/>
    <module name="intellij.platform.searchEverywhere"/>
    <module name="intellij.platform.statistics"/>
    <module name="intellij.platform.usageView"/>
    <module name="intellij.platform.usageView.impl"/>
    <module name="intellij.platform.util.coroutines"/>
    <module name="intellij.platform.util.ui"/>
    <module name="intellij.platform.welcomeScreen"/>
  </dependencies>
  <!-- endregion -->

  <actions resource-bundle="messages.searchEverywhereFrontendBundle">
    <action id="SeNewSearchToggleAction"
            class="com.intellij.platform.searchEverywhere.frontend.actions.SeNewSearchToggleAction"
            internal="true"
    />
    <action id="SeSetOpenAiKeyAction"
            class="com.intellij.platform.searchEverywhere.frontend.actions.SeSetOpenAiKeyAction"
            internal="true"
    />
    <action id="SeSetJevKeyAction"
            class="com.intellij.platform.searchEverywhere.frontend.actions.SeSetJevKeyAction"
            internal="true"
    />
    <action id="SearchEverywhereComponent"
            class="com.intellij.platform.searchEverywhere.frontend.toolbar.SearchEverywhereComponentAction"
            icon="AllIcons.Actions.Search"
    />
  </actions>

  <extensionPoints>
    <extensionPoint name="searchEverywhere.tabFactory"
                    interface="com.intellij.platform.searchEverywhere.frontend.SeTabFactory"
                    dynamic="true"/>

    <extensionPoint name="searchEverywhere.mlService"
                    interface="com.intellij.platform.searchEverywhere.frontend.ml.SeMlService"
                    dynamic="true"/>
    <extensionPoint name="searchEverywhere.previewPanelListener"
                    interface="com.intellij.platform.searchEverywhere.frontend.ui.SePreviewPanelListener"
                    dynamic="true"/>
    <extensionPoint name="searchEverywhere.actionsRanker"
                    interface="com.intellij.platform.searchEverywhere.frontend.providers.actions.SeActionsRanker"
                    dynamic="true"/>
    <extensionPoint name="searchEverywhere.decisionsEndpointProvider"
                    interface="com.intellij.platform.searchEverywhere.frontend.providers.actions.SeDecisionsEndpointProvider"
                    dynamic="true"/>
  </extensionPoints>

  <extensions defaultExtensionNs="com.intellij">
    <searchEverywhere.manager implementation="com.intellij.platform.searchEverywhere.frontend.RemDevFriendlySearchEverywhereManager"/>

    <searchEverywhere.itemsProviderFactory implementation="com.intellij.platform.searchEverywhere.frontend.providers.actions.SeActionsProviderFactory"/>
    <searchEverywhere.itemsProviderFactory implementation="com.intellij.platform.searchEverywhere.frontend.providers.actions.SeRankerActionsProviderFactory"/>
    <registryKey key="search.everywhere.actions.ranker"
                 defaultValue=""
                 restartRequired="false"
                 description="The id of the ranker that finds actions for natural-language queries in the Actions tab of Search Everywhere. An empty value turns the ranker off. The value 'decisions' selects the OpenAI Decision API. The value 'jev' selects a Jev model of TypeSafe. The value 'mock' selects a local ranker for development."/>
    <registryKey key="search.everywhere.actions.ranker.candidates"
                 defaultValue="[popularity*|splitAndMerge|unlimited]"
                 restartRequired="false"
                 description="How the actions ranker of Search Everywhere gets the candidates when there are more candidates than the ranker accepts. 'popularity' sends only the most popular actions. 'splitAndMerge' ranks all actions in parts, then ranks the best actions of all parts again. 'unlimited' sends all actions in one call."/>
    <registryKey key="search.everywhere.actions.ranker.debounce.ms"
                 defaultValue="400"
                 restartRequired="false"
                 description="How long the actions ranker of Search Everywhere waits after the last keystroke before it sends the query, in milliseconds. A new keystroke cancels the wait. The value applies from the next popup."/>
    <registryKey key="search.everywhere.actions.ranker.decisions.model"
                 defaultValue="gpt-6-luna"
                 restartRequired="false"
                 description="The model of the Decision API ranker of Search Everywhere. An empty value selects gpt-6-luna."/>
    <searchEverywhere.actionsRanker implementation="com.intellij.platform.searchEverywhere.frontend.providers.actions.SeDecisionsActionsRanker"/>
    <registryKey key="search.everywhere.actions.ranker.jev.model"
                 defaultValue=""
                 restartRequired="false"
                 description="The model of the Jev ranker of Search Everywhere. An empty value selects jev-latest for a TypeSafe key and ~typesafe/jev-latest for an OpenRouter key."/>
    <searchEverywhere.actionsRanker implementation="com.intellij.platform.searchEverywhere.frontend.providers.actions.SeJevActionsRanker"/>
    <notificationGroup id="Search Everywhere Actions Ranker"
                       displayType="BALLOON"
                       bundle="messages.searchEverywhereFrontendBundle"
                       key="notification.group.search.everywhere.actions.ranker"/>
    <searchEverywhere.decisionsEndpointProvider order="first"
                                                implementation="com.intellij.platform.searchEverywhere.frontend.providers.actions.SeOpenAiDecisionsEndpointProvider"/>
    <!--<searchEverywhere.actionsRanker implementation="com.intellij.platform.searchEverywhere.frontend.providers.actions.SeMockActionsRanker"/>-->

    <searchEverywhere.tabFactory implementation="com.intellij.platform.searchEverywhere.frontend.tabs.all.SeAllTabFactory"/>
    <searchEverywhere.tabFactory implementation="com.intellij.platform.searchEverywhere.frontend.tabs.classes.SeClassesTabFactory"/>
    <searchEverywhere.tabFactory implementation="com.intellij.platform.searchEverywhere.frontend.tabs.files.SeFilesTabFactory"/>
    <searchEverywhere.tabFactory implementation="com.intellij.platform.searchEverywhere.frontend.tabs.symbols.SeSymbolsTabFactory"/>
    <searchEverywhere.tabFactory implementation="com.intellij.platform.searchEverywhere.frontend.tabs.actions.SeActionsTabFactory"/>
    <searchEverywhere.tabFactory implementation="com.intellij.platform.searchEverywhere.frontend.tabs.text.SeTextTabFactory"/>

    <applicationService serviceInterface="com.intellij.platform.searchEverywhere.frontend.SeTabsCustomizer"
                        serviceImplementation="com.intellij.platform.searchEverywhere.frontend.SeDefaultTabsCustomizer"
                        open="true"/>"
  </extensions>
</idea-plugin>