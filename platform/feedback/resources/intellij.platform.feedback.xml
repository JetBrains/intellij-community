<idea-plugin visibility="public">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.libraries.kotlinx.datetime"/>
    <module name="intellij.libraries.kotlinx.serialization.core"/>
    <module name="intellij.libraries.kotlinx.serialization.json"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.core.impl"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.ide.observable"/>
    <module name="intellij.platform.ide.progress"/>
    <module name="intellij.platform.lang"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.statistics"/>
    <module name="intellij.platform.util.ui"/>
  </dependencies>
  <!-- endregion -->
  <extensionPoints>
    <extensionPoint qualifiedName="com.intellij.feedback.idleFeedbackSurvey" interface="com.intellij.platform.feedback.FeedbackSurvey"
                    dynamic="true"/>
    <extensionPoint qualifiedName="com.intellij.platform.feedback.csat.feedbackExtraDataProvider"
                    interface="com.intellij.platform.feedback.csat.CsatFeedbackExtraDataProvider" dynamic="true"/>
  </extensionPoints>

  <extensions defaultExtensionNs="com.intellij">
    <applicationService serviceInterface="com.intellij.platform.ide.impl.feedback.PlatformFeedbackDialogs"
                        serviceImplementation="com.intellij.platform.feedback.impl.PlatformFeedbackDialogsImpl"
                        overrides="true"/>

    <applicationService serviceImplementation="com.intellij.platform.feedback.impl.state.DontShowAgainFeedbackService"/>
    <applicationService serviceImplementation="com.intellij.platform.feedback.eap.EAPFeedbackUrlProvider" open="true"/>

    <notificationGroup displayType="BALLOON" id="Feedback In IDE" bundle="messages.CommonFeedbackMessagesBundle"
                       key="notification.group.feedback"/>

    <notificationGroup displayType="STICKY_BALLOON" id="STICKY:Feedback In IDE" bundle="messages.CommonFeedbackMessagesBundle"
                       key="notification.group.feedback.sticky"/>

    <typedHandler implementation="com.intellij.platform.feedback.impl.track.EditorInputEventTracker"/>
    <editorFactoryMouseListener implementation="com.intellij.platform.feedback.impl.track.EditorInputEventTracker"/>
    <editorFactoryMouseMotionListener implementation="com.intellij.platform.feedback.impl.track.EditorInputEventTracker"/>

    <registryKey key="platform.feedback" defaultValue="true" description="Enable to collect user feedback"/>
    <registryKey key="platform.feedback.time.to.show.notification" defaultValue="600"
                 description="Explicitly sets the number of seconds until the feedback notification is displayed."/>
    <registryKey key="platform.feedback.ignore.common.conditions.for.all.surveys" defaultValue="false"
                 description="Allows to ignore all isSuitableToShow conditions and test pure conditions of the concrete survey"/>

    <statistics.validation.customValidationRule
      implementation="com.intellij.platform.feedback.impl.statistics.FeedbackSurveyIdValidationRule"/>
    <statistics.applicationUsagesCollector implementation="com.intellij.platform.feedback.impl.statistics.DontShowAgainValueCollector"/>
    <statistics.applicationUsagesCollector implementation="com.intellij.platform.feedback.impl.statistics.FeedbackSurveysStateCollector"/>
    <statistics.counterUsagesCollector
      implementationClass="com.intellij.platform.feedback.impl.statistics.FeedbackSendActionCountCollector"/>
    <statistics.counterUsagesCollector
      implementationClass="com.intellij.platform.feedback.general.evaluation.EvaluationFeedbackCountCollector"/>

    <feedback.idleFeedbackSurvey implementation="com.intellij.platform.feedback.demo.DemoInIdeFeedbackSurvey"/>
    <feedback.idleFeedbackSurvey implementation="com.intellij.platform.feedback.demo.DemoExternalFeedbackSurvey"/>

    <feedback.idleFeedbackSurvey implementation="com.intellij.platform.feedback.csat.CsatFeedbackSurvey"/>
    <backgroundPostStartupActivity implementation="com.intellij.platform.feedback.csat.CsatNewUserTracker"/>

    <feedback.idleFeedbackSurvey implementation="com.intellij.platform.feedback.wsl.WslSatisfactionSurvey"/>
    <backgroundPostStartupActivity implementation="com.intellij.platform.feedback.wsl.WslSatisfactionSurveyProjectActivity"/>
    <applicationService serviceImplementation="com.intellij.platform.feedback.wsl.WslSatisfactionSurveyStore"/>
    <registryKey key="wsl.survey.first.use.date" defaultValue=""
                 description="ISO Formatted date of first WSL usage such as 2026-07-15 (for testing the WSL satisfaction survey)"/>
    <registryKey key="wsl.survey.days.with.wsl" defaultValue="-1"
                 description="Overrides the number of days a WSL project was open (for testing the WSL satisfaction survey); -1 disables the override"/>
    <registryKey key="wsl.survey.ignore.audience.conditions" defaultValue="false"
                 description="Ignores the target IDE version and 'existing users only' checks for the WSL satisfaction survey, so it can be triggered on any build and profile for testing (the WSL-project and usage-duration conditions still apply)"/>

    <feedback.idleFeedbackSurvey implementation="com.intellij.platform.feedback.upgrade.UpgradeFeedbackSurvey"/>
    <registryKey key="upgrade.feedback.survey.enabled" defaultValue="true"
                 description="Enables the survey after an IDE update with the Update button"/>

    <registryKey key="csat.survey.enabled" defaultValue="true" description="Enables periodic CSAT survey"/>
    <registryKey key="csat.survey.today" defaultValue="" description="ISO Formatted today date such as 2011-12-03"/>
    <registryKey key="csat.survey.user.created.date" defaultValue="" description="ISO Formatted date when user created such as 2011-12-03"/>
    <registryKey key="csat.survey.show.probability" defaultValue="" description="Override probability of survey, double value from 0 to 1"/>

    <applicationSettings service="com.intellij.platform.feedback.localization.LocalizationFeedbackService"/>
    <applicationSettings service="com.intellij.platform.feedback.impl.state.DontShowAgainFeedbackService"/>
    <applicationSettings service="com.intellij.platform.feedback.impl.state.CommonFeedbackSurveyService"/>
    <applicationSettings service="com.intellij.platform.feedback.wsl.WslSatisfactionSurveyStore"/>
  </extensions>

  <actions resource-bundle="messages.DemoFeedbackMessagesBundle">
    <group id="FeedbackDialogGroup" internal="true">
      <separator/>
      <action id="ShowDemoFeedbackDialog"
              class="com.intellij.platform.feedback.demo.ShowDemoFeedbackDialogAction" internal="true"/>
      <action id="ShowDemoFeedbackDialogWithEmail"
              class="com.intellij.platform.feedback.demo.ShowDemoFeedbackDialogWithEmailAction" internal="true"/>
      <action id="ShowExternalDemoFeedbackWithStatsAction"
              class="com.intellij.platform.feedback.demo.ShowExternalDemoFeedbackWithStatsAction" internal="true"/>
      <action id="ShowInIdeDemoFeedbackWithStats"
              class="com.intellij.platform.feedback.demo.ShowInIdeDemoFeedbackWithStatsAction" internal="true"/>
      <add-to-group group-id="Internal.UI" anchor="last"/>
    </group>
  </actions>

  <actions resource-bundle="messages.LocalizationFeedbackMessagesBundle">
    <action id="ShowLocalizationFeedbackDialog"
            class="com.intellij.platform.feedback.localization.ShowLocalizationFeedbackDialog"
            internal="true"/>
  </actions>

  <actions resource-bundle="messages.CsatFeedbackMessagesBundle">
    <action id="CsatFeedbackAction" class="com.intellij.platform.feedback.csat.CsatFeedbackAction" internal="true"/>
    <action id="CsatFeedbackNextDayAction" class="com.intellij.platform.feedback.csat.CsatFeedbackNextDayAction" internal="true"/>
  </actions>

  <actions resource-bundle="messages.WslSatisfactionFeedbackBundle">
    <action id="ShowWslSatisfactionDialog"
            class="com.intellij.platform.feedback.wsl.ShowWslSatisfactionDialogAction"
            internal="true"/>
  </actions>

  <actions resource-bundle="messages.UpgradeFeedbackMessagesBundle">
    <action id="ShowUpgradeFeedbackNotification"
            class="com.intellij.platform.feedback.upgrade.ShowUpgradeFeedbackNotificationAction"
            internal="true"/>
  </actions>
</idea-plugin>