<idea-plugin visibility="public">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.platform.backend"/>
    <module name="fleet.rpc.server"/>
    <module name="intellij.libraries.jetbrains.annotations"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.rpc"/>
    <module name="intellij.platform.rpc.lite"/>
  </dependencies>
  <!-- endregion -->

  <extensionPoints>
    <extensionPoint qualifiedName="com.intellij.platform.rpc.backend.remoteApiProvider"
                    interface="com.intellij.platform.rpc.backend.RemoteApiProvider"
                    dynamic="true"/>
    <extensionPoint qualifiedName="com.intellij.platform.rpc.backend.remoteApi"
                    beanClass="com.intellij.platform.rpc.backend.RemoteApiRegistration"
                    dynamic="true">
      <with attribute="implementationClass" implements="fleet.rpc.RemoteApi"/>
    </extensionPoint>
    <extensionPoint qualifiedName="com.intellij.platform.rpc.backend.documentSync"
                    interface="com.intellij.platform.rpc.backend.impl.DocumentSync"
                    dynamic="true"/>
  </extensionPoints>

  <extensions defaultExtensionNs="com.intellij">
    <applicationService serviceInterface="com.intellij.platform.rpc.RemoteApiProviderService"
                        serviceImplementation="com.intellij.platform.rpc.backend.impl.RemoteApiRegistry"/>
    <applicationService serviceInterface="com.intellij.platform.rpc.lite.LiteRemoteApiProviderService"
                        serviceImplementation="com.intellij.platform.rpc.backend.impl.LiteRemoteApiRegistry"/>
  </extensions>
</idea-plugin>
