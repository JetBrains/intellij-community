<idea-plugin visibility="internal">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.libraries.jetbrains.annotations"/>
    <module name="intellij.libraries.proxy.vole"/>
    <module name="intellij.libraries.pty4j"/>
    <module name="intellij.libraries.rhino"/>
    <module name="intellij.libraries.winp"/>
    <module name="intellij.platform.util.ex"/>
  </dependencies>
  <!-- endregion -->
  <extensions defaultExtensionNs="com.intellij">
    <applicationService serviceInterface="com.intellij.execution.process.LocalProcessService"
                        serviceImplementation="com.intellij.execution.process.LocalProcessServiceImpl"/>
    <applicationService serviceInterface="com.intellij.util.io.IoService"
                        serviceImplementation="com.intellij.util.io.IoServiceImpl"/>
  </extensions>
</idea-plugin>
