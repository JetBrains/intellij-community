    <registryKey defaultValue="false" description="Show unhandled exceptions that were thrown during interactive operation"
                 key="ide.exceptions.show.interactive"/>
    <registryKey key="ide.settings.external.change.conflict.show.notification" defaultValue="false" restartRequired="false"
                 description="Show a warning notification for external change conflicts in non-modal settings dialog"/>
    <registryKey key="psi.assert.wl.for.exposed.light.files" defaultValue="true" restartRequired="false"
                 description="Require the write lock to modify a non-physical (light) PSI file once it has been opened in a real editor (IJPL-249128). Disable to suppress the threading assertion for exposed light files."/>
    <registryKey defaultValue="true" description="Refresh VFS periodically while there is no user activity in the IDE instead of when window is not focused.
The refresh itself is toggled by (Preferences | Appearance &amp; Behavior | System Settings -> Periodically when IDE is inactive (experimental)"
                 restartRequired="true"
                 key="vfs.background.refresh.on.idle"/>
    <registryKey key="wsl.list.prefer.verbose.output" os="windows" defaultValue="true" restartRequired="false"
                 description="Use 'wsl.exe -l -v' to get distribution list. If it's disabled 'wsl.exe -l -q' will be used."/>
    <registryKey key="wsl.use.utf8.encoding" os="windows" defaultValue="true" restartRequired="false"
                 description="Use UTF-8 as default encoding for all WSL distributions, otherwise default console encoding will be used (see Preferences | Editor | General | Console )"/>
    <registryKey key="wsl.fix.initial.tty.size.when.running.without.tty"
                 restartRequired="false"
                 description="Set initial Linux tty size to 100x100 for WSL processes not attached to Windows PTY (workaround for https://github.com/microsoft/WSL/issues/10701)"
                 defaultValue="true"/>
    <registryKey key="wsl.obtain.windows.host.ip.alternatively" os="windows" defaultValue="true" restartRequired="true"
                 description="Obtain Windows host machine IP alternatively (not using the recommended 'cat /etc/resolv.conf | grep nameserver')."/>
    <registryKey key="wsl.proxy.connect.localhost" os="windows" defaultValue="true" restartRequired="false"
                 description="Connect to 127.0.0.1 on WSLProxy instead of public WSL IP which might be inaccessible due to routing issues"/>
    <registryKey key="ide.plugins.category.promotion.enabled"
                 defaultValue="true"
                 restartRequired="true"
                 description="Enable plugin category promotion panels with priority sorting in the Installed plugins tab"/>
    <registryKey key="dynamic.plugins.support.await.classloader.unload.strategy"
                 defaultValue="[beforeLoad|asyncPostReconfiguration*]"
                 restartRequired="true"
                 description="Changes the way IDE waits for plugins to unload during dynamic plugin reconfiguration"/>
    <applicationService serviceInterface="com.intellij.ide.script.IdeScriptEngineManager" open="true"
                        serviceImplementation="com.intellij.ide.script.IdeScriptEngineManagerImpl"/>
    <registryKey defaultValue="false" key="scanning.should.pause.dumb.queue" restartRequired="true"
                 description="Pause dumb queue (including indexing) while scanning is in progress."/>
    <registryKey defaultValue="true" key="vfs.refresh.should.pause.dumb.queue" restartRequired="true"
                 description="Pause dumb queue (including indexing) while bulk VFS update is in progress."/>
    <registryKey defaultValue="false" key="vfs.windows.use.buffered.directory.stream"
                 description="Use the native buffered WindowsBufferedDirectoryStream for directory enumeration on Windows. When disabled, falls back to the standard java.nio directory stream."/>
    <registryKey defaultValue="true" key="scanning.waits.for.non.dumb.mode" restartRequired="false"
                 description="Scanning will wait until the end of current dumb mode (if any)"/>
    <registryKey defaultValue="true" key="scanning.hide.progress.in.smart.mode" restartRequired="false"
                 description="Hide scanning progress indicator while scanning can continue in smart mode."/>
