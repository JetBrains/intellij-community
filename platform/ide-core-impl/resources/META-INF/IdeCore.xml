                 description="Shows the number of cached children in VFS"/>
    <registryKey key="project.view.show.file.indexability" defaultValue="false"
                 description="Shows if a file is indexable"/>
    <registryKey key="ide.speed.search.tree.auto.select" defaultValue="true"
                 description="When enabled, typing in tree speed search automatically selects the first match. When disabled, only highlights matches and navigation requires arrow keys."/>
    <registryKey key="run.anything.context.recent.directory.number" defaultValue="5"
                 description="Defines storing Run Anything context combobox directories number."/>
    <registryKey key="ide.enable.notification.trace.data.sharing" defaultValue="true" description="Enables notification about sharing trace data"/>
    <notificationGroup id="scrolling-capabilities-debug" displayType="NONE" hideFromSettings="true"/>
