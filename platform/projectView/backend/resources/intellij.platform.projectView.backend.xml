<idea-plugin>
  <dependencies>
    <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
    <module name="fleet.rpc"/>
    <module name="intellij.libraries.kotlinx.coroutines.core"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.ide"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.lang"/>
    <module name="intellij.platform.lang.core"/>
    <module name="intellij.platform.lang.impl"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.projectView"/>
    <module name="intellij.platform.rpc.backend"/>
    <module name="intellij.platform.util.coroutines"/>
    <module name="intellij.platform.util.ui"/>
    <!-- endregion -->
  </dependencies>
  <extensionPoints>
    <extensionPoint 
      qualifiedName="com.intellij.project.view.pane.backend" 
      interface="com.intellij.platform.projectView.pane.ProjectViewPaneProvider"
      dynamic="true"
    />
  </extensionPoints>
  <extensions defaultExtensionNs="com.intellij">
    <platform.rpc.backend.remoteApiProvider implementation="com.intellij.platform.projectView.backend.rpc.ProjectViewRpcProvider"/>
    <project.view.pane.backend implementation="com.intellij.platform.projectView.backend.impl.project.ProjectPaneProvider"/>
    <project.view.pane.backend implementation="com.intellij.platform.projectView.backend.impl.legacy.LegacyBackendProjectViewPaneProvider"/>
    <uiDataRule implementation="com.intellij.platform.projectView.backend.pane.BackendProjectViewPaneUiDataRule"/>
  </extensions>
</idea-plugin>
