<idea-plugin>
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="fleet.rpc"/>
    <module name="intellij.libraries.fastutil"/>
    <module name="intellij.libraries.kotlinx.coroutines.core"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.frontend"/>
    <module name="intellij.platform.ide"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.lang"/>
    <module name="intellij.platform.lang.impl"/>
    <module name="intellij.platform.project"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.projectView"/>
    <module name="intellij.platform.util.ui"/>
  </dependencies>
  <!-- endregion -->
  <extensionPoints>
    <extensionPoint qualifiedName="com.intellij.project.view.pane.model.frontend" interface="com.intellij.platform.projectView.pane.ProjectViewPaneProvider" dynamic="true"/>
  </extensionPoints>
  <extensions defaultExtensionNs="com.intellij">
    <project.view.pane.model.frontend implementation="com.intellij.platform.projectView.frontend.impl.project.LightProjectPaneProvider"/>
    <projectService
      serviceInterface="com.intellij.platform.projectView.window.ProjectViewToolWindowService"
      serviceImplementation="com.intellij.platform.projectView.frontend.window.ProjectViewToolWindowServiceImpl"
    />
    <projectService
      serviceInterface="com.intellij.platform.projectView.pane.FrontendProjectViewPaneAggregator"
      serviceImplementation="com.intellij.platform.projectView.frontend.pane.FrontendProjectViewPaneAggregatorImpl"
    />
    <projectViewSelectInTargetProvider implementation="com.intellij.platform.projectView.frontend.actions.SplitProjectViewSelectInTargetProvider"/>
  </extensions>
</idea-plugin>
