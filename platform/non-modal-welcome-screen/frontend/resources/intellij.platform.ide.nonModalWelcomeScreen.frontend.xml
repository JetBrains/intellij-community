<idea-plugin visibility="internal">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.platform.frontend"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.compose"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.ide.nonModalWelcomeScreen"/>
    <module name="intellij.platform.lang.impl"/>
    <module name="intellij.platform.project"/>
    <module name="intellij.platform.projectView"/>
    <module name="intellij.platform.projectView.frontend"/>
    <module name="intellij.platform.util.ui"/>
  </dependencies>
  <!-- endregion -->

  <projectListeners>
    <listener class="com.intellij.platform.ide.nonModalWelcomeScreen.frontend.WelcomeScreenLeftTabListener"
              topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
  </projectListeners>
  <extensions defaultExtensionNs="com.intellij">
    <project.view.pane.pure.ui
      implementation="com.intellij.platform.ide.nonModalWelcomeScreen.frontend.leftPanel.FrontendWelcomeScreenLeftPanelProvider"
    />
  </extensions>
</idea-plugin>
