    env = {
        "JB_TEST_JUNIT5_FILTERS": "include-package=com.intellij.testFramework.extensions.ignore",
    },
    tags = ["ultimate-smoke"],
    runtime_deps = [":testFramework-tests_test_lib"],
)

jps_test(
    name = "testFramework-tests_test",
    timeout = "moderate",
    ####
    ## testFramework-tests_test runs tests from testFramework-tests_test_lib.jar,
    ## but its runtime classpath also contains testFramework.jar.
    ## That production framework jar contains classes in the default package:
    ## _FirstInSuiteTest.class, _LastInSuiteTest.class
    ## to prevent them from being executed as actual tests, we use filtering by testFramework-tests_test_lib.jar
    ####
    env = {"JB_TEST_JAR": "testFramework-tests_test_lib.jar"},
    tags = ["community-aggregator"],
    runtime_deps = [":testFramework-tests_test_lib"],
)

